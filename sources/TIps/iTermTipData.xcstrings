{
  "sourceLanguage": "en",
  "strings": {
    "ui.tips.data.000.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"This window shows the iTerm2 tip of the day. It’ll appear every 24 hours to let you know about new features and hidden secrets. Hit “More Options” to view more tips or to stop getting them altogether."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此窗口显示 iTerm2 的每日提示。它每 24 小时出现一次，向你介绍新功能和隐藏技巧。点击“更多选项”可查看更多提示，或完全停止接收这些提示。"}}}},
    "ui.tips.data.000.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Tip of the Day"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"每日提示"}}}},
    "ui.tips.data.0000.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"The big new feature of iTerm2 version 3 is Shell Integration. Click “Learn More” for all the details."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"iTerm2 版本 3 的一项重大新功能是 Shell 集成。点击“了解更多”查看所有详细信息。"}}}},
    "ui.tips.data.0000.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Shell Integration"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Shell 集成"}}}},
    "ui.tips.data.0001.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"“View > Show Timestamps” shows the time (and date, if appropriate) when each line was last modified."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"“显示 > 显示时间戳”会显示每行上次修改的时间（适当时还会显示日期）。"}}}},
    "ui.tips.data.0001.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Timestamps"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"时间戳"}}}},
    "ui.tips.data.0002.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Did you know iTerm2 has a password manager? Open it with “Window > Password Manager.” You can define a Trigger to open it for you at a password prompt in “Settings > Profiles > Advanced > Triggers.”"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"你知道 iTerm2 也有密码管理器吗？通过“窗口 > 密码管理器”打开它。你可以在“设置 > 配置文件 > 高级 > 触发器”中定义一个触发器，让密码提示出现时自动打开密码管理器。"}}}},
    "ui.tips.data.0002.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Password Manager"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"密码管理器"}}}},
    "ui.tips.data.0003.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"You can quickly search through your sessions with “View > Open Quickly” (⇧⌘O). You can type a query and sessions whose name, badge, current hostname, current user name, recent commands, and recent working directories match will be surfaced. It works best with Shell Integration so the user name, hostname, command, and directories can be known even while sshed."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"你可以使用“显示 > 快速打开” (⇧⌘O) 快速搜索会话。输入查询后，名称、徽标、当前主机名、当前用户名、最近命令或最近工作目录相匹配的会话就会显示出来。配合 Shell 集成效果最佳，这样即使通过 SSH 连接，也能获知用户名、主机名、命令和目录。"}}}},
    "ui.tips.data.0003.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Open Quickly"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"快速打开"}}}},
    "ui.tips.data.0004.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"If you close a session, tab, or window by accident you can undo it with “Edit > Undo” (⌘Z). By default you have five seconds to undo, but you can adjust that timeout in “Settings > Profiles > Session.”"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"如果误关会话、标签页或窗口，可使用“编辑 > 撤销” (⌘Z) 恢复。默认有五秒可撤销，你可以在“设置 > 配置文件 > 会话”中调整超时时间。"}}}},
    "ui.tips.data.0004.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Undo Close"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"撤销关闭"}}}},
    "ui.tips.data.0005.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Want to mark up your scrollback history? Right click on a selection and choose “Annotate Selection” to add a personal note to it. Use “View > Show Annotations” to show or hide them, and look in “Edit > Marks and Annotations” for more things you can do."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"想为回滚历史添加标记吗？右键点按所选内容并选择“注释所选内容”，即可添加个人注释。使用“显示 > 显示注释”显示或隐藏注释；在“编辑 > 标记与注释”中还能找到更多操作。"}}}},
    "ui.tips.data.0005.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Annotations"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"注释"}}}},
    "ui.tips.data.0006.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Copy a selection with ⌥⌘C to include styles such as colors and fonts. You can make this the default action for Copy in “Settings > Advanced.”"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"按 ⌥⌘C 拷贝所选内容，同时保留颜色、字体等样式。你可以在“设置 > 高级”中将其设为“拷贝”的默认操作。"}}}},
    "ui.tips.data.0006.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Copy with Styles"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"拷贝（含样式）"}}}},
    "ui.tips.data.0007.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"iTerm2 can display images (even animated GIFs) inline."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"iTerm2 可以在终端中直接显示图像（包括动态 GIF）。"}}}},
    "ui.tips.data.0007.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Inline Images"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"内嵌图像"}}}},
    "ui.tips.data.0008.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Automatic Profile Switching changes the current profile when the username, hostname, or directory changes. Set it up in “Settings > Profiles > Advanced.” It requires Shell Integration to be installed."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"当用户名、主机名或目录发生变化时，“自动切换配置文件”会更改当前配置文件。可在“设置 > 配置文件 > 高级”中设置。使用此功能需要安装 Shell 集成。"}}}},
    "ui.tips.data.0008.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Automatic Profile Switching"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"自动切换配置文件"}}}},
    "ui.tips.data.0009.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"iTerm2 can act like an IDE using the Captured Output feature. When it sees text matching a regular expression you define, like compiler errors, it shows the matching lines in the Toolbelt. You can click to jump to the line in your terminal and double-click to perform an action like opening an editor to the line with the error."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"借助“捕获输出”功能，iTerm2 可以像 IDE 一样工作。当它发现与你定义的正则表达式相匹配的文本（如编译器错误）时，会在工具侧栏显示相应行。单击可跳至终端中的该行，双击可执行某项操作，例如在编辑器中打开错误所在行。"}}}},
    "ui.tips.data.0009.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Captured Output"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"捕获输出"}}}},
    "ui.tips.data.0010.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"You can display a status message in the top right of your session in the background. It’s called a “Badge.” If you install Shell Integration you can include info like user name, hostname, current directory, and more."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"你可以在会话右上角以背景形式显示状态信息，这称为“徽标”。安装 Shell 集成后，可包含用户名、主机名、当前目录等信息。"}}}},
    "ui.tips.data.0010.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Badges"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"徽标"}}}},
    "ui.tips.data.0011.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Dynamic Profiles let you store your profiles as one or more JSON files. It’s great for batch creating and editing profiles."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"动态配置文件可让你将配置文件存储为一个或多个 JSON 文件，非常适合批量创建和编辑配置文件。"}}}},
    "ui.tips.data.0011.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Dynamic Profiles"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"动态配置文件"}}}},
    "ui.tips.data.0012.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"“Edit > Paste Special > Advanced Paste” lets you preview and edit text before you paste. You get to tweak options, like how to handle control codes, or even to base-64 encode before pasting."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"“编辑 > 粘贴特殊 > 高级粘贴”可让你在粘贴前预览和编辑文本。你可以调整控制代码处理方式等选项，甚至可在粘贴前进行 Base64 编码。"}}}},
    "ui.tips.data.0012.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Advanced Paste"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"高级粘贴"}}}},
    "ui.tips.data.0013.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Ever wanted to focus on a block of lines without distraction, or limit Find to a single command’s output? Select the lines and choose “View > Zoom In on Selection.” The session’s contents will be temporarily replaced with the selection. Press “esc” to unzoom."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"是否想专注查看一段内容而不受干扰，或将“查找”范围限制在单条命令的输出中？选择这些行，再选取“显示 > 缩放到所选内容”。会话内容将暂时替换为所选内容。按 Esc 可退出缩放。"}}}},
    "ui.tips.data.0013.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Zoom"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"缩放"}}}},
    "ui.tips.data.0014.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"The “Semantic History” feature allows you to ⌘-click on a file or URL to open it."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"“语义历史”功能让你可以按住 ⌘ 并点按文件或 URL 来打开它。"}}}},
    "ui.tips.data.0014.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Semantic History"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"语义历史"}}}},
    "ui.tips.data.0015.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"If you use tmux, try running “tmux -CC” to get iTerm2’s tmux integration mode. The tmux windows show up as native iTerm2 windows, and you can use iTerm2’s keyboard shortcuts. It even works over ssh!"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"如果使用 tmux，请尝试运行“tmux -CC”以进入 iTerm2 的 tmux 集成模式。tmux 窗口会显示为原生 iTerm2 窗口，你也可以使用 iTerm2 的键盘快捷键。通过 SSH 连接时同样有效！"}}}},
    "ui.tips.data.0015.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Tmux Integration"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"tmux 集成"}}}},
    "ui.tips.data.0016.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"iTerm2 can automatically perform actions you define when text matching a regular expression is received. For example, you can highlight text or show an alert box. Set it up in “Settings > Profiles > Advanced > Triggers.”"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"收到与所定义正则表达式匹配的文本时，iTerm2 可自动执行你指定的操作。例如，高亮文本或显示提醒框。可在“设置 > 配置文件 > 高级 > 触发器”中设置。"}}}},
    "ui.tips.data.0016.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Triggers"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"触发器"}}}},
    "ui.tips.data.0017.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Quadruple click to perform Smart Selection. It figures out if you’re selecting a URL, filename, email address, etc. based on prioritized regular expressions."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"连按四次可执行智能选择。它会根据按优先级排列的正则表达式，判断你选择的是 URL、文件名、电子邮件地址等内容。"}}}},
    "ui.tips.data.0017.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Smart Selection"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"智能选择"}}}},
    "ui.tips.data.0018.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Press ⌥⌘B to step back in time in a terminal window. Use arrow keys to go frame by frame. Hold ⇧ and press arrow keys to go faster."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"在终端窗口中按 ⌥⌘B 可回到之前的画面。使用箭头键逐帧查看；按住 ⇧ 再按箭头键可加快速度。"}}}},
    "ui.tips.data.0018.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Instant Replay"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"即时回放"}}}},
    "ui.tips.data.0019.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"You can have a terminal window open with a keystroke, even while in other apps. Click “Create a Dedicated Hotkey Window” in “Settings > Keys.”"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"即使正在使用其他 App，也可以按一个快捷键打开终端窗口。在“设置 > 按键”中点击“创建专用热键窗口”。"}}}},
    "ui.tips.data.0019.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Hotkey Window"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"热键窗口"}}}},
    "ui.tips.data.0020.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Hotkey windows can stay open after losing focus. Turn it on in “Window > Pin Hotkey Window.”"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"热键窗口失去焦点后仍可保持打开。可在“窗口 > 固定热键窗口”中启用。"}}}},
    "ui.tips.data.0020.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Hotkey Window"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"热键窗口"}}}},
    "ui.tips.data.0021.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"The cursor guide is a horizontal line that follows your cursor. You can turn it on in “Settings > Profiles > Colors” or toggle it with the ⌥⌘; shortcut."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"光标辅助线是一条跟随光标的水平线。可在“设置 > 配置文件 > 颜色”中启用，或按 ⌥⌘; 切换。"}}}},
    "ui.tips.data.0021.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Cursor Guide"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"光标辅助线"}}}},
    "ui.tips.data.0022.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"The Shell Integration feature lets you ask to be alerted (⌥⌘A) when a long-running command completes."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Shell 集成功能可在长时间运行的命令完成时通知你（⌥⌘A）。"}}}},
    "ui.tips.data.0022.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Shell Integration: Alerts"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Shell 集成：提醒"}}}},
    "ui.tips.data.0023.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"You can configure how quickly the cursor blinks in “Settings > Advanced.”"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"可在“设置 > 高级”中配置光标的闪烁速度。"}}}},
    "ui.tips.data.0023.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Cursor Blink Rate"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"光标闪烁速率"}}}},
    "ui.tips.data.0024.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"The Shell Integration feature lets you navigate among shell prompts with ⇧⌘↑ and ⇧⌘↓."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Shell 集成功能让你可以使用 ⇧⌘↑ 和 ⇧⌘↓ 在 Shell 提示符之间导航。"}}}},
    "ui.tips.data.0024.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Shell Integration: Navigation"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Shell 集成：导航"}}}},
    "ui.tips.data.0025.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"The Shell Integration feature puts a blue arrow next to your shell prompt. If you run a command that fails, it turns red. Right click on it to get the running time and status."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Shell 集成功能会在 Shell 提示符旁显示蓝色箭头。命令执行失败时，箭头会变为红色。右键点按箭头可查看运行时间和状态。"}}}},
    "ui.tips.data.0025.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Shell Integration: Status"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Shell 集成：状态"}}}},
    "ui.tips.data.0026.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"With Shell Integration installed, you can select the output of the last command with ⇧⌘A."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"安装 Shell 集成后，可按 ⇧⌘A 选择上一条命令的输出。"}}}},
    "ui.tips.data.0026.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Shell Integration: Selection"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Shell 集成：选择"}}}},
    "ui.tips.data.0027.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"The dock icon shows a count of the number of bells rung and notifications posted since the app was last active."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"程序坞图标会显示自 App 上次处于活跃状态以来的响铃次数和已发送通知数。"}}}},
    "ui.tips.data.0027.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Bells"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"响铃"}}}},
    "ui.tips.data.0028.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"If you install Shell Integration on a machine you ssh to, you can right click on a filename (for example, in the output of “ls”) and choose “Download with scp” to download the file."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"如果在通过 SSH 连接的机器上安装了 Shell 集成，可以右键点按文件名（例如“ls”的输出中），然后选择“使用 scp 下载”来下载文件。"}}}},
    "ui.tips.data.0028.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Shell Integration: Downloads"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Shell 集成：下载"}}}},
    "ui.tips.data.0029.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Press ⌘/ to locate your cursor. It’s fun!"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"按 ⌘/ 定位光标。很有趣！"}}}},
    "ui.tips.data.0029.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Find Your Cursor"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"查找光标"}}}},
    "ui.tips.data.0030.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"You can edit Smart Selection regular expressions in “Settings > Profiles > Advanced > Smart Selection.”"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"可在“设置 > 配置文件 > 高级 > 智能选择”中编辑智能选择的正则表达式。"}}}},
    "ui.tips.data.0030.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Customize Smart Selection"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"自定义智能选择"}}}},
    "ui.tips.data.0031.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Assign an action to a Smart Selection rule in “Settings > Profiles > Advanced > Smart Selection > Edit Actions.” They go in the context menu and override semantic history on ⌘-click."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"在“设置 > 配置文件 > 高级 > 智能选择 > 编辑动作”中为智能选择规则指定动作。这些动作会出现在上下文菜单中，并在按住 ⌘ 点按时覆盖语义历史行为。"}}}},
    "ui.tips.data.0031.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Smart Selection Actions"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"智能选择动作"}}}},
    "ui.tips.data.0032.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"If you want the visual bell to flash the whole screen instead of show a bell icon, you can turn that on in “Settings > Advanced.”"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"如果希望可视响铃闪烁整个屏幕，而不是显示响铃图标，可在“设置 > 高级”中启用。"}}}},
    "ui.tips.data.0032.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Visual Bell"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"可视响铃"}}}},
    "ui.tips.data.0033.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Right click on a tab to change its color, close tabs after it, or to close all other tabs."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"右键点按标签页可更改其颜色、关闭其后的标签页，或关闭其他所有标签页。"}}}},
    "ui.tips.data.0033.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Tab Menu"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"标签页菜单"}}}},
    "ui.tips.data.0034.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"You can assign tags to your profiles, and by clicking “Tags>” anywhere you see a list of profiles you can browse those tags."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"你可以为配置文件指定标签。在任何配置文件列表中点击“标签>”，即可按标签浏览。"}}}},
    "ui.tips.data.0034.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Tags"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"标签"}}}},
    "ui.tips.data.0035.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"If you put a slash in a profile’s tag, that implicitly defines a hierarchy. You can see it in the Profiles menu as nested submenus."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"在配置文件标签中加入斜杠即可隐式定义层级；它会在“配置文件”菜单中显示为嵌套子菜单。"}}}},
    "ui.tips.data.0035.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Tag Hierarchy"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"标签层级"}}}},
    "ui.tips.data.0036.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"iTerm2 can download files by base-64 encoding them. Click “Learn More” to download a shell script that makes it easy."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"iTerm2 可以通过 Base64 编码下载文件。点击“了解更多”可下载一个简化操作的 Shell 脚本。"}}}},
    "ui.tips.data.0036.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Downloads"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"下载"}}}},
    "ui.tips.data.0037.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"If you install Shell Integration, ⇧⌘; helps you complete commands. It remembers the commands you’ve run on each host that has Shell Integration installed. It knows how often that command was run and how recently to help make the best suggestions."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"安装 Shell 集成后，可按 ⇧⌘; 补全命令。系统会记住每台已安装 Shell 集成的主机上运行过的命令，并根据命令的运行频率和最近使用时间提供最佳建议。"}}}},
    "ui.tips.data.0037.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Command Completion"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"命令补全"}}}},
    "ui.tips.data.0038.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"iTerm2 remembers which directories you use the most on each host that has Shell Integration installed. There’s a Toolbelt tool to browse them, and ⌥⌘/ gives you a popup sorted by frequency and recency of use."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"iTerm2 会记住每台已安装 Shell 集成的主机上最常使用的目录。工具侧栏中有用于浏览这些目录的工具；按 ⌥⌘/ 可打开弹出窗口，并按使用频率和最近使用时间排序。"}}}},
    "ui.tips.data.0038.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Recent Directories"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"最近使用的目录"}}}},
    "ui.tips.data.0039.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"If you have Shell Integration installed, you can “star” a directory to keep it always at the bottom of the Recent Directories tool in the Toolbelt. Right click and choose “Toggle Star.”"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"安装 Shell 集成后，可以为目录添加“星标”，使其始终显示在工具侧栏“最近使用的目录”工具底部。右键点按并选择“切换星标”。"}}}},
    "ui.tips.data.0039.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Favorite Directories"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"收藏的目录"}}}},
    "ui.tips.data.0040.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Install Shell Integration and turn on “Settings > General > Save copy/paste and command history to disk” to remember command history per host across restarts of iTerm2."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"安装 Shell 集成并启用“设置 > 通用 > 将复制/粘贴和命令历史记录保存到磁盘”，即可在 iTerm2 重启后继续保留各主机的命令历史记录。"}}}},
    "ui.tips.data.0040.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Shell Integration History"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Shell 集成历史记录"}}}},
    "ui.tips.data.0041.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Copy a file to the pasteboard in Finder and then use “Edit > Paste Special > Paste File Base64-Encoded” for easy uploads of binary files. Use ”base64 -D” (or -d on Linux) on the remote host to decode it."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"在 Finder 中将文件拷贝到剪贴板，然后使用“编辑 > 粘贴特殊 > 以 Base64 编码粘贴文件”，即可轻松上传二进制文件。在远程主机上使用“base64 -D”（Linux 上使用 -d）进行解码。"}}}},
    "ui.tips.data.0041.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Paste File as Base64"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"以 Base64 粘贴文件"}}}},
    "ui.tips.data.0042.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"You can split a tab into multiple panes with ⌘D and ⇧⌘D."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"可以使用 ⌘D 和 ⇧⌘D 将一个标签页分成多个窗格。"}}}},
    "ui.tips.data.0042.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Split Panes"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"分割窗格"}}}},
    "ui.tips.data.0043.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Resize split panes with the keyboard using ^⌘-Arrow Key."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"使用 ^⌘-箭头键通过键盘调整分割窗格大小。"}}}},
    "ui.tips.data.0043.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Adjust Split Panes"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"调整分割窗格"}}}},
    "ui.tips.data.0044.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Hold ⌥ and click to move your cursor. It works best with Shell Integration installed (to avoid sending up/down arrow keys to your shell)."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"按住 ⌥ 并点按可移动光标。安装 Shell 集成后效果最佳（可避免向 Shell 发送上下箭头键）。"}}}},
    "ui.tips.data.0044.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Move Cursor"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"移动光标"}}}},
    "ui.tips.data.0045.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"You can tell your profile to create windows that are attached to one edge of the screen in “Settings > Profiles > Window.” You can resize them by dragging the edges."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"可在“设置 > 配置文件 > 窗口”中，让配置文件创建贴靠屏幕某一边缘的窗口。拖动边缘即可调整窗口大小。"}}}},
    "ui.tips.data.0045.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Edge Windows"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"屏幕边缘窗口"}}}},
    "ui.tips.data.0046.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"You can assign colors to tabs in “Settings > Profiles > Colors,” or in the View menu."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"可在“设置 > 配置文件 > 颜色”或“显示”菜单中为标签页指定颜色。"}}}},
    "ui.tips.data.0046.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Tab Color"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"标签页颜色"}}}},
    "ui.tips.data.0047.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Hold ⌥⌘ while dragging to make a rectangular selection."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"按住 ⌥⌘ 并拖动可进行矩形选择。"}}}},
    "ui.tips.data.0047.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Rectangular Selection"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"矩形选择"}}}},
    "ui.tips.data.0048.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Hold ⌘ while dragging to make multiple discontinuous selections."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"按住 ⌘ 并拖动可进行多个不连续的选择。"}}}},
    "ui.tips.data.0048.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Multiple Selection"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"多重选择"}}}},
    "ui.tips.data.0049.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Hold ⇧⌥⌘ and drag a session into another session to create or change split panes."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"按住 ⇧⌥⌘，将一个会话拖入另一个会话，即可创建或更改分割窗格。"}}}},
    "ui.tips.data.0049.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Dragging Panes"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"拖动窗格"}}}},
    "ui.tips.data.0050.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Adjust Cursor Boost in “Settings > Profiles > Colors” to make all colors more muted, except the cursor. Use a bright white cursor and it pops!"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"在“设置 > 配置文件 > 颜色”中调整“光标增强”，可以减弱光标以外的所有颜色。使用亮白色光标会格外醒目！"}}}},
    "ui.tips.data.0050.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Cursor Boost"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"光标增强"}}}},
    "ui.tips.data.0051.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Adjust “Minimum Contrast” in “Settings > Profiles > Colors” to ensure text is always legible regardless of text/background color combination."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"在“设置 > 配置文件 > 颜色”中调整“最低对比度”，确保无论文字与背景如何配色，文字始终清晰可读。"}}}},
    "ui.tips.data.0051.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Minimum Contrast"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"最低对比度"}}}},
    "ui.tips.data.0052.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Normally, new tabs appear at the end of the tab bar. There’s a setting in “Settings > Advanced” to place them next to your current tab."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"通常，新标签页会出现在标签栏末尾。“设置 > 高级”中有一项设置，可让新标签页出现在当前标签页旁边。"}}}},
    "ui.tips.data.0052.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Tabs"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"标签页"}}}},
    "ui.tips.data.0053.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Right-click on a number and the context menu shows it converted to hex or decimal as appropriate."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"右键点按数字，上下文菜单会根据情况显示其十六进制或十进制转换结果。"}}}},
    "ui.tips.data.0053.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Base Conversion"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"进制转换"}}}},
    "ui.tips.data.0054.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"In “Settings > Keys” you can assign a keystroke to a search for a regular expression with the “Find Regular Expression…” action."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"在“设置 > 按键”中，可以为使用“查找正则表达式…”动作的正则表达式搜索指定快捷键。"}}}},
    "ui.tips.data.0054.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Saved Searches"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已保存的搜索"}}}},
    "ui.tips.data.0055.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Search for URLs using “Edit > Find > Find URLs.” Navigate search results with ⌘G and ⇧⌘G. Open the current selection with ⌥⌘O."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"使用“编辑 > 查找 > 查找 URL”搜索 URL。按 ⌘G 和 ⇧⌘G 浏览搜索结果，按 ⌥⌘O 打开当前所选内容。"}}}},
    "ui.tips.data.0055.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Find URLs"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"查找 URL"}}}},
    "ui.tips.data.0056.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"The “instant” checkbox in a Trigger allows it to fire while the cursor is on the same line as the text that matches your regular expression."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"触发器中的“即时”复选框允许它在光标仍位于与正则表达式匹配文本的同一行时触发。"}}}},
    "ui.tips.data.0056.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Triggers"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"触发器"}}}},
    "ui.tips.data.0057.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Turn on “Edit > Selection Respects Soft Boundaries” to recognize split pane dividers in programs like vi, emacs, and tmux so you can select multiple lines of text."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"启用“编辑 > 所选内容遵循软边界”，即可识别 vi、emacs 和 tmux 等程序中的分割窗格分隔线，从而选择多行文本。"}}}},
    "ui.tips.data.0057.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Soft Boundaries"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"软边界"}}}},
    "ui.tips.data.0058.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Single click where you want to start a selection and ⇧-click where you want it to end to select text without dragging."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"在选择起点单击，再按住 ⇧ 点按终点，即可无需拖动地选择文本。"}}}},
    "ui.tips.data.0058.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Select Without Dragging"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无需拖动即可选择"}}}},
    "ui.tips.data.0059.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Hold ^ while resizing a window and it won’t snap to the character grid: you can make it any size you want."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"调整窗口大小时按住 ^，窗口就不会吸附到字符网格，可以设为任意大小。"}}}},
    "ui.tips.data.0059.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Smooth Window Resizing"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"平滑调整窗口大小"}}}},
    "ui.tips.data.0060.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"If you paste text containing tabs, you’ll be asked if you want to convert them to spaces. It’s handy at the shell prompt to avoid triggering filename completion."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"粘贴包含制表符的文本时，系统会询问是否将其转换为空格。在 Shell 提示符下，这有助于避免意外触发文件名补全。"}}}},
    "ui.tips.data.0060.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Pasting Tabs"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"粘贴制表符"}}}},
    "ui.tips.data.0061.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Did you know? If the bell rings too often, you’ll be asked if you’d like to silence it temporarily. iTerm2 cares about your comfort."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"你知道吗？如果响铃过于频繁，系统会询问是否暂时静音。iTerm2 也关心你的使用体验。"}}}},
    "ui.tips.data.0061.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Bell Silencing"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"静音响铃"}}}},
    "ui.tips.data.0062.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Every list of profiles has a search field (e.g., in ”Settings > Profiles.”) You can use various operators to restrict your search query. Click “Learn More” for all the details."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"每个配置文件列表都有搜索栏（例如“设置 > 配置文件”）。你可以使用多种运算符限制搜索查询。点击“了解更多”查看所有详细信息。"}}}},
    "ui.tips.data.0062.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Profile Search"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"配置文件搜索"}}}},
    "ui.tips.data.0063.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"The online color gallery features over one hundred beautiful color schemes you can download."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"在线配色图库提供一百多种精美的配色方案供你下载。"}}}},
    "ui.tips.data.0063.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Color Schemes"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"配色方案"}}}},
    "ui.tips.data.0064.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"You can have a separate font for ASCII versus non-ASCII text. Enable it in “Settings > Profiles > Text.”"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"可以分别为 ASCII 与非 ASCII 文本设置不同字体。在“设置 > 配置文件 > 文本”中启用。"}}}},
    "ui.tips.data.0064.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"ASCII/Non-Ascii Fonts"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"ASCII/非 ASCII 字体"}}}},
    "ui.tips.data.0065.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"A coprocess is a job, such as a shell script, that has a special relationship with a particular iTerm2 session. All output in a terminal window (that is, what you see on the screen) is also input to the coprocess. All output from the coprocess acts like text that the user is typing at the keyboard."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"协进程是一项任务（例如 Shell 脚本），它与特定 iTerm2 会话具有特殊关系。终端窗口中的所有输出（即屏幕上看到的内容）同时也会作为协进程的输入。协进程的所有输出则如同用户通过键盘输入的文本。"}}}},
    "ui.tips.data.0065.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Coprocesses"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"协进程"}}}},
    "ui.tips.data.0066.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"You can customize the touch bar by selecting “View > Customize Touch Bar.” You can add a tab bar for full-screen mode, a user-customizable status button, and you can even define your own touch bar buttons in Settings > Keys. There’s also a new shell integration tool to customize touch bar function key labels."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"选择“显示 > 自定义触控栏”可自定义触控栏。你可以为全屏模式添加标签栏和可由用户自定义的状态按钮，甚至可以在“设置 > 按键”中定义自己的触控栏按钮。此外还有一项新的 Shell 集成工具，可自定义触控栏功能键标签。"}}}},
    "ui.tips.data.0066.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Touch Bar Customization"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"自定义触控栏"}}}},
    "ui.tips.data.0067.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"If you use a font that supports ligatures, you can enable ligature support in Settings > Profiles > Text."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"如果字体支持连字，可在“设置 > 配置文件 > 文本”中启用连字支持。"}}}},
    "ui.tips.data.0067.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Ligatures"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"连字"}}}},
    "ui.tips.data.0068.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"New in 3.1: You can configure your hotkey window to appear over other apps’ full screen windows. Turn on “Floating Window” in “Settings > Profiles > Keys > Customize Hotkey Window.”"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"3.1 新增：可将热键窗口设为显示在其他 App 的全屏窗口之上。在“设置 > 配置文件 > 按键 > 自定义热键窗口”中启用“浮动窗口”。"}}}},
    "ui.tips.data.0068.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Floating Hotkey Window"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"浮动热键窗口"}}}},
    "ui.tips.data.0069.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"New in 3.1: You can have multiple hotkey windows. Each profile can have one or more hotkeys."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"3.1 新增：可以使用多个热键窗口。每个配置文件可有一个或多个热键。"}}}},
    "ui.tips.data.0069.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Multiple Hotkey Windows"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"多个热键窗口"}}}},
    "ui.tips.data.0070.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"New in 3.1: You can configure a hotkey window to open on double-tap of a modifier in “Settings > Profiles > Keys > Customize Hotkey Window.”"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"3.1 新增：可在“设置 > 配置文件 > 按键 > 自定义热键窗口”中，将热键窗口配置为连按两次修饰键时打开。"}}}},
    "ui.tips.data.0070.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Double-Tap Hotkey"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"连按两次修饰键"}}}},
    "ui.tips.data.0071.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"You can “bury” a session with “Session > Bury Session.” It remains hidden until you restore it by selecting it from “Session > Buried Sessions > Your session.”"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"可以使用“会话 > 隐藏会话”将会话“隐藏”。它会一直保持隐藏，直到你从“会话 > 已隐藏的会话 > 你的会话”中选择并恢复它。"}}}},
    "ui.tips.data.0071.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Buried Sessions"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已隐藏的会话"}}}},
    "ui.tips.data.0072.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"You can add custom behavior to iTerm2 using the Python API."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"你可以使用 Python API 为 iTerm2 添加自定义行为。"}}}},
    "ui.tips.data.0072.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Python API"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Python API"}}}},
    "ui.tips.data.0073.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"You can add a configurable status bar to your terminal windows."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"可以为终端窗口添加可配置的状态栏。"}}}},
    "ui.tips.data.0073.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Status Bar"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"状态栏"}}}},
    "ui.tips.data.0074.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Try the “Minimal” and “Compact” themes to reduce visual clutter. You can set it in “Settings > Appearance > General.”"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"试用“精简”和“紧凑”主题以减少视觉干扰。可在“设置 > 外观 > 通用”中设置。"}}}},
    "ui.tips.data.0074.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Minimal Theme"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"精简主题"}}}},
    "ui.tips.data.0076.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"You can configure which elements are present in session titles in “Settings > Profiles > General > Title.”"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"可在“设置 > 配置文件 > 通用 > 标题”中配置会话标题包含哪些元素。"}}}},
    "ui.tips.data.0076.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Session Titles"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"会话标题"}}}},
    "ui.tips.data.0077.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Tabs can show an icon indicating the current application. Configure it in “Settings > Profiles > General > Icon.”"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"标签页可以显示表示当前应用程序的图标。可在“设置 > 配置文件 > 通用 > 图标”中配置。"}}}},
    "ui.tips.data.0077.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Tab Icons"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"标签页图标"}}}},
    "ui.tips.data.0078.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Hold ⌥ while dragging a tab to move the window. This is useful in the Compact and Minimal themes, which have a very small area for dragging the window."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"拖动标签页时按住 ⌥ 可移动窗口。这对“紧凑”和“精简”主题很有用，因为这些主题可用于拖动窗口的区域很小。"}}}},
    "ui.tips.data.0078.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Drag Window by Tab"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"通过标签页拖动窗口"}}}},
    "ui.tips.data.0079.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Press ⇧⌘. to open the Composer. It gives you a scratchpad to edit a command before sending it to the shell."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"按 ⇧⌘. 打开 Composer。它提供一个暂存区，让你在将命令发送到 Shell 前先进行编辑。"}}}},
    "ui.tips.data.0079.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Composer"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Composer"}}}},
    "ui.tips.data.0080.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"If you install Shell Integration on a machine you ssh to, you can drag-drop from Finder into the remote host by holding ⌥ while dragging. The destination directory is determined by where you drop the file in the terminal window: run cd foo, then drop the file below the cd command, and the file will go into the foo directory."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"如果在通过 SSH 连接的机器上安装了 Shell 集成，按住 ⌥ 从 Finder 拖放文件即可上传到远程主机。目标目录取决于文件在终端窗口中的放置位置：运行 cd foo 后，将文件拖放到 cd 命令下方，文件就会进入 foo 目录。"}}}},
    "ui.tips.data.0080.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Shell Integration: Uploads"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Shell 集成：上传"}}}},
    "ui.tips.data.0081.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"The composer supports multiple cursors. It also has the ability to send just one command out of a list, making it easy to walk through a list of commands one-by-one. Click the help button in the composer for details."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Composer 支持多个光标，还能只发送命令列表中的一条命令，便于逐条执行命令。详情请点击 Composer 中的帮助按钮。"}}}},
    "ui.tips.data.0081.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Composer Power Features"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Composer 高级功能"}}}},
    "ui.tips.data.0082.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Transform selected text into a prettified, syntax-highlighted view with the “Render Selection” command, ideal for JSON, Markdown, or source code. This feature includes horizontal scrolling for easy log navigation."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"使用“渲染所选内容”命令，将所选文本转换为美观且带语法高亮的视图，非常适合 JSON、Markdown 或源代码。此功能还支持水平滚动，便于浏览日志。"}}}},
    "ui.tips.data.0082.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Render Selection"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"渲染所选内容"}}}},
    "ui.tips.data.0083.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Export environment variables and copy files to remote hosts seamlessly with SSH integration. Either configure a profile to use ssh or use it2ssh in place of ssh."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"通过 SSH 集成，可无缝导出环境变量并将文件复制到远程主机。你可以将配置文件设为使用 ssh，也可以用 it2ssh 代替 ssh。"}}}},
    "ui.tips.data.0083.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"SSH Integration"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"SSH 集成"}}}},
    "ui.tips.data.0084.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Improve your command line with the “auto composer”, which replaces the command line with a native control for ease of use. Requires shell integration."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"使用“Auto Composer”改进命令行体验：它以原生控件替代命令行，更易于操作。需要 Shell 集成。"}}}},
    "ui.tips.data.0084.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Auto Composer"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Auto Composer"}}}},
    "ui.tips.data.0085.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Generate commands using AI by entering a prompt in the composer and selecting “Edit > Engage Artificial Intelligence”. An OpenAI API key is required for this functionality."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"在 Composer 中输入提示并选择“编辑 > 启用人工智能”，即可使用 AI 生成命令。此功能需要 OpenAI API 密钥。"}}}},
    "ui.tips.data.0085.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"AI Command Writing"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"AI 命令编写"}}}},
    "ui.tips.data.0086.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Set and achieve terminal goals with “Codecierge”, a Toolbelt feature that guides you step-by-step based on your terminal activity. An OpenAI API key is necessary for this feature."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"使用“Codecierge”设定并完成终端目标。它是工具侧栏中的一项功能，会根据你的终端活动逐步提供引导。此功能需要 OpenAI API 密钥。"}}}},
    "ui.tips.data.0086.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Codecierge Tool"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Codecierge 工具"}}}},
    "ui.tips.data.0087.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Navigate your command history effortlessly with “named marks” by assigning names to lines in the terminal."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"为终端中的行指定名称，使用“命名标记”轻松浏览命令历史记录。"}}}},
    "ui.tips.data.0087.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Named Marks"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"命名标记"}}}},
    "ui.tips.data.0088.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"You can assign specific fonts to Unicode ranges. Use 'Settings > Profiles > Text > Manage Special Exceptions' to manage it and to install a huge set of Powerline symbols."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"可为不同 Unicode 范围指定特定字体。使用“设置 > 配置文件 > 文本 > 管理特殊例外”进行管理，并安装一整套 Powerline 符号。"}}}},
    "ui.tips.data.0088.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Font Assignments"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"字体分配"}}}},
    "ui.tips.data.0089.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Maintain clarity in your active window while enjoying transparency in background windows by using 'View > Disable transparency in key window'."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"使用“显示 > 在关键窗口中禁用透明度”，可在背景窗口保持透明效果的同时，让当前窗口内容清晰可见。"}}}},
    "ui.tips.data.0089.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Disable Transparency"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"禁用透明度"}}}},
    "ui.tips.data.0090.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Create two-keystroke shortcuts with a “leader”: a special keystroke that precedes a custom key binding."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"使用“前导键”创建由两次按键组成的快捷键；前导键是在自定义按键绑定之前按下的特殊按键。"}}}},
    "ui.tips.data.0090.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Leader Shortcut"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"前导键快捷键"}}}},
    "ui.tips.data.0091.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Execute a series of actions in order with a single shortcut using “sequence” key bindings."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"使用“序列”按键绑定，通过一个快捷键按顺序执行一系列动作。"}}}},
    "ui.tips.data.0091.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Sequence Binding"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"序列绑定"}}}},
    "ui.tips.data.0092.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Easily backup or transfer your iTerm2 settings using the Export/Import feature in “Settings > General > Settings”."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"使用“设置 > 通用 > 设置”中的导出/导入功能，轻松备份或转移 iTerm2 设置。"}}}},
    "ui.tips.data.0092.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Export/Import Settings"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"导出/导入设置"}}}},
    "ui.tips.data.0093.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Apply key bindings uniformly across multiple sessions for consistent control in different tabs or windows."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"在多个会话中统一应用按键绑定，以便在不同标签页或窗口中保持一致的控制方式。"}}}},
    "ui.tips.data.0093.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Multi-Session Bindings"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"多会话绑定"}}}},
    "ui.tips.data.0094.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Simulate terminal input as if it were output from a running app with the “Inject” trigger."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"使用“注入”触发器模拟终端输入，使其看起来像是运行中的 App 所产生的输出。"}}}},
    "ui.tips.data.0094.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Inject Trigger"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"注入触发器"}}}},
    "ui.tips.data.0095.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Easily manage your triggers using the new Triggers status bar component."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"使用新的“触发器”状态栏组件轻松管理触发器。"}}}},
    "ui.tips.data.0095.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Trigger Status Bar"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"触发器状态栏"}}}},
    "ui.tips.data.0096.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Display session size directly in tab titles for convenient at-a-glance information."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"直接在标签页标题中显示会话大小，方便一眼查看。"}}}},
    "ui.tips.data.0096.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Session Size in Tab"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"标签页中的会话大小"}}}},
    "ui.tips.data.0097.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Edit snippets in Advanced Paste by holding the ⌥ key, or open them in the composer with ⇧."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"按住 ⌥ 可在“高级粘贴”中编辑片段，按住 ⇧ 则可在 Composer 中打开片段。"}}}},
    "ui.tips.data.0097.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Advanced Snippet Editing"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"高级片段编辑"}}}},
    "ui.tips.data.0098.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Save your terminal logs in HTML format for enhanced readability and sharing capabilities."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"以 HTML 格式保存终端日志，提升可读性并便于共享。"}}}},
    "ui.tips.data.0098.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"HTML Logs"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"HTML 日志"}}}},
    "ui.tips.data.0099.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Create and play back terminal recordings with ASCIICast logs, compatible with asciinema."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"使用 ASCIICast 日志创建并回放终端录制，与 asciinema 兼容。"}}}},
    "ui.tips.data.0099.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"ASCIICast Logs"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"ASCIICast 日志"}}}},
    "ui.tips.data.0100.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Include timestamps in your logs for better tracking and event correlation."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"在日志中加入时间戳，便于跟踪和关联事件。"}}}},
    "ui.tips.data.0100.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Timestamped Logs"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"带时间戳的日志"}}}},
    "ui.tips.data.0101.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Utilize LastPass or 1Password with the password manager by configuring it in the menu next to the search field."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"通过搜索栏旁的菜单进行配置，即可在密码管理器中使用 LastPass 或 1Password。"}}}},
    "ui.tips.data.0101.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"LastPass & 1Password"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"LastPass 与 1Password"}}}},
    "ui.tips.data.0102.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Access your password manager without authentication by adjusting the settings via the menu next to its search field."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"通过密码管理器搜索栏旁的菜单调整设置，即可免认证访问密码管理器。"}}}},
    "ui.tips.data.0102.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Password Manager Access"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"密码管理器访问"}}}},
    "ui.tips.data.0103.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Generate strong, secure passwords using the password manager’s new password generation feature."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"使用密码管理器新增的密码生成功能，生成强健、安全的密码。"}}}},
    "ui.tips.data.0103.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Password Generation"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"密码生成"}}}},
    "ui.tips.data.0104.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Access tips of the day with the it2tip utility, a command line app. Enable it by installing shell integration and utilities."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"使用命令行 App it2tip 查看每日提示。安装 Shell 集成及其实用工具后即可启用。"}}}},
    "ui.tips.data.0104.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"it2tip Utility"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"it2tip 实用工具"}}}},
    "ui.tips.data.0105.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Experience automatic shell integration when creating a login shell, removing the need for explicit setup on your Mac."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"创建登录 Shell 时可自动启用 Shell 集成，无需在 Mac 上显式设置。"}}}},
    "ui.tips.data.0105.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Auto Shell Integration"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"自动 Shell 集成"}}}},
    "ui.tips.data.0106.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Get detailed information about commands by ⌘-clicking on the command prompt."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"按住 ⌘ 点按命令提示符，可查看命令的详细信息。"}}}},
    "ui.tips.data.0106.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Command Prompt Info"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"命令提示符信息"}}}},
    "ui.tips.data.0107.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Use tmux integration for automatic key bindings that emulate tmux’s shortcuts, configurable via the Leader settings."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"使用 tmux 集成可自动设置模拟 tmux 快捷键的按键绑定，并可通过“前导键”设置进行配置。"}}}},
    "ui.tips.data.0107.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"tmux Integration"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"tmux 集成"}}}},
    "ui.tips.data.0108.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Sync your tmux paste buffer with the local clipboard for seamless integration (requires tmux 3.4)."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"将 tmux 粘贴缓冲区与本地剪贴板同步，实现无缝集成（需要 tmux 3.4）。"}}}},
    "ui.tips.data.0108.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"tmux Clipboard Mirroring"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"tmux 剪贴板镜像"}}}},
    "ui.tips.data.0109.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Enhance your editing in the Composer with multiple cursors, created using ^⇧-up/down or ⌥-drag."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"在 Composer 中使用多个光标增强编辑体验；可通过 ^⇧-上/下箭头或按住 ⌥ 拖动来创建光标。"}}}},
    "ui.tips.data.0109.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Multi-Cursor in Composer"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Composer 多光标"}}}},
    "ui.tips.data.0110.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Move content from the Composer to the Advanced Paste window with ⌥⌘V for additional editing options."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"按 ⌥⌘V 将内容从 Composer 移到“高级粘贴”窗口，以使用更多编辑选项。"}}}},
    "ui.tips.data.0110.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Advanced Paste from Composer"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"从 Composer 使用高级粘贴"}}}},
    "ui.tips.data.0111.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Search within the Composer using ⌘F to quickly find specific text."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"在 Composer 中使用 ⌘F 搜索，快速查找特定文本。"}}}},
    "ui.tips.data.0111.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Composer Search"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Composer 搜索"}}}},
    "ui.tips.data.0112.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Adjust the Composer’s height to suit your needs by dragging its bottom edge."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"拖动 Composer 底边即可调整其高度。"}}}},
    "ui.tips.data.0112.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Resize Composer"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"调整 Composer 大小"}}}},
    "ui.tips.data.0113.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Learn more about your commands by ⌘-clicking in the Composer to open them in explainshell.com."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"在 Composer 中按住 ⌘ 点按命令，即可在 explainshell.com 中打开并了解详情。"}}}},
    "ui.tips.data.0113.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Explain Command"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"解释命令"}}}},
    "ui.tips.data.0114.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Quickly send and remove commands in the Composer using ⌥⇧-enter."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"在 Composer 中使用 ⌥⇧-enter 快速发送并移除命令。"}}}},
    "ui.tips.data.0114.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Quick Command Send"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"快速发送命令"}}}},
    "ui.tips.data.0115.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Queue up a command in the Composer to be sent after the current command finishes with ⌥-Enter."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"在 Composer 中使用 ⌥-Enter 将命令加入队列，等当前命令完成后发送。"}}}},
    "ui.tips.data.0115.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Queue Commands"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"命令排队"}}}},
    "ui.tips.data.0116.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Reposition the Tip of the Day window conveniently on your screen, as it is now draggable."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"每日提示窗口现在可以拖动，方便在屏幕上调整位置。"}}}},
    "ui.tips.data.0116.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Draggable Tip Window"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"可拖动的每日提示窗口"}}}},
    "ui.tips.data.0117.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"iTerm2 now has an AI Chat feature! Use “Window > AI Chats” or “Edit > Explain Output with AI”. The assistant can interact with your terminal (with your permission) and explain command output, adding annotations right in the terminal."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"iTerm2 现在提供 AI 聊天功能！使用“窗口 > AI 聊天”或“编辑 > 使用 AI 解释输出”。助手可在你的许可下与终端交互、解释命令输出，并直接在终端中添加注释。"}}}},
    "ui.tips.data.0117.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"AI Chat"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"AI 聊天"}}}},
    "ui.tips.data.0118.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"You can configure a profile to be a web browser! In “Settings > Profiles > General”, set “Profile Type” to “Web Browser”. Key bindings, smart selection, and the password manager all work in browser sessions."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"可以将配置文件设为网页浏览器！在“设置 > 配置文件 > 通用”中，将“配置文件类型”设为“网页浏览器”。按键绑定、智能选择和密码管理器在浏览器会话中同样可用。"}}}},
    "ui.tips.data.0118.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Web Browser Profiles"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"网页浏览器配置文件"}}}},
    "ui.tips.data.0119.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Timestamps can now be shown next to terminal content instead of overlapping. Configure it in “Settings > Profiles > Session > Timestamps”. Right-click on any line and select “Set Baseline for Relative Timestamps” to see time elapsed between lines."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"时间戳现在可以显示在终端内容旁边，而不再与内容重叠。可在“设置 > 配置文件 > 会话 > 时间戳”中配置。右键点按任意一行并选择“设置相对时间戳基准”，即可查看各行之间经过的时间。"}}}},
    "ui.tips.data.0119.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Adjacent Timestamps"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"相邻时间戳"}}}},
    "ui.tips.data.0120.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Select a block of JSON text and choose “Edit > Replace Selection > Replace with Pretty-Printed JSON” to make it readable. Perfect for debugging API responses and log files."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"选择一段 JSON 文本并选取“编辑 > 替换所选内容 > 替换为格式化的 JSON”，使其更易读。非常适合调试 API 响应和日志文件。"}}}},
    "ui.tips.data.0120.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Pretty-Print JSON"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"格式化 JSON"}}}},
    "ui.tips.data.0121.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Open Quickly (⇧⌘O) is now a command palette! Just type the name of a menu item to activate it."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"“快速打开”(⇧⌘O) 现在也是命令面板！只需输入菜单项名称即可激活。"}}}},
    "ui.tips.data.0121.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Command Palette"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"命令面板"}}}},
    "ui.tips.data.0122.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Enable “Settings > Profiles > Terminal > Click on a path in a shell prompt to open Navigator” to navigate your filesystem by clicking on paths in your prompt. Requires Shell Integration."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"启用“设置 > 配置文件 > 终端 > 点击 Shell 提示符中的路径以打开导航器”，即可点按提示符中的路径浏览文件系统。需要 Shell 集成。"}}}},
    "ui.tips.data.0122.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Click Paths in Shell Prompts"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"点按 Shell 提示符中的路径"}}}},
    "ui.tips.data.0123.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"When connected via SSH Integration, use “Shell > ssh > Download Files” to browse and download files from the remote host without opening a new connection. Files on SSH hosts also appear in file open/save dialogs!"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"通过 SSH 集成连接时，使用“Shell > ssh > 下载文件”可浏览并下载远程主机上的文件，无需打开新连接。SSH 主机上的文件也会出现在文件打开/保存对话框中！"}}}},
    "ui.tips.data.0123.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"SSH File Browser"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"SSH 文件浏览器"}}}}
  },
  "version": "1.0"
}
