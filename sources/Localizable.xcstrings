    "ui.swift.aiterm.remotecommand.by_setting_this_permission_to_always_allow_terminal.9a2a1ecd": {
      "comment": "User-facing text in RemoteCommand.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "By setting this permission to “Always Allow”, terminal state will be sent automatically on every message you send in this chat.\nThis includes:\n • The current or last command and its exit status\n •The window size\n • Your shell\n • The current working directory, username, and hostname."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将此权限设为“始终允许”后，每次您在此聊天中发送消息时，都会自动发送终端状态。\n其中包括：\n • 当前或上一条命令及其退出状态\n • 窗口大小\n • 您使用的 Shell\n • 当前工作目录、用户名和主机名。"
          }
        }
      }
    },
    "ui.swift.aiterm.remotecommand.by_setting_this_permission_to_always_allow_the.054babf1": {
      "comment": "User-facing text in RemoteCommand.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "By setting this permission to “Always Allow”, the current visible screen of your terminal session will be sent automatically on every message you send in this chat."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将此权限设为“始终允许”后，每次您在此聊天中发送消息时，都会自动发送终端会话当前可见的屏幕内容。"
          }
        }
      }
    },
