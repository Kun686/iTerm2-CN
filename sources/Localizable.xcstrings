    "ui.browser.page.onboarding.features.platform.description": {
      "comment": "User-facing text on an iTerm2 Browser onboarding page.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some features like Passkeys and advanced ad blocking are unavailable due to Apple’s restrictions on web views."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "受 Apple 对 Web View 的限制，通行密钥和高级广告拦截等部分功能不可用。"
          }
        }
      }
    },
