    "ui.swift.aiterm.remotecommand_mac.iterm2_can_use_ai_to_check_the_safety.2c521501": {
      "comment": "User-facing text in RemoteCommand+Mac.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iTerm2 can use AI to check the safety of commands suggested by your AI agent. Would you like to enable safety checking?\n\nWhen enabled, each proposed command will be sent to your configured AI provider for a safety check."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iTerm2 可以使用 AI 检查 AI 代理所建议命令的安全性。要启用安全检查吗？\n\n启用后，每条建议的命令都会发送给您配置的 AI 提供商进行安全检查。"
          }
        }
      }
    },
