      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A required file appears to be missing or corrupted, yet against all odds the code signature for iTerm2 is valid. Please file a bug at https://iterm2.com/bugs"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所需文件似乎缺失或损坏，但 iTerm2 的代码签名仍然有效。请前往 https://iterm2.com/bugs 报告 Bug"
          }
        }
      }
    },
    "ui.settings.itermpreferencesbaseviewcontroller.a_required_file_appears_to_be_missing_or.b2368b26": {
