    "ui.ptysession.ptysession.warning_this_profile_uses_a_custom_locale_that.550ec792": {
      "comment": "User-facing warning message.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Warning! This profile uses a custom locale that doesn't use UTF-8 as its character encoding, but your profile *is* using UTF-8. This can cause error messages and non-ASCII text to appear wrong."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "警告！此配置文件使用自定义区域设置，其字符编码不是 UTF-8，但配置文件本身使用 UTF-8。这可能导致错误信息和非 ASCII 文本显示异常。"
          }
        }
      }
    },
    "ui.ptysession.ptysession.when_mouse_reporting_is_on_horizontal_scrolling_does.f81d4d88": {
