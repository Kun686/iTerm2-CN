    "ui.swift.toolbelt.toolstatus.select_a_session_to_snooze_it.aecc4af6": {
      "comment": "User-facing text in ToolStatus.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select a session to snooze it."
          }
        },
        "zh-Hans": {
