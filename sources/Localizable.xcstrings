    "ui.swift.claudecode.orchestration.orchestratordispatcher.the_agent_is_asking_to_send_keystrokes_and.7a57f250": {
      "comment": "User-facing text in OrchestratorDispatcher.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The agent is asking to send keystrokes and interrupt running commands in session “%1$@”. Approval is sticky for the rest of this chat. Deny to refuse this and future control of this session until you explicitly approve."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "代理请求向会话“%1$@”发送按键并中断正在运行的命令。批准后，本次聊天的剩余期间将持续有效。拒绝后，在您明确批准之前，将拒绝此次及今后对此会话的控制。"
          }
        }
      }
    },
    "ui.swift.claudecode.orchestration.orchestratordispatcher.the_agent_is_asking_to_send_keystrokes_interrupt.420013f5": {
      "comment": "User-facing text in OrchestratorDispatcher.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The agent is asking to send keystrokes, interrupt running commands, and post clippings to this workgroup. Approval is sticky for the rest of this chat. Deny to refuse this and future control of this workgroup until you explicitly approve."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "代理请求发送按键、中断正在运行的命令，并向此工作组发布剪贴项。批准后，本次聊天的剩余期间将持续有效。拒绝后，在您明确批准之前，将拒绝此次及今后对此工作组的控制。"
          }
        }
      }
    },
