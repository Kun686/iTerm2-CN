            "state": "translated",
            "value": "不支持所选的应用界面语言。"
          }
        }
      }
    },
    "settings.general.language.option.en": {
      "shouldTranslate": false,
      "comment": "English application language option.",
      "extractionState": "manual",
      "localizations": {
