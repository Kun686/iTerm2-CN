    "ui.shell_integration.steps.script_suffix": {"comment":"Display-only installer step fragment; keep format arguments and shell names unchanged.","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"%@ the shell integration script."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"%@ Shell 集成脚本。"}}}},
