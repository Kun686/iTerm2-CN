    "ui.swift.claudecode.claudecodeonboarding.install_the_claude_code_workgroup_which_groups_your.bd549419": {
      "comment": "User-facing text in ClaudeCodeOnboarding.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install the Claude Code workgroup, which groups your main Claude session with two peer sessions: a diff viewer and a code-review session. You can switch between them with one click.\n\nYou can customize this layout later in Settings > Shortcuts > Workgroups."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安装 Claude Code 工作组，将主 Claude 会话与两个对等会话（差异查看器和代码审查会话）编为一组。您可以点按一次在它们之间切换。\n\n之后可在“设置”>“快捷键”>“工作组”中自定义此布局。"
          }
        }
      }
    },
    "ui.swift.claudecode.claudecodeonboarding.install_workgroup.070ece19": {
      "comment": "User-facing text in ClaudeCodeOnboarding.",
