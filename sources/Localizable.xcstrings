    },
    "ui.settings.keyspreferencesviewcontroller.some_keyboard_layouts_such_as_azerty_require_a.26948394": {
      "comment": "User-facing text in KeysPreferencesViewController (emulateUsKeyboardHelp:).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some keyboard layouts (such as AZERTY) require a modifier to press a number key. This causes problems for switching to a window, tab, or split pane by pressing modifier+number: you might need other modifiers or conflicting modifiers. When “Emulate US Keyboard” is enabled, you can press the configured modifier plus the key on the top row that corresponds to a number key on a US keyboard. For example, on AZERTY, the & key would act as the 1 key."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "某些键盘布局（例如 AZERTY）需要配合修饰键才能输入数字。这会影响用修饰键+数字切换窗口、标签页或分割窗格：可能需要额外或冲突的修饰键。启用“模拟美式键盘”后，可以按已配置的修饰键和顶行中对应美式键盘数字键的按键。例如在 AZERTY 键盘上，& 键将作为 1 键。"
          }
        }
      }
    },
