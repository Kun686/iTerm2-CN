    "ui.advanced.setting.OpenProfilesInNewWindow.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choosing a profile from the “Profiles” menu opens a new window.\nYou must restart iTerm2 after changing this setting for it to take effect."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从“配置文件”菜单选择配置文件时打开新窗口。\n更改此设置后必须重新启动 iTerm2 才能生效。"
          }
        }
      }
    },
    "ui.advanced.setting.UseUnevenTabs.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uneven tab widths allowed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许标签页宽度不一致。"
          }
        }
      }
    },
    "ui.advanced.setting.MinTabWidth.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Minimum tab width when using uneven tab widths."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用不等宽标签页时的最小宽度。"
          }
        }
      }
    },
    "ui.advanced.setting.MinCompactTabWidth.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Minimum tab width when using uneven tab widths for compact tabs."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "紧凑标签页使用不等宽布局时的最小宽度。"
          }
        }
      }
    },
    "ui.advanced.setting.OptimumTabWidth.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preferred tab width when tabs are equally sized."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标签页等宽时的首选宽度。"
          }
        }
      }
    },
    "ui.advanced.setting.ScrollableTabWidth.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tab width when the tab bar is scrollable.\nUsed as the fixed width when tabs are equally sized, and as the minimum width when uneven tab widths are allowed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标签栏可滚动时的标签页宽度。\n标签页等宽时作为固定宽度；允许不等宽时作为最小宽度。"
          }
        }
      }
    },
    "ui.advanced.setting.MoveLeftAfterClosingTab.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select the tab to the left when closing a tab?\nIf disabled, the tab to the right of the closing tab will be selected."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭标签页时选中左侧标签页？\n禁用后将选中被关闭标签页右侧的标签页。"
          }
        }
      }
    },
    "ui.advanced.setting.NavigatePanesInReadingOrder.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Next Pane and Previous Pane commands use reading order, not the time of last use."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“下一个窗格”和“上一个窗格”按阅读顺序切换，而非上次使用时间。"
          }
        }
      }
    },
    "ui.advanced.setting.TabAutoShowHoldTime.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How long in seconds to show tabs in fullscreen.\nThe tab bar appears briefly in fullscreen when the number of tabs changes or you switch tabs. This setting gives the time in seconds for it to remain visible."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全屏时标签栏显示的时长（秒）。\n全屏时，标签页数量变化或切换标签页会使标签栏短暂显示。此设置指定其保持可见的秒数。"
          }
        }
      }
    },
    "ui.advanced.setting.TabFlashAnimationDuration.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Animation duration for fade in/out animation of tabs in full screen, in seconds."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全屏时标签栏淡入淡出动画的时长（秒）。"
          }
        }
      }
    },
    "ui.advanced.setting.AllowDragOfTabIntoNewWindow.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow a tab to be dragged and dropped outside any existing tab bar to create a new window."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许将标签页拖到所有现有标签栏之外以创建新窗口。"
          }
        }
      }
    },
    "ui.advanced.setting.AllowDragOnAddTabButton.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow dragging window by the Add Tab button in the tab bar?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许通过标签栏的添加标签页按钮拖动窗口？"
          }
        }
      }
    },
    "ui.advanced.setting.MinimumTabDragDistance.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How far must the mouse move before a tab drag is initiated?\nYou must restart iTerm2 after changing this setting for it to take effect."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "鼠标移动多远后才开始拖动标签页？\n更改此设置后必须重新启动 iTerm2 才能生效。"
          }
        }
      }
    },
    "ui.advanced.setting.TabTitlesUseSmartTruncation.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use “smart truncation” for tab titles.\nIf a tab‘s title is too long to fit, ellipsize the start of the title if more tabs have unique suffixes than prefixes in a given window."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对标签页标题使用“智能截断”。\n标题过长时，如果窗口中更多标签页的独特部分位于末尾而非开头，则省略标题开头。"
          }
        }
      }
    },
    "ui.advanced.setting.MiddleClickClosesTab.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Should middle-click on a tab in the tab bar close the tab?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "中键点击标签栏中的标签页时关闭它？"
          }
        }
      }
    },
    "ui.advanced.setting.ColoredSelectedTabOutlineStrength.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How prominent should the outline around the selected tab be drawn when there are colored tabs in a window?\nTakes a value in 0 to 3, where 0 means no outline and 3 means a very prominent outline."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "窗口中存在彩色标签页时，选中标签页的轮廓应有多明显？\n取值为 0 到 3；0 表示无轮廓，3 表示非常明显。"
          }
        }
      }
    },
    "ui.advanced.setting.MinimalEdgeDragSize.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In the Minimal theme, you can move the window by dragging starting in a region on the edge near the window border. This gives the size of that region."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在精简主题中，可从窗口边框附近的边缘区域开始拖动来移动窗口。此值指定该区域的大小。"
          }
        }
      }
    },
    "ui.advanced.setting.PinnedTabWidth.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Width of pinned tabs in pixels."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "固定标签页的宽度（像素）。"
          }
        }
      }
    },
    "ui.advanced.setting.CompactEdgeDragSize.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In the Compact theme, you can move the window by dragging starting in a region on the edge near the window border. This gives the size of that region."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在紧凑主题中，可从窗口边框附近的边缘区域开始拖动来移动窗口。此值指定该区域的大小。"
          }
        }
      }
    },
    "ui.advanced.setting.MinimalTabStyleBackgroundColorDifference.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In the Minimal theme, how different should the background color of the selected tab be from the others?\nTakes a value in 0 to 1, where 0 is no difference and 1 very different."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "精简主题中，选中标签页的背景色与其他标签页应有多大差异？\n取值为 0 到 1；0 表示无差异，1 表示差异很大。"
          }
        }
      }
    },
    "ui.advanced.setting.MinimalTabStyleOutlineStrength.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In the Minimal theme, how prominent should the tab outline be?\nTakes a value in 0 to 1, where 0 is invisible and 1 is very prominent"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "精简主题中标签页轮廓的明显程度。\n取值为 0 到 1；0 表示不可见，1 表示非常明显"
          }
        }
      }
    },
    "ui.advanced.setting.MinimalSplitPaneDividerProminence.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In the Minimal theme, how prominent should split pane dividers be?\nTakes a value in 0 to 1, where 0 is invisible and 1 is very prominent"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "精简主题中窗格分隔线的明显程度。\n取值为 0 到 1；0 表示不可见，1 表示非常明显"
          }
        }
      }
    },
    "ui.advanced.setting.ColoredUnselectedTabTextProminence.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How prominent should the text in a non-selected tab be when there are colored tabs in a window?\nTakes a value in 0 to 1, the alpha value."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "窗口中存在彩色标签页时，未选中标签页的文字应有多明显？\n取值为 0 到 1，表示不透明度。"
          }
        }
      }
    },
    "ui.advanced.setting.MinimalTextLegibilityAdjustment.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How much should contrast be increased for text in tabs in the Minimal theme?\nChoose a value larger than 1 to increase contrast. Values between 0 and 1 have less contrast than the default."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "精简主题中标签页文字的对比度增幅。\n大于 1 可提高对比度；0 到 1 之间的值低于默认对比度。"
          }
        }
      }
    },
    "ui.advanced.setting.MinimalTabStyleTreatLeftInsetAsPartOfFirstTab.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In the Minimal theme, should the area left of the tab bar be treated as part of the first tab?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "精简主题中，将标签栏左侧区域视为第一个标签页的一部分？"
          }
        }
      }
    },
    "ui.advanced.setting.CompactMinimalTabBarHeight.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tab bar height (points) for the Minimal theme.\nThe default is 38. Use 22 to match the compact theme's height."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "精简主题的标签栏高度（点）。\n默认为 38。设为 22 可与紧凑主题的高度一致。"
          }
        }
      }
    },
    "ui.advanced.setting.DefaultTabBarHeight.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Default tab bar height\nThis does not affect the minimal or compact themes. On macOS 26 Tahoe-style tabs, the top (horizontal) tab bar uses the system height and ignores this setting; left/right (vertical) tabs use max(26, this value) for each tab’s height."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认标签栏高度\n不影响精简或紧凑主题。macOS 26 的 Tahoe 风格顶部（水平）标签栏使用系统高度，忽略此设置；左侧或右侧（垂直）标签页的高度使用 max(26, this value)。"
          }
        }
      }
    },
    "ui.advanced.setting.DoubleClickTabToEdit.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Should double-clicking a tab open a window to edit its title?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "双击标签页时打开标题编辑窗口？"
          }
        }
      }
    },
    "ui.advanced.setting.MinimumTabLabelWidth.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Minimum width for tab labels.\nThe activity/bell icon will be hidden when the space for the label drops below this size (in points)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标签页标签的最小宽度。\n标签可用空间小于此值（点）时，隐藏活动或响铃图标"
          }
        }
      }
    },
    "ui.advanced.setting.DisregardDockSettingToOpenTabsInsteadOfWindows.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ignore System Settings > Dock > Prefer tabs when opening documents?\nWhen set to No, asking to open a window will open a tab instead when system settings is configured to prefer tabs over windows. When set to Yes, asking to open a window may open a tab instead."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "忽略“系统设置 > 程序坞 > 打开文稿时首选标签页”？\n设为“否”时，若系统首选标签页，请求打开窗口会改为打开标签页。设为“是”时，请求打开窗口也可能改为打开标签页。"
          }
        }
      }
    },
    "ui.advanced.setting.ConvertTabDragToWindowDragForSolitaryTabInCompactOrMinimalTheme.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In the Minimal and Compact themes when there is a single tab and the tab bar is visible, should dragging the tab bar move the window?\nThis also affects windows without titlebars in any theme."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "精简和紧凑主题中只有一个标签页且标签栏可见时，拖动标签栏是否移动窗口？\n这也影响任何主题中没有标题栏的窗口。"
          }
        }
      }
    },
    "ui.advanced.setting.HighVisibility.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "High Contrast modes maximize visibility.\nWhen enabled, the dark high-contrast theme emphasizes visibility over beauty."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "高对比度模式最大程度提高可见性。\n启用后，深色高对比度主题优先保证可见性而非美观。"
          }
        }
      }
    },
    "ui.advanced.setting.DrawBottomLineForHorizontalTabBar.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Draw bottom line for horizontal tabbar in Regular, Dark and Light theme?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在常规、深色和浅色主题中绘制水平标签栏的底线？"
          }
        }
      }
    },
    "ui.advanced.setting.DisableTabBarTooltips.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disable tab bar tooltips?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "禁用标签栏工具提示？"
          }
        }
      }
    },
    "ui.advanced.setting.UseCustomTabBarFontSize.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use custom font size for tab labels?\nSee also advanced setting “Custom tab label font size”."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自定义标签页标签的字号？\n另请参阅高级设置“自定义标签页标签字号”。"
          }
        }
      }
    },
    "ui.advanced.setting.CustomTabBarFontSize.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Custom tab label font size\nFor this to take effect, turn on “Use custom font size for tab labels?”."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自定义标签页标签字号\n需开启“自定义标签页标签的字号？”才能生效。"
          }
        }
      }
    },
    "ui.advanced.setting.MinimalSelectedTabUnderlineProminence.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prominence of selected tab underline indicator in the Minimal theme when there is at least one colored tab."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "精简主题中至少有一个彩色标签页时，选中标签页下划线指示器的明显程度。"
          }
        }
      }
    },
    "ui.advanced.setting.AllowInteractiveSwipeBetweenTabs.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow two-finger interactive swipe between tabs?\nThe system preference Trackpad > More Gestures > Swipe between pages controls this globally. When “swipe with two fingers” is enabled, you can change this setting to “No” to prevent swiping between tabs in iTerm2."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许用双指交互式轻扫切换标签页？\n“系统设置 > 触控板 > 更多手势 > 在页面之间轻扫”全局控制此功能。启用“双指轻扫”时，可将此设置改为“否”以阻止在 iTerm2 中轻扫切换标签页。"
          }
        }
      }
    },
    "ui.advanced.setting.SelectsTabsOnMouseDown.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select tabs on mouse-down?\nChanging this setting will not affect existing windows."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按下鼠标时选中标签页？\n更改此设置不影响现有窗口。"
          }
        }
      }
    },
    "ui.advanced.setting.MinimalDeslectedColoredTabAlpha.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alpha value for tab color for non-selected colored tabs in the Minimal theme.\nMust be between 0 and 1."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "精简主题中未选中彩色标签页的颜色不透明度。\n必须介于 0 和 1 之间。"
          }
        }
      }
    },
    "ui.advanced.setting.TabColorMenuOptions.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Colors for tab color menu item.\nSpace delimited strings like #rrggbb or #rgb in sRGB color space. If the P3 color space is available, you can use strings like: color(p3 1 0.5 0.25)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标签页颜色菜单中的颜色。\n使用空格分隔的 sRGB 颜色字符串，如 #rrggbb 或 #rgb。如果支持 P3 色彩空间，也可使用 color(p3 1 0.5 0.25) 这样的字符串"
          }
        }
      }
    },
    "ui.advanced.setting.RemoveAddTabButton.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove the “new tab” button from horizontal tab bars?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移除水平标签栏中的“新建标签页”按钮？"
          }
        }
      }
    },
    "ui.advanced.setting.AddTabButtonUsesCurrentProfile.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Should the “new tab” button in the tab bar use the current session’s profile?\nWhen enabled, clicking the “+” button opens a new tab with the current session’s profile instead of the default profile."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标签栏中的“新建标签页”按钮使用当前会话的配置文件？\n启用后，点击“+”按钮将使用当前会话的配置文件而非默认配置文件创建标签页。"
          }
        }
      }
    },
    "ui.advanced.setting.LightModeInactiveTabDarkness.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Darkness (in [0…1]) for non-selected tabs in non-Minimal theme in light mode."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "浅色模式下非精简主题中未选中标签页的暗度（[0…1]）。"
          }
        }
      }
    },
    "ui.advanced.setting.DarkModeInactiveTabDarkness.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Darkness (in [0…1]) for non-selected tabs in non-Minimal theme in dark mode."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "深色模式下非精简主题中未选中标签页的暗度（[0…1]）。"
          }
        }
      }
    },
    "ui.advanced.setting.SaveProfilesToRecentDocuments.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add items to Recents (in the dock icon's menu) to reopen recently used profiles as tabs?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在“最近使用”（程序坞图标菜单中）添加项目，以标签页重新打开最近使用的配置文件？"
          }
        }
      }
    },
    "ui.advanced.setting.PlaceTabsInTitlebarAccessoryInFullScreen.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Place the tabbar in the window's titlebar in full screen mode (macOS 13+ only)?\nThis can be disabled to work around a bug in macOS where tabs may not be visible in full screen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全屏时将标签栏放入窗口标题栏（仅限 macOS 13 及更高版本）？\n可禁用此项以规避 macOS 中全屏时标签页可能不可见的问题。"
          }
        }
      }
    },
    "ui.advanced.setting.DefaultIconsUsingLetters.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the running command's first letter as the tab's default icon if there isn't a built in one.\nThis takes effect when tabs are configured to use built-in icons."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有内置图标时，使用正在运行的命令的首字母作为标签页默认图标。\n标签页配置为使用内置图标时生效。"
          }
        }
      }
    },
    "ui.advanced.setting.TabCloseButtonsAlwaysVisible.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Should tab close buttons always remain visible?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "始终显示标签页关闭按钮？"
          }
        }
      }
    },
    "ui.advanced.setting.UseSequoiaStyleTabs.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Sequoia-style tabs in Tahoe and later?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Tahoe 及更高版本中使用 Sequoia 风格的标签页？"
          }
        }
      }
    },
    "ui.advanced.setting.SplitPaneSourceFillColor.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Color of source pane fill when moving/swapping a split pane.\nShould be a web-style color, #rrggbb. You can also use p3#rrggbb for p3 color space."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移动或交换分割窗格时源窗格的填充颜色。\n使用网页颜色格式 #rrggbb，也可用 p3#rrggbb 表示 P3 色彩空间。"
          }
        }
      }
    },
    "ui.advanced.setting.SplitPaneSourceBorderColor.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Color of source pane outer border when moving/swapping a split pane.\nShould be a web-style color, #rrggbb. You can also use p3#rrggbb for p3 color space."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移动或交换分割窗格时源窗格的外边框颜色。\n使用网页颜色格式 #rrggbb，也可用 p3#rrggbb 表示 P3 色彩空间。"
          }
        }
      }
    },
    "ui.advanced.setting.SplitPaneSourceInnerBorderColor.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Color of source pane inner border when moving/swapping a split pane.\nShould be a web-style color, #rrggbb. You can also use p3#rrggbb for p3 color space."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移动或交换分割窗格时源窗格的内边框颜色。\n使用网页颜色格式 #rrggbb，也可用 p3#rrggbb 表示 P3 色彩空间。"
          }
        }
      }
    },
    "ui.advanced.setting.SplitPaneTargetDropFillColor.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Color of drop target fill when dragging a split pane.\nShould be a web-style color, #rrggbb. You can also use p3#rrggbb for p3 color space."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动分割窗格时放置目标的填充颜色。\n使用网页颜色格式 #rrggbb，也可用 p3#rrggbb 表示 P3 色彩空间。"
          }
        }
      }
    },
    "ui.advanced.setting.SplitPaneTargetDropBorderColor.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Color of drop target outer border when dragging a split pane.\nShould be a web-style color, #rrggbb. You can also use p3#rrggbb for p3 color space."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动分割窗格时放置目标的外边框颜色。\n使用网页颜色格式 #rrggbb，也可用 p3#rrggbb 表示 P3 色彩空间。"
          }
        }
      }
    },
    "ui.advanced.setting.SplitPaneTargetDropInnerBorderColor.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Color of drop target inner border when dragging a split pane.\nShould be a web-style color, #rrggbb. You can also use p3#rrggbb for p3 color space."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动分割窗格时放置目标的内边框颜色。\n使用网页颜色格式 #rrggbb，也可用 p3#rrggbb 表示 P3 色彩空间。"
          }
        }
      }
    },
    "ui.advanced.setting.AlternateMouseScrollStringForUp.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scroll wheel up sends the specified text when in alternate screen mode.\nThe value should use Vim syntax, such as \\e for escape."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "备用屏幕模式下，向上滚动滚轮时发送指定文本。\n此值应使用 Vim 语法，例如用 \\e 表示 Escape。"
          }
        }
      }
    },
    "ui.advanced.setting.AlternateMouseScrollStringForDown.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scroll wheel down sends the specified text when in alternate screen mode.\nThe value should use Vim syntax, such as \\e for escape."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "备用屏幕模式下，向下滚动滚轮时发送指定文本。\n此值应使用 Vim 语法，例如用 \\e 表示 Escape。"
          }
        }
      }
    },
    "ui.advanced.setting.AlternateMouseScroll.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scroll wheel sends arrow keys when in alternate screen mode."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "备用屏幕模式下，滚轮发送方向键。"
          }
        }
      }
    },
    "ui.advanced.setting.PinchToChangeFontSizeDisabled.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disable changing font size in response to a pinch gesture."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "禁用通过捏合手势更改字号。"
          }
        }
      }
    },
    "ui.advanced.setting.UseSystemCursorWhenPossible.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use system cursor icons when possible."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尽可能使用系统光标图标。"
          }
        }
      }
    },
    "ui.advanced.setting.AlwaysAcceptFirstMouse.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Always accept first mouse event on terminal windows.\nThis means clicks will work the same when iTerm2 is active as when it’s inactive. Note that there is a separate setting for mouse reporting on first mouse."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "始终接受终端窗口的首次鼠标事件。\n这使 iTerm2 未激活时的点击行为与激活时一致。首次点击的鼠标报告有单独设置。"
          }
        }
      }
    },
    "ui.advanced.setting.AutodetectMouseReportingStuck.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatically detect when mouse reporting got stuck on?\nThis watches for parts of mouse reporting control sequences being printed to the screen"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动检测鼠标报告是否卡在开启状态？\n监测是否有鼠标报告控制序列片段被打印到屏幕上"
          }
        }
      }
    },
    "ui.advanced.setting.ReportOnFirstMouse.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send mouse reports when you click in a window that isn't already frontmouse?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击尚未处于鼠标前台的窗口时发送鼠标报告？"
          }
        }
      }
    },
    "ui.advanced.setting.DoubleReportScrollWheel.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Double-report scroll wheel events to work around tmux scrolling bug."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重复报告滚轮事件，以规避 tmux 滚动问题。"
          }
        }
      }
    },
    "ui.advanced.setting.StealKeyFocus.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When Focus Follows Mouse is enabled, steal key focus even when inactive."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用“焦点跟随鼠标”时，即使应用未激活也获取键盘焦点。"
          }
        }
      }
    },
    "ui.advanced.setting.AggressiveFocusFollowsMouse.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When Focus Follows Mouse is enabled, activate the window under the cursor when iTerm2 becomes active?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用“焦点跟随鼠标”时，在 iTerm2 激活时激活光标下的窗口？"
          }
        }
      }
    },
    "ui.advanced.setting.CmdClickWhenInactiveInvokesSemanticHistory.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘-click in an active pane while iTerm2 isn't the active app invokes Semantic History.\nBy default, iTerm2 respects the OS standard that ⌘-click in an app that doesn't have keyboard focus behaves like a non-⌘ click that does not raise the window."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iTerm2 不是当前应用时，按住 ⌘ 点击活动窗格会调用语义历史。\n默认情况下，iTerm2 遵循系统约定：在没有键盘焦点的应用中按住 ⌘ 点击，等同于不按 ⌘ 点击且不会将窗口置前。"
          }
        }
      }
    },
    "ui.advanced.setting.EnableUnderlineSemanticHistoryOnCmdHover.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Underline Semantic History-selectable items under the cursor while holding ⌘?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住 ⌘ 时，为光标下可通过语义历史选择的项目加下划线？"
          }
        }
      }
    },
    "ui.advanced.setting.EnableCmdClickPromptForShowCommandInfo.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘-click in the prompt shows the Command Info window"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住 ⌘ 点击提示符可显示命令信息窗口"
          }
        }
      }
    },
    "ui.advanced.setting.SensitiveScrollWheel.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scroll on any scroll wheel movement, no matter how small?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "滚轮发生任何移动时都滚动，无论幅度多小？"
          }
        }
      }
    },
    "ui.advanced.setting.ScrollWheelAcceleration.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speed up scroll gestures by this factor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按此倍数加快滚动手势。"
          }
        }
      }
    },
    "ui.advanced.setting.FractionOfCharacterSelectingNextNeighbor.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fraction of character’s width on its right side that can be used to select the character to its right."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "字符右侧用于选中右邻字符的区域占字符宽度的比例。"
          }
        }
      }
    },
    "ui.advanced.setting.NaturalScrollingAffectsHorizontalMouseReporting.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Horizontal scrolling is reversed when “Natural scrolling” is enabled in System Settings"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统设置启用“自然滚动”时反转水平滚动"
          }
        }
      }
    },
    "ui.advanced.setting.HorizontalScrollingSensitivity.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sensitivity of mouse wheel for horizontal scrolling.\nUse 0 to disable. Value should be between 0 and 1. Changes to this setting only affect new sessions."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "鼠标滚轮的水平滚动灵敏度。\n设为 0 可禁用。取值应介于 0 和 1 之间。更改此设置仅影响新会话。"
          }
        }
      }
    },
    "ui.advanced.setting.UseDoubleClickDelayForCommandSelection.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wait to be sure it's not a double click before selecting a command"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择命令前等待确认此次点击不是双击"
          }
        }
      }
    },
    "ui.advanced.setting.RequireOptionToDragSplitPaneTitleBar.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Require Option to be pressed to drag a split pane by its title bar?\nThis helps prevent accidental drags."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过标题栏拖动分割窗格时要求按住 Option？\n可帮助防止意外拖动。"
          }
        }
      }
    },
    "ui.advanced.setting.BounceOnInactiveBell.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bounce dock icon when the bell rings while another app is active?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其他应用激活时，响铃是否让程序坞图标跳动？"
          }
        }
      }
    },
    "ui.advanced.setting.TraditionalVisualBell.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Visual bell flashes the whole screen, not just a bell icon."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可视响铃闪烁整个屏幕，而不只是响铃图标。"
          }
        }
      }
    },
    "ui.advanced.setting.IndicatorFlashInitialAlpha.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Initial alpha value when flashing the visual bell or search wraparound indicator"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可视响铃或搜索循环指示器闪烁时的初始不透明度"
          }
        }
      }
    },
    "ui.advanced.setting.TimeBetweenBlinks.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cursor blink speed (seconds)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "光标闪烁速度（秒）。"
          }
        }
      }
    },
    "ui.advanced.setting.DoNotSetCtype.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Never set the CTYPE environment variable."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "永不设置 CTYPE 环境变量。"
          }
        }
      }
    },
    "ui.advanced.setting.DebugShowPromptMarkRangesInLegacyRenderer.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Debug: highlight prompt mark prompt/command/excluded ranges in the legacy (non-GPU) renderer.\nWhen enabled, the legacy renderer overlays a blue outline around each visible prompt mark’s prompt range (OSC 133 A to B), a green outline around its command range (B to C), and a red outline around each excluded subrange (PS2 prefixes and right-prompt regions recorded via OSC 133 k=). Disable the Metal renderer (Settings → General → Magic) to see this. Intended for development and bug reports; leave off in normal use."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调试：在传统（非 GPU）渲染器中突出显示提示符标记的提示符、命令和排除范围。\n启用后，传统渲染器为每个可见提示符标记的提示符范围（OSC 133 A 到 B）绘制蓝色轮廓，为命令范围（B 到 C）绘制绿色轮廓，为每个排除子范围（通过 OSC 133 k= 记录的 PS2 前缀和右侧提示符区域）绘制红色轮廓。需禁用 Metal 渲染器（设置 → 通用 → Magic）才能看到。仅用于开发和问题报告，正常使用时请关闭。"
          }
        }
      }
    },
    "ui.advanced.setting.SmartCursorColorBgThreshold.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Threshold for Smart Cursor Color for background color (0 to 1).\n0 means the cursor’s background color will always be the cell’s text color, while 1 means it will always be black or white."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "智能光标颜色的背景色阈值（0 到 1）。\n0 表示光标背景色始终为单元格文字颜色，1 表示始终为黑色或白色。"
          }
        }
      }
    },
    "ui.advanced.setting.SmartCursorColorFgThreshold.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Threshold for Smart Cursor Color for text color (0 to 1).\n0 means the cursor’s text color will always be the cell’s background color, while 1 means it will always be black or white."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "智能光标颜色的文字颜色阈值（0 到 1）。\n0 表示光标文字颜色始终为单元格背景色，1 表示始终为黑色或白色。"
          }
        }
      }
    },
    "ui.advanced.setting.FindUrlsRegex.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Regular expression for “Find URLs” command."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“查找 URL”命令使用的正则表达式。"
          }
        }
      }
    },
    "ui.advanced.setting.FindURLsRespectsSoftBoundaries.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When using “Find URLs”, extend results across soft boundaries like tmux pane dividers."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用“查找 URL”时，允许结果跨越 tmux 窗格分隔线等软边界。"
          }
        }
      }
    },
    "ui.advanced.setting.EchoProbeDuration.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Amount of time to wait while testing if echo is on (seconds).\nThis is used by the password manager to ensure you're at a password prompt. Set to 0 to disable echo probe."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检测回显是否开启时的等待时间（秒）。\n密码管理器用它确认当前是否为密码提示符。设为 0 可禁用回显检测。"
          }
        }
      }
    },
    "ui.advanced.setting.DisablePasswordManagerAnimations.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disable animations for showing/hiding password manager."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "禁用显示或隐藏密码管理器的动画。"
          }
        }
      }
    },
    "ui.advanced.setting.NoSyncSilenceAnnoyingBellAutomatically.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatically silence bell when it rings too much."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "响铃过于频繁时自动静音。"
          }
        }
      }
    },
    "ui.advanced.setting.NoSyncVariablesToReport.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Variables to report via control sequence\nThis is a comma-delimited list of variables that can be reported with the OSC 1337 ReportVariable=name control sequence. Each variable name must be prefixed with “allow:” or “deny:”."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可通过控制序列报告的变量\n用逗号分隔可通过 OSC 1337 ReportVariable=name 控制序列报告的变量。每个变量名必须以“allow:”或“deny:”开头。"
          }
        }
      }
    },
    "ui.advanced.setting.RestoreWindowContents.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore window contents at startup.\nThis requires “System Settings > Desktop & Dock > Close windows when quitting an app” to be off."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启动时恢复窗口内容。\n需关闭“系统设置 > 桌面与程序坞 > 退出应用程序时关闭窗口”。"
          }
        }
      }
    },
    "ui.advanced.setting.NumberOfLinesForAccessibility.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Maximum number of lines of history to expose to Accessibility.\nAccessibility APIs can make iTerm2 slow. In order to limit the effect, you can restrict the number of lines in each session that are visible to accessibility. The last lines of each session will be made accessible."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "向辅助功能提供的最多历史行数。\n辅助功能 API 可能降低 iTerm2 的速度。可限制每个会话向辅助功能开放的行数，以减轻影响。开放的是每个会话最后的若干行。"
          }
        }
      }
    },
    "ui.advanced.setting.TriggerRadius.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Number of screen lines to match against trigger regular expressions.\nTrigger regular expressions are matched against the last logical line of text when a newline is received. A search is performed to find the start of the line. Since very long lines would cause performance problems, the search (and consequently the regular expression match, highlighting, and so on) is limited to this many screen lines."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "触发器正则表达式可匹配的屏幕行数。\n收到换行符时，会对最后一个逻辑文本行匹配触发器正则表达式。程序会搜索该行的起点。由于超长行可能影响性能，搜索及随后的正则匹配、高亮等操作被限制在此屏幕行数内。"
          }
        }
      }
    },
    "ui.advanced.setting.AllowIdempotentTriggers.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Evaluate idempotent triggers periodically in interactive apps, even when triggers in interactive apps are disabled."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在交互式应用中定期评估幂等触发器，即使已禁用交互式应用中的触发器。"
          }
        }
      }
    },
    "ui.advanced.setting.IdempotentTriggerModeRateLimit.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When evaluating idempotent triggers in interactive apps, wait this long (in seconds) between updates.\nThis limits the performance impact of trigger evaluation."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在交互式应用中评估幂等触发器时，两次更新之间的等待时间（秒）。\n用于限制触发器评估对性能的影响。"
          }
        }
      }
    },
    "ui.advanced.setting.RequireCmdForDraggingText.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To drag images or selected text, you must hold ⌘. This prevents accidental drags."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动图片或所选文本时必须按住 ⌘，以防止意外拖动。"
          }
        }
      }
    },
    "ui.advanced.setting.FocusReportingEnabled.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps may turn on Focus Reporting.\nFocus reporting causes iTerm2 to send an escape sequence when a session gains or loses focus. It can cause problems when an ssh session dies unexpectedly because it gets left on, so some users prefer to disable it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许应用开启焦点报告。\n焦点报告会在会话获得或失去焦点时让 iTerm2 发送转义序列。SSH 会话意外断开后该功能可能仍保持开启而引发问题，因此部分用户选择禁用。"
          }
        }
      }
    },
    "ui.advanced.setting.UseColorfgbgFallback.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use fallback for COLORFGBG if no exact match found?\nThe COLORFGBG variable indicates the ANSI colors that match the foreground and background colors. If no colors match and this setting is enabled, then the variable will be set to 15;0 to indicate a dark background or 0;15 to indicate a light background."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到精确匹配时，为 COLORFGBG 使用回退值？\nCOLORFGBG 变量表示与前景色和背景色匹配的 ANSI 颜色。若无匹配颜色且启用此项，深色背景会设为 15;0，浅色背景会设为 0;15。"
          }
        }
      }
    },
    "ui.advanced.setting.ZeroWidthSpaceAdvancesCursor.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Zero-Width Space (U+200B) advances cursor?\nWhile a zero-width space should not advance the cursor per the Unicode spec, both Terminal.app and Konsole do this, and Weechat depends on it. You must restart iTerm2 after changing this setting."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "零宽空格（U+200B）是否推进光标？\n按 Unicode 规范零宽空格不应推进光标，但 Terminal.app 和 Konsole 都会这样处理，Weechat 也依赖此行为。更改此设置后必须重新启动 iTerm2。"
          }
        }
      }
    },
    "ui.advanced.setting.StripZeroWidthFormatCharactersOnPaste.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Strip zero-width bidi/format characters when pasting?\nCharacters like the Zero-Width Non-Joiner (U+200C, the Persian half-space), ZWJ, LRM, and RLM are invisible but macOS classifies them as control characters, so line editors like zsh render them as a visible <200c> at the prompt. Turn this on to remove them from pasted text so the command line stays clean. Off by default because these characters are meaningful; enabling this changes the pasted text."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "粘贴时移除零宽双向或格式字符？\n零宽非连接符（U+200C，波斯语半空格）、ZWJ、LRM 和 RLM 等字符不可见，但 macOS 将其归类为控制字符，因而 zsh 等行编辑器会在提示符中将其显示为 <200c>。开启后可从粘贴文本中移除这些字符，保持命令行整洁。由于这些字符具有含义，默认关闭；启用会改变粘贴的文本。"
          }
        }
      }
    },
    "ui.advanced.setting.FullHeightCursor.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cursor occupies line spacing area.\nIf lines have more than 100% vertical spacing and this setting is enabled the bottom of the cursor will be aligned to the bottom of the spacing area."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "光标占据行间距区域。\n垂直行距超过 100% 且启用此项时，光标底部与行间距区域底部对齐。"
          }
        }
      }
    },
    "ui.advanced.setting.UnderlineCursorOffset.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Vertical offset for underline cursor.\nPositive values move it up, negative values move it down."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下划线光标的垂直偏移。\n正值向上移动，负值向下移动。"
          }
        }
      }
    },
    "ui.advanced.setting.PreventEscapeSequenceFromClearingHistory.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prevent CSI 3 J from clearing scrollback history?\nThis is also known as the terminfo E3 capability."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "阻止 CSI 3 J 清除回滚历史？\n此功能也称为 terminfo E3 能力。"
          }
        }
      }
    },
    "ui.advanced.setting.PreventEscapeSequenceFromChangingProfile.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prevent control sequences from changing the current profile?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "阻止控制序列更改当前配置文件？"
          }
        }
      }
    },
    "ui.advanced.setting.WarnAboutSecureKeyboardInputWithOpenCommand.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Warn if the `open` command appears to fail when secure keyboard input is enabled?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用安全键盘输入时，若 `open` 命令似乎失败，是否发出警告？"
          }
        }
      }
    },
    "ui.advanced.setting.MaxHistoryLinesToRestore.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Maximum number of lines of history to restore.\nWhen the app is relaunched, only the last N lines of history are restored to avoid making launch too slow. If you reduce this number, existing sessions won't be affected until their history is cleared."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复的最多历史行数。\n重新启动应用时，只恢复最后 N 行历史，以免启动过慢。减小此值不会影响现有会话，直到其历史被清除。"
          }
        }
      }
    },
    "ui.advanced.setting.VerticalBarCursorWidth.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Width of vertical bar cursor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "竖线光标的宽度。"
          }
        }
      }
    },
    "ui.advanced.setting.AcceptOSC7.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accept OSC 7 to set username, hostname, and path."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接受 OSC 7 设置用户名、主机名和路径。"
          }
        }
      }
    },
    "ui.advanced.setting.DetectPasswordInput.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show key at cursor at password prompt?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在密码提示符处的光标旁显示钥匙？"
          }
        }
      }
    },
    "ui.advanced.setting.DetectPasswordInputDebounce.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How long (seconds) terminal echo must remain disabled before iTerm2 treats it as a password prompt.\nThis prevents shell scripts that briefly turn off echo (e.g. while reading the response to an OSC report request) from triggering the password manager. Set to 0 to disable debouncing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "终端回显持续关闭多久（秒）后，iTerm2 才将其视为密码提示符。\n可防止短暂关闭回显的 Shell 脚本（例如读取 OSC 报告请求的响应时）触发密码管理器。设为 0 可禁用防抖。"
          }
        }
      }
    },
    "ui.advanced.setting.TabsWrapAround.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tabs wrap around to the next line.\nThis is useful for preserving tabs for later copying to the pasteboard. It breaks backward compatibility and may cause layout problems with programs that don’t expect this behavior."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "制表符允许折行到下一行。\n这有助于保留制表符以供随后复制到剪贴板，但会破坏向后兼容性，可能导致不预期此行为的程序布局异常。"
          }
        }
      }
    },
    "ui.advanced.setting.SshSchemePath.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Command to run when handling an ssh:// URL."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "处理 ssh:// URL 时运行的命令。"
          }
        }
      }
    },
    "ui.advanced.setting.DefaultTabStopWidth.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Default tab stop width for new sessions.\nNote: this will break drawing in emacs and other apps."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新会话的默认制表位宽度。\n注意：会破坏 emacs 和其他应用的绘制。"
          }
        }
      }
    },
    "ui.advanced.setting.ConvertItalicsToReverseVideoForTmux.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Convert italics to reverse video in tmux integration?\nThis is effective when the default TERM reported by tmux matches *screen*."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 tmux 集成中将斜体转换为反显？\n当 tmux 报告的默认 TERM 匹配 *screen* 时生效。"
          }
        }
      }
    },
    "ui.advanced.setting.ConvertItalicsToReverseVideoForTmuxBugwardsCompatible.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Convert italics to reverse video in tmux integration, even when TERM matches *tmux*?\nThis was the default behavior for a long time, but it was incorrect. The conversion should only be done when TERM matches *screen*."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "即使 TERM 匹配 *tmux*，也在 tmux 集成中将斜体转换为反显？\n这曾长期是默认行为，但并不正确。只有 TERM 匹配 *screen* 时才应转换。"
          }
        }
      }
    },
    "ui.advanced.setting.BellRateLimit.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Minimum time between beeping or flashing screen on bell, in seconds.\nIf the time interval between bells is less than this amount of time, it will be ignored."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "响铃发声或闪屏的最小间隔（秒）。\n两次响铃间隔短于此值时，将忽略后一次。"
          }
        }
      }
    },
    "ui.advanced.setting.TranslateScreenToXterm.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Support TERM=screen\nMost notably, this fixes italics replacing inverse text."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "支持 TERM=screen\n主要用于修复反显文本被显示成斜体的问题。"
          }
        }
      }
    },
    "ui.advanced.setting.ShouldSetTerminfoDirs.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set $TERMINFO_DIRS to add modern terminal features to xterm-like $TERMs?\niTerm2 ships with extended terminfo capabilities for common TERMs (xterm, xterm-new, and xterm-256color). For example, it enables undercurl. New sessions get created with a TERMINFO_DIRS that make the customized TERMINFOs take precedence over the system defaults."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置 $TERMINFO_DIRS，为类 xterm 的 $TERM 添加现代终端功能？\niTerm2 为常用 TERM（xterm、xterm-new 和 xterm-256color）附带扩展的 terminfo 能力，例如波浪下划线。新会话的 TERMINFO_DIRS 会让自定义 TERMINFO 优先于系统默认值。"
          }
        }
      }
    },
    "ui.advanced.setting.XtermVersion.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "xterm version for secondary device attributes (SDA).\nIncreasing this number enables more features in apps but may break things. Use 95 to recover pre-3.4.10 behavior."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "次级设备属性（SDA）报告的 xterm 版本。\n增大此值可启用应用中的更多功能，但也可能造成问题。设为 95 可恢复 3.4.10 之前的行为。"
          }
        }
      }
    },
    "ui.advanced.setting.P3.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use P3 as default color space? If No, sRGB will be used."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认使用 P3 色彩空间？设为“否”时使用 sRGB。"
          }
        }
      }
    },
    "ui.advanced.setting.FileDropCoprocess.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When files are dropped into a terminal window, execute a silent coprocess.\nThis is an interpolated string. Use \\(filenames) to reference the shell-quoted, space-delimited full paths to the dropped files. If this preference is empty, the filenames get pasted instead."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将文件拖入终端窗口时执行静默协进程。\n这是一个插值字符串。使用 \\(filenames) 引用拖入文件的完整路径；路径已进行 Shell 引用并以空格分隔。此项为空时会改为粘贴文件名。"
          }
        }
      }
    },
    "ui.advanced.setting.MaxURLLength.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Maximum length for OSC 8 URLs"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "OSC 8 URL 的最大长度"
          }
        }
      }
    },
    "ui.advanced.setting.DefaultWideMode.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When rendering natively, use wide mode by default?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原生渲染时默认使用宽字符模式？"
          }
        }
      }
    },
    "ui.advanced.setting.EnableSecureKeyboardEntryAutomatically.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatically enable secure keyboard entry at password prompts?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在密码提示符处自动启用安全键盘输入？"
          }
        }
      }
    },
    "ui.advanced.setting.BufferDepth.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Maximum number of chunks to buffer.\nIn general, these chunks are 1024 bytes. A larger value increases buffer bloat but—up to a limit—can improve performance in the fast path of ASCII text."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "缓冲的最大块数。\n这些块通常为 1024 字节。较大值会增加缓冲膨胀，但在一定范围内可提高 ASCII 文本快速路径的性能。"
          }
        }
      }
    },
    "ui.advanced.setting.HotkeyTermAnimationDuration.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Duration in seconds of the hotkey window animation.\nWarning: reducing this value may cause problems if you have multiple displays."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "热键窗口动画的时长（秒）。\n警告：使用多个显示器时，减小此值可能引发问题。"
          }
        }
      }
    },
    "ui.advanced.setting.OpenQuicklyAnimationDuration.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Duration in seconds of the Open Quickly window height animation.\nSet to 0 to disable the animation."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "快速打开窗口高度动画的时长（秒）。\n设为 0 可禁用动画。"
          }
        }
      }
    },
    "ui.advanced.setting.DockIconTogglesWindow.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If the only window is a hotkey window, then clicking the dock icon shows or hides it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有一个热键窗口时，点击程序坞图标会显示或隐藏该窗口。"
          }
        }
      }
    },
    "ui.advanced.setting.HotkeyWindowFloatsAboveOtherWindows.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The hotkey window floats above other windows even when another application is active.\nYou must disable “Settings > Keys > Hotkey window hides when focus is lost” for this setting to be effective."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "热键窗口悬浮在其他窗口上方，即使其他应用处于活动状态。\n必须禁用“设置 > 按键 > 热键窗口失去焦点时隐藏”才能生效。"
          }
        }
      }
    },
    "ui.advanced.setting.HotKeyDoubleTapMaxDelay.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The maximum amount of time allowed between presses of a modifier key when performing a modifier double-tap."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "双击修饰键时，两次按键允许的最大时间间隔。"
          }
        }
      }
    },
    "ui.advanced.setting.HotKeyDoubleTapMinDelay.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The minimum amount of time required between presses of a modifier key when performing a modifier double-tap."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "双击修饰键时，两次按键要求的最小时间间隔。"
          }
        }
      }
    },
    "ui.advanced.setting.ShowPinnedIndicator.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show indicator for pinned hotkey windows."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示固定热键窗口的指示器。"
          }
        }
      }
    },
    "ui.advanced.setting.SearchCommand.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Template for URL of search engine.\niTerm2 replaces the string “%@” with the text to search for. Query parameter percent escaping is used."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "搜索引擎 URL 模板。\niTerm2 会用搜索文本替换“%@”，并对查询参数进行百分号转义。"
          }
        }
      }
    },
    "ui.advanced.setting.SearchSuggestURL.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Template of URL for typeahead search suggestions.\niTerm replaces the string “%@” with the text to search for. Query parameter percent escaping is used."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入时搜索建议的 URL 模板。\niTerm 会用搜索文本替换“%@”，并对查询参数进行百分号转义。"
          }
        }
      }
    },
    "ui.advanced.setting.AutocompleteMaxOptions.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Number of autocomplete options to present.\nA value less than 100 is recommended."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示的自动补全选项数量。\n建议小于 100。"
          }
        }
      }
    },
    "ui.advanced.setting.MinRunningTime.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Grace period for automatic quitting after the last window is closed.\nIf iTerm2 is configured to quit automatically when the last window is closed, this setting gives a grace period (in seconds) after startup where that feature is disabled. Set to 0 to have no grace period."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭最后一个窗口后自动退出的宽限期。\n若 iTerm2 配置为关闭最后一个窗口后自动退出，此设置指定启动后禁用该功能的宽限时间（秒）。设为 0 表示无宽限期。"
          }
        }
      }
    },
    "ui.advanced.setting.UpdateScreenParamsDelay.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delay after changing number of screens/resolution until refresh (seconds).\nThis works around OS bugs where it takes some time after a screen change before it is safe to resize windows."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更改屏幕数量或分辨率后到刷新的延迟（秒）。\n用于规避系统问题：屏幕变化后需等待一段时间才能安全调整窗口大小。"
          }
        }
      }
    },
    "ui.advanced.setting.DisableAppNap.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disable App Nap.\nChange effective after restarting iTerm2."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "禁用 App Nap。\n重新启动 iTerm2 后生效。"
          }
        }
      }
    },
    "ui.advanced.setting.PreventSleepOnBatteryToo.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prevent system idle sleep on battery too, for profiles with “Prevent sleep” enabled?\nBy default the “Prevent sleep” profile setting only prevents idle sleep while connected to power. Enable this to also prevent idle sleep on battery."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已启用“阻止睡眠”的配置文件在电池供电时也阻止系统空闲睡眠？\n默认情况下，该配置文件设置只在接通电源时阻止空闲睡眠。启用此项可在电池供电时同样阻止。"
          }
        }
      }
    },
    "ui.advanced.setting.IdleTimeSeconds.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Time in seconds before a session is considered idle.\nUsed for updating icons and activity indicator in tabs."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会话被视为空闲前的等待时间（秒）。\n用于更新标签页中的图标和活动指示器。"
          }
        }
      }
    },
    "ui.advanced.setting.FindDelaySeconds.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Time to wait before performing Find action on 1- or 2- character queries."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "搜索 1 或 2 个字符时，执行查找前的等待时间。"
          }
        }
      }
    },
    "ui.advanced.setting.MaximumBytesToProvideToServices.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Maximum number of bytes of selection to provide to Services.\nA large value here can cause performance issues when you have a big selection."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "向“服务”提供的所选文本最大字节数。\n选区很大时，较大值可能导致性能问题。"
          }
        }
      }
    },
    "ui.advanced.setting.MaximumBytesToProvideToPythonAPI.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Maximum number of bytes of selection to provide to Python API.\nA large value here can cause performance issues when you have a big selection."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "向 Python API 提供的所选文本最大字节数。\n选区很大时，较大值可能导致性能问题。"
          }
        }
      }
    },
    "ui.advanced.setting.UseOpenDirectory.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Open Directory to determine the user shell"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 Open Directory 确定用户 Shell"
          }
        }
      }
    },
    "ui.advanced.setting.DisableDECRQCRA.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disable DECRQCRA?\nThis control sequence allows an app running in the terminal to read its contents."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "禁用 DECRQCRA？\n此控制序列允许终端内运行的应用读取终端内容。"
          }
        }
      }
    },
    "ui.advanced.setting.DisablePotentiallyInsecureEscapeSequences.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disable potentially insecure escape sequences.\nSome features of iTerm2 expand the surface area for security issues. Consider turning this on when viewing untrusted content. The following custom escape sequences will be disabled: RemoteHost, StealFocus, CurrentDir, SetProfile, CopyToClipboard, EndCopy, File, SetBackgroundImageFile, OSC 6’s proxy icon-changing feature. The following DEC sequences are disabled: DECRQCRA. The following xterm extensions are disabled: Window Title Reporting, Icon Title Reporting. This will break displaying inline images, file download, some shell integration features, and other features."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "禁用可能不安全的转义序列。\niTerm2 的某些功能会扩大安全风险面。查看不可信内容时，请考虑开启。将禁用以下自定义转义序列：RemoteHost、StealFocus、CurrentDir、SetProfile、CopyToClipboard、EndCopy、File、SetBackgroundImageFile，以及 OSC 6 的代理图标更改功能。禁用的 DEC 序列：DECRQCRA。禁用的 xterm 扩展：窗口标题报告、图标标题报告。这会使内联图片显示、文件下载、部分 Shell 集成及其他功能失效。"
          }
        }
      }
    },
    "ui.advanced.setting.PerformDictionaryLookupOnQuickLook.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Perform dictionary lookups on force press.\nIf this is NO, force press will still preview the Semantic History action; only dictionary lookups can be disabled."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用力按压时执行词典查询。\n设为“否”时，用力按压仍会预览语义历史操作；只能禁用词典查询。"
          }
        }
      }
    },
    "ui.advanced.setting.WebUserAgent.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "User agent for web views. Leave empty to use system default."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网页视图的 User-Agent。留空使用系统默认值。"
          }
        }
      }
    },
    "ui.advanced.setting.JiggleTTYSizeOnClearBuffer.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Redraw the screen after the Clear Buffer menu item is selected.\nWhen enabled, the TTY size is briefly changed after clearing the buffer to cause the shell or current app to redraw."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择“清除缓冲区”菜单项后重绘屏幕。\n启用后，清除缓冲区后会短暂改变 TTY 大小，以促使 Shell 或当前应用重绘。"
          }
        }
      }
    },
    "ui.advanced.setting.SaveScrollBufferWhenClearing.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save scroll buffer when clearing screen.\nWhen enabled, saves the current screen into scroll back buffer instead of clearing it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清屏时保存滚动缓冲区。\n启用后，将当前屏幕保存到回滚缓冲区，而不是清除。"
          }
        }
      }
    },
    "ui.advanced.setting.SaveScrollbackWhenCursorMovesAbovePrompt.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save the screen to scrollback when an app moves the cursor above the prompt.\nSome full-screen programs that don’t use the alternate screen buffer repaint by moving the cursor to the top of the screen and overwriting whatever was already there, destroying content you can still see. When enabled, iTerm2 first scrolls the visible screen into history so that content isn’t lost. Requires shell integration."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用将光标移到提示符上方时，将屏幕保存到回滚历史。\n某些不使用备用屏幕缓冲区的全屏程序，会把光标移到屏幕顶部并覆盖已有内容来重绘，从而破坏仍可见的内容。启用后，iTerm2 会先将可见屏幕滚入历史以免内容丢失。需要 Shell 集成。"
          }
        }
      }
    },
    "ui.advanced.setting.IndicateBellsInDockBadgeLabel.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Indicate the number of bells rung while the app is inactive in the dock icon’s badge label"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在程序坞图标的徽标中显示应用未激活期间的响铃次数"
          }
        }
      }
    },
    "ui.advanced.setting.ShowSuiteNameInDockIcon.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Overlay the suite name on the dock icon when launched with -suite.\nWhen you run an isolated instance with the -suite argument, its name is drawn across the lower third of the dock icon so you can tell instances apart."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过 -suite 启动时，在程序坞图标上叠加 suite 名称。\n使用 -suite 参数运行隔离实例时，其名称会绘制在程序坞图标下方三分之一区域，便于区分实例。"
          }
        }
      }
    },
    "ui.advanced.setting.DownloadsDirectory.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloads folder.\nIf set, downloaded files go to this location instead of the user’s $HOME/Downloads folder."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载文件夹。\n设置后，下载文件存放到此处，而非用户的 $HOME/Downloads 文件夹。"
          }
        }
      }
    },
    "ui.advanced.setting.NoSyncSuppressDownloadConfirmation.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Suppress confirmation of terminal-initiated downloads?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不再确认由终端发起的下载？"
          }
        }
      }
    },
    "ui.advanced.setting.ViewManPageCommand.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Command to view man pages.\nUsed when you press the man page button on the touch bar. %@ is replaced with the command. End the command with & to avoid opening an iTerm2 window (e.g., if you're launching an external viewer)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看 man 手册页的命令。\n按下触控栏上的手册页按钮时使用。%@ 会被替换为命令。命令末尾添加 & 可避免打开 iTerm2 窗口（例如启动外部查看器时）。"
          }
        }
      }
    },
    "ui.advanced.setting.HideStuckTooltips.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hide stuck tooltips.\nWhen you hide iTerm2 using a hotkey while a tooltip is fading out it gets stuck because of an OS bug. Work around it with a nasty hack by enabling this feature."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "隐藏卡住的工具提示。\n工具提示淡出时用热键隐藏 iTerm2，系统问题会使提示卡住。启用此功能可用一种变通方式规避。"
          }
        }
      }
    },
    "ui.advanced.setting.OpenFileOverridesSendText.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Should opening a script with iTerm2 disable the default profile's “Send Text at Start” setting?\nIf you use “open iTerm2 file.command” or drag a script onto iTerm2's icon and this setting is enabled then the script will be executed in lieu of the profile's “Send Text at Start” setting. If this setting is off then both will be executed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 iTerm2 打开脚本时，禁用默认配置文件的“启动时发送文本”？\n启用此项后，使用“open iTerm2 file.command”或将脚本拖到 iTerm2 图标上时，只执行脚本，不执行“启动时发送文本”。关闭时会执行两者。"
          }
        }
      }
    },
    "ui.advanced.setting.StatusBarIcon.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add status bar icon when excluded from dock?\nWhen you turn on “Exclude from Dock and ⌘-Tab Application Switcher” a status bar icon is added to the menu bar so you can switch the setting back off. Disable this to remove the status bar icon. Doing so makes it very hard to get to Settings. You must restart iTerm2 after changing this setting."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从程序坞隐藏时添加菜单栏图标？\n开启“从程序坞和 ⌘-Tab 应用切换器中隐藏”后，会添加菜单栏图标以便关闭该设置。禁用此项可移除图标，但之后将很难进入设置。更改后必须重新启动 iTerm2。"
          }
        }
      }
    },
    "ui.advanced.setting.StatusBarHeight.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Height of the status bar in points.\nThis will also affect the height of per-pane title bars becuase the status bar may be embedded in it. You must restart iTerm2 after changing this setting for it to take effect."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "状态栏高度（点）。\n由于状态栏可能嵌入窗格标题栏，这也影响各窗格标题栏的高度。更改此设置后必须重新启动 iTerm2 才能生效。"
          }
        }
      }
    },
    "ui.advanced.setting.WrapFocus.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Should split pane navigation by direction wrap around?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按方向切换分割窗格时循环切换？"
          }
        }
      }
    },
    "ui.advanced.setting.OpenUntitledFile.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open a new window when you click the dock icon and no windows are already open, and also on app launch when no other windows are open?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有已打开窗口时，点击程序坞图标或启动应用是否打开新窗口？"
          }
        }
      }
    },
    "ui.advanced.setting.OpenNewWindowAtStartup.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open a window at startup?\nThis is useful if you wish to use the system window restoration settings but not create a new window if none would be restored."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启动时打开窗口？\n如果希望使用系统窗口恢复设置，但没有可恢复的窗口时不创建新窗口，可使用此项。"
          }
        }
      }
    },
    "ui.advanced.setting.TimeToWaitForEmojiPanel.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How long to wait for the emoji panel to open in seconds?\nFloating hotkey windows adjust their level when the emoji panel is open. If it’s really slow you might need to increase this value to prevent it from appearing beneath a floating hotkey window."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "等待表情符号面板打开的时长（秒）。\n表情符号面板打开时，悬浮热键窗口会调整层级。面板打开很慢时，可能需增大此值，以免它出现在悬浮热键窗口下方。"
          }
        }
      }
    },
    "ui.advanced.setting.TimeoutForStringEvaluation.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Timeout (seconds) for evaluating RPCs.\nThis applies to invoking functions registered by scripts when using the Swift syntax for inline expressions."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "执行 RPC 的超时时间（秒）。\n使用 Swift 语法的内联表达式调用脚本注册的函数时适用。"
          }
        }
      }
    },
    "ui.advanced.setting.PathToFTP.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Path to ftp for opening ftp: URLs.\nYou may want to set this to /usr/local/bin/ftp to use the Homebrew install."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于打开 ftp: URL 的 ftp 路径。\n可设为 /usr/local/bin/ftp 以使用 Homebrew 安装的版本。"
          }
        }
      }
    },
    "ui.advanced.setting.PathToTelnet.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Path to telnet for opening telnet: URLs.\nYou may want to set this to /usr/local/bin/telnet to use the Homebrew install."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于打开 telnet: URL 的 telnet 路径。\n可设为 /usr/local/bin/telnet 以使用 Homebrew 安装的版本。"
          }
        }
      }
    },
    "ui.advanced.setting.FallbackLCCType.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Value to set LC_CTYPE to if the machine‘s combination of country and language are not supported.\nIf unset, the encoding (e.g., UTF-8) will be used."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统的国家或地区与语言组合不受支持时，为 LC_CTYPE 设置的值。\n未设置时使用编码名称（如 UTF-8）。"
          }
        }
      }
    },
    "ui.advanced.setting.UseVirtualKeyCodesForDetectingDigits.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Treat the top row of keys like number keys on an English keyboard for the purposes of switching panes, tabs, and windows with modifier+number.\nFor example, AZERTY requires you to hold down Shift to enter a number. To switch tabs with ⌘+Number on an AZERTY keyboard, you must enable this setting. Then, for example, ⌘-& switches to tab 1. When this setting is enabled, some user-defined shortcuts may become unavailable because the tab/window/pane switching behavior takes precedence."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用“修饰键+数字”切换窗格、标签页和窗口时，将顶行按键视为英文键盘数字键。\n例如，AZERTY 键盘需按住 Shift 才能输入数字。在该键盘上使用 ⌘+数字切换标签页时，必须启用此设置；之后 ⌘-& 可切换到标签页 1。启用后，部分用户自定义快捷键可能不可用，因为标签页、窗口和窗格切换优先。"
          }
        }
      }
    },
    "ui.advanced.setting.HotkeyWindowsExcludedFromCycling.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hotkey windows are excluded from Cycle Through Windows."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "循环切换窗口时排除热键窗口。"
          }
        }
      }
    },
    "ui.advanced.setting.SwapFindNextPrevious.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swap Find Next and Find Previous.\nIf enabled, Find Next will search up and Find Previous will search down (iTerm2's traditional behavior, which is a departure from macOS's standard). When disabled, search behaves like a normal macOS app."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "交换“查找下一个”和“查找上一个”。\n启用后，“查找下一个”向上搜索，“查找上一个”向下搜索（这是 iTerm2 的传统行为，与 macOS 标准不同）。禁用后与普通 macOS 应用一致。"
          }
        }
      }
    },
    "ui.advanced.setting.PinEditSession.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pin Edit Session window to the session it originally edited.\nIf not set, it will affect the most recently active session."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将“编辑会话”窗口固定到最初编辑的会话。\n未设置时，会作用于最近活动的会话。"
          }
        }
      }
    },
    "ui.advanced.setting.RemapModifiersWithoutEventTap.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disable remapping modifiers for system shortcuts.\nThis prevents asking for accessibility permission. It breaks remapping system shortcuts like cmd-tab."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "禁用系统快捷键的修饰键重映射。\n这可避免请求辅助功能权限，但会使 cmd-tab 等系统快捷键的重映射失效。"
          }
        }
      }
    },
    "ui.advanced.setting.AlertsIndicateShortcuts.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Buttons in modal alerts indicate keyboard shortcuts.\nDo you miss Windows 95? I do."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在模态提示的按钮上显示键盘快捷键。\n怀念 Windows 95 吗？作者也一样。"
          }
        }
      }
    },
    "ui.advanced.setting.ShowHintsInSplitPaneMenuItems.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show hints in split pane menu items to indicate horizontal vs vertical semantics.\nYou must restart iTerm2 after changing this setting for it to take effect."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在分割窗格菜单项中提示水平与垂直方向的含义。\n更改此设置后必须重新启动 iTerm2 才能生效。"
          }
        }
      }
    },
    "ui.advanced.setting.UseOldStyleDropDownViews.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use old-style find and paste progress indicator views.\nThis change will only affect new windows."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用旧式查找视图和粘贴进度指示器。\n只影响新窗口。"
          }
        }
      }
    },
    "ui.advanced.setting.SynchronizeQueryWithFindPasteboard.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronize search queries across windows and applications.\nNormally, when you enter a search query in a Find field all find fields in all applications get updated to hold the same value. This is utter nonsense, and can be disabled by setting this preference to No."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在窗口和应用之间同步搜索内容。\n通常，在一个查找框中输入搜索内容后，所有应用的查找框都会更新为相同内容。若不希望如此，可将此设置设为“否”。"
          }
        }
      }
    },
    "ui.advanced.setting.DynamicProfilesPath.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Path to folder with dynamic profiles.\nWhen empty, ~/Library/Application Support/iTerm2/DynamicProfiles will be used. You must restart iTerm2 after modifying this setting."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "动态配置文件所在文件夹的路径。\n留空时使用 ~/Library/Application Support/iTerm2/DynamicProfiles。修改后必须重新启动 iTerm2。"
          }
        }
      }
    },
    "ui.advanced.setting.DynamicProfilesNotificationLatency.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delay between detecting a change to dynamic profiles and acting on it.\nIf a lot of changes happen to the DynamicProfiles folder a longer delay will help coalesce filesystem events to reduce CPU usage."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检测到动态配置文件变化后到处理的延迟。\nDynamicProfiles 文件夹频繁变化时，较长延迟有助于合并文件系统事件，减少 CPU 占用。"
          }
        }
      }
    },
    "ui.advanced.setting.AddDynamicTagToDynamicProfiles.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a 'Dynamic' tag to dynamic profiles.\nWhen enabled, dynamic profiles will have a 'Dynamic' tag added to them, which can be used to filter or identify them."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为动态配置文件添加“Dynamic”标签。\n启用后，动态配置文件会带有“Dynamic”标签，可用于筛选或识别。"
          }
        }
      }
    },
    "ui.advanced.setting.GitSearchPath.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "$PATH used when running git for the status bar component.\nChange this to use a custom install of git. You must restart iTerm2 for a change here to take effect."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "状态栏组件运行 git 时使用的 $PATH。\n可更改以使用自行安装的 git。更改后必须重新启动 iTerm2 才能生效。"
          }
        }
      }
    },
    "ui.advanced.setting.ScreenshotMaxPixelHeight.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Maximum pixel height for a single screenshot file.\nScreenshots taller than this will be split into multiple files. Also affects the maximum total pixels (this value squared / 5)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "单个截图文件的最大像素高度。\n超过此高度的截图会拆分为多个文件。也影响最大总像素数（此值的平方 / 5）。"
          }
        }
      }
    },
    "ui.advanced.setting.ScreenshotSaveLocation.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Folder where the “Save” button in the screenshot window writes files.\nLeave empty to save to the Desktop. The “Save As…” button ignores this and always prompts for a location."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "截图窗口的“存储”按钮写入文件的文件夹。\n留空则存储到桌面。“另存为…”忽略此设置，始终询问位置。"
          }
        }
      }
    },
    "ui.advanced.setting.GitTimeout.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Timeout in seconds when running git for the status bar component."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "状态栏组件运行 git 的超时时间（秒）。"
          }
        }
      }
    },
    "ui.advanced.setting.PreferredBaseDir.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Folder for config files. There must not be a space in the path.\nIf empty, then ~/.config/iterm2 will be the default location."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配置文件目录。路径中不能包含空格。\n留空时默认使用 ~/.config/iterm2。"
          }
        }
      }
    },
    "ui.advanced.setting.MaximumNumberOfTriggerCommands.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Maximum number of trigger-launched commands that can run at once.\nIf too many “Run Command…” triggers fire their commands will be queued. You must restart iTerm2 for changes to this setting to take effect."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可同时运行的触发器命令最大数量。\n过多“运行命令…”触发器触发时，其命令将排队。更改此设置后必须重新启动 iTerm2 才能生效。"
          }
        }
      }
    },
    "ui.advanced.setting.SmartSelectionRadius.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Maximum number of lines before and after the click location to include in smart selection."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "智能选择包含点击位置前后各最多多少行。"
          }
        }
      }
    },
    "ui.advanced.setting.WordSelectionRegexRadius.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Maximum number of characters before and after the click location to search when applying word selection regex patterns."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用单词选择正则表达式时，最多搜索点击位置前后各多少个字符。"
          }
        }
      }
    },
    "ui.advanced.setting.AlertTriggerRateLimit.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rate limit for Alert triggers.\nIf the same trigger fires with less than this time interval (in seconds) between firings, it will be suppressed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提示触发器的频率限制。\n同一触发器两次触发的间隔小于此值（秒）时，后一次会被抑制。"
          }
        }
      }
    },
    "ui.advanced.setting.UserNotificationTriggerRateLimit.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rate limit for Notification triggers.\nIf the same trigger fires with less than this time interval (in seconds) between firings, it will be suppressed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通知触发器的频率限制。\n同一触发器两次触发的间隔小于此值（秒）时，后一次会被抑制。"
          }
        }
      }
    },
    "ui.advanced.setting.SilentUserNotifications.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System notifications should be silent."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统通知保持静音。"
          }
        }
      }
    },
    "ui.advanced.setting.SimpleNotifications.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Omit session identifier from notifications.\nWhen enabled, notifications will only show the message without the session name and tab number prefix."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通知中省略会话标识。\n启用后只显示消息，不显示会话名称和标签页编号前缀。"
          }
        }
      }
    },
    "ui.advanced.setting.CommandHistoryUsePower.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When sorting command history for auto command completion: how much should number of uses of a command contribute to its score? A higher score moves the command closer to the top of the list.\nUse 0 to ignore number of uses."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为自动命令补全排序命令历史时，命令使用次数对评分的影响程度。分数越高，命令越靠近列表顶部。\n设为 0 可忽略使用次数。"
          }
        }
      }
    },
    "ui.advanced.setting.CommandHistoryAgePower.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When sorting command history for auto command completion: how much should the time-since-last-use of a command contribute to its score? A higher score moves the command closer to the top of the list.\nUse 0 to ignore time since last use."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为自动命令补全排序命令历史时，距上次使用的时间对评分的影响程度。分数越高，命令越靠近列表顶部。\n设为 0 可忽略距上次使用的时间。"
          }
        }
      }
    },
    "ui.advanced.setting.PerformSQLiteIntegrityCheck.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Perform restorable state integrity checks?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "执行可恢复状态的完整性检查？"
          }
        }
      }
    },
    "ui.advanced.setting.LastpassGroups.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Comma-separated list of LastPass groups for the password manager to look in for passwords."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "密码管理器查找密码的 LastPass 分组，以逗号分隔。"
          }
        }
      }
    },
    "ui.advanced.setting.OnePasswordAccount.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1Password account name.\nThis is used if you’ve enabled the 1Password integration in the password manager. Use `op account list` to get the list of accounts. This can be an account shorthand, sign-in address, account ID, or user ID."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1Password 账户名称。\n在密码管理器中启用 1Password 集成后使用。运行 `op account list` 可列出账户。可填账户简称、登录地址、账户 ID 或用户 ID。"
          }
        }
      }
    },
    "ui.advanced.setting.ExcludeUtunFromNetworkUtilization.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Exclude utun interfaces from network utilization?\nThis is useful if you use a VPN and only want to see the traffic that goes over Wi-Fi or Ethernet."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网络使用率统计排除 utun 接口？\n使用 VPN 且只想查看 Wi-Fi 或以太网流量时适用。"
          }
        }
      }
    },
    "ui.advanced.setting.NoSyncDownloadPrefsTimeout.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Timeout for downloading settings"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载设置的超时时间"
          }
        }
      }
    },
    "ui.advanced.setting.ShowButtonsForSelectedCommand.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show buttons at the top of a selected command?\nWhen you select a command by single clicking the command line or its output, buttons are shown on the top right with options like Copy and Share. Note that this setting only applies when marks are not “line style” such as when using Auto Composer."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在选中命令上方显示按钮？\n单击命令行或其输出选中命令时，右上角会显示复制和共享等按钮。仅在标记不是“线条样式”时生效，例如使用自动编辑器时。"
          }
        }
      }
    },
    "ui.advanced.setting.EnableZoomMenu.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow the standard system menu on window Zoom buttons to open?\nmacOS has a bug that makes the app hang. Since this is a rarely used menu, it is disabled by default."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许打开窗口缩放按钮的标准系统菜单？\nmacOS 的一个问题会使应用卡住。由于该菜单很少使用，默认禁用。"
          }
        }
      }
    },
    "ui.advanced.setting.BrowserBundleID.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bundle ID of browser to open URLs with.\nLeave empty to use system default."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于打开 URL 的浏览器 Bundle ID。\n留空使用系统默认浏览器。"
          }
        }
      }
    },
    "ui.advanced.setting.MenuTipDelay.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Time to wait before showing tips in the main menu.\nSet this to a big number if you don’t like the tips."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主菜单显示提示前的等待时间。\n不需要提示时可设为较大值。"
          }
        }
      }
    },
    "ui.advanced.setting.RevealExportedSettingsAndData.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reveal file created by “Export All Settings and Data” in finder upon completion"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“导出所有设置和数据”完成后，在 Finder 中显示生成的文件"
          }
        }
      }
    },
    "ui.advanced.setting.DryRunEraseAllSettingsAndData.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dry-run “Erase All Settings and Data”.\nWhen enabled, the Erase All Settings and Data button logs what it would delete (via NSLog) instead of actually deleting anything, and does not quit. Intended for testing the feature."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模拟执行“抹掉所有设置和数据”。\n启用后，该按钮只通过 NSLog 记录将要删除的内容，不实际删除，也不退出。用于测试该功能。"
          }
        }
      }
    },
    "ui.advanced.setting.ZippyTextDrawing.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use zippy text drawing algorithm?\nThis draws non-ASCII text more quickly but with lower fidelity. This setting is ignored if ligatures are enabled in Settings > Profiles > Text."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用快速文字绘制算法？\n可加快非 ASCII 文本绘制，但精度较低。在“设置 > 配置文件 > 文本”中启用连字时忽略此设置。"
          }
        }
      }
    },
    "ui.advanced.setting.LowFiCombiningMarks.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prefer speed to accuracy for characters with combining marks?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "绘制带组合标记的字符时，优先速度而非精度？"
          }
        }
      }
    },
    "ui.advanced.setting.UseAdaptiveFrameRate.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use adaptive framerate.\nWhen throughput is low, the screen will update at 60 frames per second. When throughput is higher, it will drop to a configurable rate (15 fps by default)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用自适应帧率。\n吞吐量较低时以每秒 60 帧更新；吞吐量较高时降至可配置帧率（默认 15 帧/秒）。"
          }
        }
      }
    },
    "ui.advanced.setting.DisableAdaptiveFrameRateInInteractiveApps.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disable adaptive framerate in interactive apps.\nTurn off adaptive frame rate while in alternate screen mode for more consistent refresh rate. This works even if alternate screen mode is disabled."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在交互式应用中禁用自适应帧率。\n备用屏幕模式下关闭自适应帧率，以保持刷新率更稳定。即使禁用了备用屏幕模式也有效。"
          }
        }
      }
    },
    "ui.advanced.setting.SlowFrameRate.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When adaptive framerate is enabled, refresh at this rate during high throughput conditions (FPS).\n Does not apply to Metal renderer."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用自适应帧率时，在高吞吐量下使用的刷新率（FPS）。\n 不适用于 Metal 渲染器。"
          }
        }
      }
    },
    "ui.advanced.setting.MetalSlowFrameRate.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When adaptive framerate is enabled and using the Metal renderer, refresh at this rate during high throughput conditions (FPS)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用自适应帧率且使用 Metal 渲染器时，高吞吐量下使用的刷新率（FPS）。"
          }
        }
      }
    },
    "ui.advanced.setting.ActiveUpdateCadence.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Maximum frame rate (FPS) when adaptive framerate is disabled.\nNote: this is doubled on ARM Macs for displays that support at least 120hz. Modifications to this setting will not affect existing sessions."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "禁用自适应帧率时的最大帧率（FPS）。\n注意：在 ARM Mac 上使用至少支持 120Hz 的显示器时，此值会加倍。修改不影响现有会话。"
          }
        }
      }
    },
    "ui.advanced.setting.AdaptiveFrameRateThroughputThreshold.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Throughput threshold for adaptive frame rate.\nIf more than this many bytes per second are received, use the lower frame rate of 30 fps."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自适应帧率的吞吐量阈值。\n每秒接收的字节数超过此值时，使用较低的 30 帧/秒。"
          }
        }
      }
    },
    "ui.advanced.setting.MaximumFrameRate.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Frame rate (FPS) when adaptive framerate is enabled and throughput is low but not 0."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用自适应帧率且吞吐量较低但不为 0 时的帧率（FPS）。"
          }
        }
      }
    },
    "ui.advanced.setting.LowPowerModeFrameRate.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Maximum frame rate (FPS) when low power mode is enabled."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用低电量模式时的最大帧率（FPS）。"
          }
        }
      }
    },
    "ui.advanced.setting.DwcLineCache.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable cache of double-width character locations?\nThis should improve performance. It is always on in nightly builds. You must restart iTerm2 for this setting to take effect."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "缓存双宽字符的位置？\n应可提高性能。每日构建版始终启用。必须重新启动 iTerm2 才能生效。"
          }
        }
      }
    },
    "ui.advanced.setting.UseGCDUpdateTimer.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use GCD-based update timer instead of NSTimer.\nThis should cause more regular screen updates. Restart iTerm2 after changing this setting."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用基于 GCD 的更新计时器代替 NSTimer。\n应使屏幕更新更规律。更改后请重新启动 iTerm2。"
          }
        }
      }
    },
    "ui.advanced.setting.DrawOutlineAroundCursor.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Draw outline around underline and vertical bar cursors using background color."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用背景色为下划线和竖线光标绘制轮廓。"
          }
        }
      }
    },
    "ui.advanced.setting.DisableCustomBoxDrawing.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use your typeface’s box-drawing characters instead of iTerm2’s custom drawing code.\nYou must restart iTerm2 after changing this setting."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用字体自带的制表线字符，代替 iTerm2 自定义绘制代码。\n更改后必须重新启动 iTerm2。"
          }
        }
      }
    },
    "ui.advanced.setting.MinimumWeightDifferenceForBoldFont.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Minimum weight difference between regular and bold font.\nThis affects selection of the bold version of a font. Font weights go from 0 to 9. If no font can be found that has a high enough weight then the regular font will be double-struck with a small offset."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "常规与粗体字体之间的最小字重差。\n影响粗体字体的选择。字重为 0 到 9。若找不到足够粗的字体，则以小幅偏移重复绘制常规字体。"
          }
        }
      }
    },
    "ui.advanced.setting.UnderlineCursorHeight.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Thickness of underline cursor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下划线光标的厚度。"
          }
        }
      }
    },
    "ui.advanced.setting.PreferSpeedToFullLigatureSupport.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Improves drawing performance at the expense of disallowing alphanumeric characters to belong to ligatures."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提高绘制性能，但不允许字母和数字字符参与连字。"
          }
        }
      }
    },
    "ui.advanced.setting.EnableContextualAlternates.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable contextual alternates (calt) for ligature-capable fonts.\nWhen enabled, uses ligature level 2 which activates calt in addition to standard ligatures. Many coding fonts such as Monaspace, Iosevka, and Cascadia Code require this for their ligatures to work."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为支持连字的字体启用上下文替代（calt）。\n启用后使用连字级别 2，在标准连字之外启用 calt。Monaspace、Iosevka 和 Cascadia Code 等编程字体需要此项才能正确显示连字。"
          }
        }
      }
    },
    "ui.advanced.setting.ForceAntialiasingOnRetina.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Force text to be anti-aliased on Retina displays.\nEnable this to use non-AA text on non-retina displays, which sometimes looks better."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Retina 显示器上强制对文字抗锯齿。\n启用后可在非 Retina 显示器上使用不抗锯齿的文字，有时效果更好。"
          }
        }
      }
    },
    "ui.advanced.setting.MakeSomePowerlineSymbolsWide.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Draw certain Powerline symbols double-width?\nThis matches how most “nerd” fonts render them, but your favorite one might not do this. An example code point that is affected is U+E0B8."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将某些 Powerline 符号绘制为双宽？\n这与多数 Nerd 字体的绘制方式一致，但您使用的字体未必如此。受影响的码位示例为 U+E0B8。"
          }
        }
      }
    },
    "ui.advanced.setting.UseLowPowerGPUWhenUnplugged.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Metal renderer uses integrated GPU when not connected to power?\nFor this to be effective you must disable “Disable Metal renderer when not connected to power”."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未连接电源时，Metal 渲染器使用集成 GPU？\n需禁用“未连接电源时禁用 Metal 渲染器”才能生效。"
          }
        }
      }
    },
    "ui.advanced.setting.UnderlineHyperlinks.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Underline OSC 8 hyperlinks"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为 OSC 8 超链接加下划线"
          }
        }
      }
    },
    "ui.advanced.setting.SolidUnderlines.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use solid underlines?\nWhen disabled, underlines break near text that would intersect them."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用实线下划线？\n禁用后，下划线会在与文字相交的位置附近断开。"
          }
        }
      }
    },
    "ui.advanced.setting.UseMultiPassUnderlineRenderer.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use multi-pass underline renderer?\nFixes underline gaps with ligature fonts. Requires restart."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用多遍下划线渲染器？\n修复连字字体的下划线间隙。需要重新启动。"
          }
        }
      }
    },
    "ui.advanced.setting.ShowMetalFPSmeter.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show FPS meter\nRequires Metal renderer"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示 FPS 计数器\n需要 Metal 渲染器"
          }
        }
      }
    },
    "ui.advanced.setting.MetalRedrawPeriod.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GPU renderer redraws at least this often, in seconds.\nThis is to work around a problem where the GPU renderer encounters a lot of latency when drawing for the first time after a short period of inactivity. Set this to a big number to render it ineffectual."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "GPU 渲染器至少每隔此时间（秒）重绘一次。\n用于规避 GPU 渲染器短暂空闲后首次绘制延迟较大的问题。设为较大值可使此功能基本不起作用。"
          }
        }
      }
    },
    "ui.advanced.setting.AnimateGraphStatusBarComponents.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Animate graph-based status bar components?\nTurn this off to reduce CPU/GPU usage in WindowServer."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为图表类状态栏组件启用动画？\n关闭可减少 WindowServer 的 CPU 和 GPU 占用。"
          }
        }
      }
    },
    "ui.advanced.setting.DisableTopRightIndicators.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disable indicator icons that appear in the top right of a session?\nThis includes the following indicators: maximized pane, broadcast input, coprocess running, alert on next mark, output suppression, zoom, copy mode, and debug logging."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "禁用会话右上角的指示图标？\n包括：窗格已最大化、广播输入、协进程运行中、下一个标记时提醒、输出抑制、缩放、复制模式和调试日志。"
          }
        }
      }
    },
    "ui.advanced.setting.NativeRenderingCSSLight.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Path to CSS file to customize native drawing (for light background colors)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于自定义原生绘制的 CSS 文件路径（浅色背景）。"
          }
        }
      }
    },
    "ui.advanced.setting.NativeRenderingCSSDark.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Path to CSS file to customize native drawing (for dark background colors)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于自定义原生绘制的 CSS 文件路径（深色背景）。"
          }
        }
      }
    },
    "ui.advanced.setting.SupportPowerlineExtendedSymbols.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Include extended symbols when drawing Powerline natively."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原生绘制 Powerline 时包含扩展符号。"
          }
        }
      }
    },
    "ui.advanced.setting.AlwaysUseLineStyleMarks.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Always use line-style marks?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "始终使用线条样式标记？"
          }
        }
      }
    },
    "ui.advanced.setting.AlphaForDeselectedCommandShade.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alpha value for shade that covers areas outside the currently selected command."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "覆盖当前选中命令以外区域的阴影不透明度。"
          }
        }
      }
    },
    "ui.advanced.setting.ShowURLPreviewForSemanticHistory.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show URL preview on cmd-hover for semantic history matches."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住 cmd 悬停在语义历史匹配项上时显示 URL 预览。"
          }
        }
      }
    },
    "ui.advanced.setting.CursorAnimationMinDistance.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When animated cursor movement is enabled, only perform animation if the cursor moves at least this distance in points."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用光标移动动画时，仅在光标移动距离达到此值（点）后播放动画。"
          }
        }
      }
    },
    "ui.advanced.setting.CursorSmearAnimationDuration.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Duration in seconds for the “Animate large movements” cursor animation."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“为大幅移动添加动画”光标动画的时长（秒）。"
          }
        }
      }
    },
    "ui.advanced.setting.CursorSlideAnimationDuration.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Duration in seconds for smooth cursor slide animation.\nThis affects the \"Smooth slide\" cursor movement option."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "光标平滑滑动动画的时长（秒）。\n影响“平滑滑动”光标移动选项。"
          }
        }
      }
    },
    "ui.advanced.setting.CursorSlideAnimationMaxCells.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Maximum horizontal distance in cells for smooth cursor slide animation.\nCursor movements larger than this will not animate."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "光标平滑滑动动画允许的最大水平距离（单元格）。\n超过此距离的光标移动不播放动画。"
          }
        }
      }
    },
    "ui.advanced.setting.IgnoreHardNewlinesInURLs.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ignore hard newlines for the purposes of locating URLs and file names for Semantic History.\nIf a hard newline occurs at the end of a line then ⌘-click will not see it all unless this setting is turned on. This is useful for some interactive applications. Turning this on will remove newlines from the \\3 and \\4 substitutions."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "语义历史定位 URL 和文件名时忽略硬换行。\n行尾存在硬换行时，除非启用此项，否则 ⌘-点击无法识别完整内容。适用于某些交互式应用。启用后会移除 \\3 和 \\4 替换值中的换行符。"
          }
        }
      }
    },
    "ui.advanced.setting.URLCharacterSet.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Non-alphanumeric characters considered part of a URL or file name for Semantic History.\nLetters and numbers are always considered part of the URL. These non-alphanumeric characters are used in addition for the purposes of figuring out where a URL begins and ends. You must restart iTerm2 for changes to this setting to take effect."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "语义历史将哪些非字母数字字符视为 URL 或文件名的一部分。\n字母和数字始终视为 URL 的一部分。这些额外字符用于确定 URL 的起止位置。更改后必须重新启动 iTerm2 才能生效。"
          }
        }
      }
    },
    "ui.advanced.setting.URLCharacterSetExclusions.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Characters never considered part of a URL.\nThe characters in this string may never occur in a URL; when one is seen that delineates the beginning or end of a URL."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "绝不视为 URL 一部分的字符。\n此字符串中的字符不能出现在 URL 中；遇到其中任一字符时，即视为 URL 的起点或终点。"
          }
        }
      }
    },
    "ui.advanced.setting.FilenameCharacterSet.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Non-alphanumeric characters considered part of a filename. Note that URL characters (a separate advanced setting) are also allowed.\nLetters and numbers are always considered part of the URL. These non-alphanumeric characters are used in addition for the purposes of figuring out where a file begins and ends. You must restart iTerm2 for changes to this setting to take effect."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "视为文件名一部分的非字母数字字符；另一个高级设置中允许的 URL 字符也同样允许。\n字母和数字始终视为 URL 的一部分。这些额外字符用于确定文件名的起止位置。更改后必须重新启动 iTerm2 才能生效。"
          }
        }
      }
    },
    "ui.advanced.setting.MaxSemanticHistoryPrefixOrSuffix.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Maximum number of bytes of text before and after click location to take into account.\nThis also limits the size of the \\3 and \\4 substitutions."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击位置前后纳入考虑的最多文本字节数。\n也限制 \\3 和 \\4 替换值的大小。"
          }
        }
      }
    },
    "ui.advanced.setting.PathsToIgnore.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paths to ignore for Semantic History.\nSeparate paths with a comma. Any file under one of these paths will not be openable with Semantic History. It is wise to add network file systems to this list, since they can be very slow."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "语义历史忽略的路径。\n用逗号分隔。位于这些路径下的文件无法通过语义历史打开。建议加入网络文件系统，因为它们可能很慢。"
          }
        }
      }
    },
    "ui.advanced.setting.ShowYellowMarkForJobStoppedBySignal.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a yellow for a Shell Integration prompt mark when the job is stopped by a signal."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任务被信号停止时，将 Shell 集成的提示符标记显示为黄色。"
          }
        }
      }
    },
    "ui.advanced.setting.ConservativeURLGuessing.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "URLs must contain a scheme?\nEnable this to reduce the number of false positives that semantic history thinks are a URL"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "URL 必须包含协议方案？\n启用可减少语义历史将非 URL 误判为 URL 的情况"
          }
        }
      }
    },
    "ui.advanced.setting.RequireSlashInURLGuess.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only consider a two+ part domain-name to be a URL if it also contains a slash.\nThis setting is used when guessing if a string is a URL for semantic history. When enabled, `example.com` would not be considered a URL but `example.com/` would be."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅当由两个或更多部分组成的域名还包含斜杠时，才将其视为 URL。\n语义历史猜测字符串是否为 URL 时使用。启用后，`example.com` 不被视为 URL，而 `example.com/` 会被视为 URL。"
          }
        }
      }
    },
    "ui.advanced.setting.TrailingPunctuationMarks.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Characters to ignore at the end of a URL"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "URL 末尾忽略的字符"
          }
        }
      }
    },
    "ui.advanced.setting.DefaultURLScheme.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Default URL scheme.\nThis is applied to hostnames that are not a single word."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认 URL 协议方案。\n用于不止一个单词的主机名。"
          }
        }
      }
    },
    "ui.advanced.setting.UrlHandlerCommand.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Command to run when opening a clicked URL, instead of asking the OS to open it.\nWhen non-empty, this command runs as a silent background task via /bin/sh -c whenever you click a URL (including OSC 8 hyperlinks and auto-detected URLs) that iTerm2 would otherwise hand to the system. This is an interpolated string; use \\(url) for the URL and \\(background) for whether a background open was requested (1 if you held option while clicking, otherwise 0). The command is responsible for opening the URL however it likes (e.g., “open -g \\(url)” to open in the background). When empty, URLs open normally. iTerm2-internal schemes (iterm2:), URL schemes bound to a profile, and Semantic History file links are not affected."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击 URL 时运行此命令，而不交给操作系统打开。\n非空时，每次点击本应交给系统的 URL（包括 OSC 8 超链接和自动识别的 URL），都会通过 /bin/sh -c 以静默后台任务运行此命令。这是插值字符串：用 \\(url) 表示 URL，用 \\(background) 表示是否请求后台打开（点击时按住 Option 为 1，否则为 0）。命令需自行负责打开 URL，例如用“open -g \\(url)”在后台打开。留空时正常打开 URL。不影响 iTerm2 内部协议方案（iterm2:）、绑定配置文件的 URL 协议方案或语义历史文件链接。"
          }
        }
      }
    },
    "ui.advanced.setting.RestrictSemanticHistoryPrefixAndSuffixToLogicalWindow.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Respect soft boundaries for computing the prefix and suffix text passed to semantic history commands?\nDue to a long-standing bug this did not used to be respected. Soft boundaries were always respected for deciding what text was clicked on, but the prefix and suffix did not. If you have a semantic history command that depends on the bug, you can switch this off to get the pre-3.1.2 behavior."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "计算传给语义历史命令的前缀和后缀文本时，遵守软边界？\n由于长期存在的问题，过去未遵守此规则。判断点击文本时始终遵守软边界，但前缀和后缀没有。若语义历史命令依赖此问题，可关闭以恢复 3.1.2 之前的行为。"
          }
        }
      }
    },
    "ui.advanced.setting.EnableSemanticHistoryOnNetworkMounts.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable semantic history for network-mounted filesystems?\nOnly enable this if you know your network-mounted filesystems are really fast and reliable. A slow filesystem may cause the entire iTerm2 app to hang."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为网络挂载的文件系统启用语义历史？\n只有确定网络文件系统快速且可靠时才启用。缓慢的文件系统可能导致整个 iTerm2 卡住。"
          }
        }
      }
    },
    "ui.advanced.setting.PrioritizeSmartSelectionActions.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check smart selection actions before existing files on cmd-click?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住 cmd 点击时，先检查智能选择操作，再检查现有文件？"
          }
        }
      }
    },
    "ui.advanced.setting.DisableSmartSelectionActionsOnClick.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disable performing the first matching Smart Selection’s Action on cmd-click?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "禁用按住 cmd 点击时执行首个匹配的智能选择操作？"
          }
        }
      }
    },
    "ui.advanced.setting.StartDebugLoggingAutomatically.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start debug logging automatically when iTerm2 is launched."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启动 iTerm2 时自动开始记录调试日志。"
          }
        }
      }
    },
    "ui.advanced.setting.AppendToExistingDebugLog.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Append to existing debug log rather than replacing it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "追加到现有调试日志，而不是替换。"
          }
        }
      }
    },
    "ui.advanced.setting.LogDrawingPerformance.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Log stats about text drawing performance to console.\nUsed for performance testing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将文字绘制性能统计记录到控制台。\n用于性能测试。"
          }
        }
      }
    },
    "ui.advanced.setting.ShowDirtyRectsInLegacyRenderer.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Outline dirty rects in the legacy renderer with random colors.\nUseful for visually verifying which regions of the text view are being repainted each frame. This affects only the legacy (non-GPU) renderer and does nothing when the GPU (Metal) renderer is active, so it is not a way to tell whether the GPU renderer is engaged. To use it, first turn off the GPU renderer in Settings → General → Magic."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在传统渲染器中用随机颜色勾勒待重绘矩形区域。\n便于直观检查每帧重绘了文本视图的哪些区域。仅影响传统（非 GPU）渲染器；GPU（Metal）渲染器启用时无效，因此不能用它判断 GPU 渲染器是否启用。使用前请在“设置 → 通用 → Magic”中关闭 GPU 渲染器。"
          }
        }
      }
    },
    "ui.advanced.setting.LogRestorableStateSize.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Log restorable state size info to /tmp/statesize.*.txt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将可恢复状态的大小信息记录到 /tmp/statesize.*.txt。"
          }
        }
      }
    },
    "ui.advanced.setting.ShowBlockBoundaries.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show line buffer block boundaries (issue 6207)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示行缓冲区的块边界（问题 6207）"
          }
        }
      }
    },
    "ui.advanced.setting.LogToSyslog.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Debug logs also write to the system log."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调试日志同时写入系统日志。"
          }
        }
      }
    },
    "ui.advanced.setting.LogForegroundJobAncestryDiagnostics.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Log a detailed trace when a session’s foreground-job ancestor list unexpectedly shrinks.\nWhen an intermediate ancestor (such as the claude CLI) drops out of a tracked session’s foreground-job ancestry for a single process-cache update, log via RLog which pid held the vanished ancestor, whether it is still in the process table, and the full upward walk from the deepest foreground job. Used to diagnose spurious job-ended events that can tear down a Claude Code workgroup. Off by default; turn on only while reproducing an issue."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会话的前台任务祖先进程列表意外缩短时，记录详细跟踪信息。\n若中间祖先进程（如 claude CLI）在单次进程缓存更新中从被跟踪会话的前台任务祖先链消失，会通过 RLog 记录该祖先的 PID、它是否仍在进程表中，以及从最深前台任务向上的完整遍历。用于诊断可能导致 Claude Code 工作组被拆除的误报任务结束事件。默认关闭，仅在复现问题时开启。"
          }
        }
      }
    },
    "ui.advanced.setting.FakeFullyQualifiedDomainName.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Override the local hostname used for localhost detection.\nWhen non-empty, the app behaves as though [NSHost fullyQualifiedDomainName] returns this value. Lets you test how localhost detection reacts to a hostname change without actually renaming your computer. Affects hosts reported after you change it; leave empty to use the real hostname."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "覆盖用于识别本地主机的主机名。\n非空时，应用会按 [NSHost fullyQualifiedDomainName] 返回此值来处理。可测试主机名变化对本地主机检测的影响，而不实际重命名电脑。影响更改后报告的主机。留空使用真实主机名。"
          }
        }
      }
    },
    "ui.advanced.setting.AiChatVerboseConsoleLogging.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Log AI chat traffic to the system console.\nEmits per-turn user / agent / tool entries via NSFuckingLog so you can trace exactly what the agent received and produced. Useful for debugging tool dispatch and history translation. Off by default; turn on only while reproducing an issue."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将 AI 聊天流量记录到系统控制台。\n通过 NSFuckingLog 输出每轮的用户、智能体和工具条目，便于准确跟踪智能体收到和生成的内容。用于调试工具分发和历史转换。默认关闭，仅在复现问题时开启。"
          }
        }
      }
    },
    "ui.advanced.setting.AiChatRawWireLogging.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Log raw AI API requests and responses to disk.\nWrites every byte sent to and received from the AI vendor (full request headers, body, streaming chunks, final response, errors, and timing) to ~/Library/Application Support/iTerm2/AIChatWire/. One log file per app launch; rotate or delete it yourself when done. WARNING: the log captures Authorization / API-key headers and full prompt + response content verbatim. Off by default; turn on only while reproducing an issue and delete the files when finished."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将原始 AI API 请求和响应记录到磁盘。\n把与 AI 服务商之间收发的每个字节（完整请求头、正文、流式片段、最终响应、错误和耗时）写入 ~/Library/Application Support/iTerm2/AIChatWire/。每次启动应用生成一个日志文件，完成后请自行轮换或删除。警告：日志会原样记录 Authorization / API-key 请求头及完整提示词和响应内容。默认关闭，仅在复现问题时开启，结束后删除文件。"
          }
        }
      }
    },
    "ui.advanced.setting.LogAITabTitleCorpus.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Log AI tab-title generations to a corpus file.\nWhen the AI tab-title component runs the on-device model, append the inputs (foreground job, command line, directory, host, and visible screen), the system prompt used, the model, the generated title, and timing as one JSON line to ~/Library/Application Support/iTerm2/AITabTitleCorpus/corpus.jsonl. Builds a replayable corpus for grading prompts and models offline (see the corpus grader in the AI live harness). WARNING: captures full screen contents verbatim. Off by default; turn on only while collecting data and delete the file when finished."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将 AI 标签页标题生成记录到语料文件。\nAI 标签页标题组件运行端侧模型时，将输入（前台任务、命令行、目录、主机和可见屏幕）、所用系统提示词、模型、生成的标题及耗时作为一行 JSON 追加到 ~/Library/Application Support/iTerm2/AITabTitleCorpus/corpus.jsonl。用于建立可回放语料，离线评估提示词和模型（见 AI 实时测试工具中的语料评分器）。警告：会原样记录完整屏幕内容。默认关闭，仅在收集数据时开启，结束后删除文件。"
          }
        }
      }
    },
    "ui.advanced.setting.AlternateSSHIntegrationScript.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alternate SSH integration python script"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "替代的 SSH 集成 Python 脚本"
          }
        }
      }
    },
    "ui.advanced.setting.RunJobsInServers.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable session restoration.\nSession restoration runs jobs in separate processes. They will survive crashes, force quits, and upgrades.\nYou must restart iTerm2 for this change to take effect."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用会话恢复。\n会话恢复在独立进程中运行任务，使其在崩溃、强制退出和升级后仍可继续。\n必须重新启动 iTerm2 才能生效。"
          }
        }
      }
    },
    "ui.advanced.setting.BootstrapDaemon.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow sessions to survive logging out and back in.\nThis breaks the “auth sufficient pam_tid.so” hack some people use to allow sudo to authenticate with Touch ID."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许会话在注销并重新登录后继续存在。\n这会使某些用户用于让 sudo 通过 Touch ID 认证的“auth sufficient pam_tid.so”变通配置失效。"
          }
        }
      }
    },
    "ui.advanced.setting.KillJobsInServersOnQuit.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "User-initiated Quit (⌘Q) of iTerm2 will kill all running jobs.\nApplies only when session restoration is on."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用户主动退出（⌘Q）iTerm2 时终止所有运行中的任务。\n仅在启用会话恢复时适用。"
          }
        }
      }
    },
    "ui.advanced.setting.SuppressRestartAnnouncement.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Suppress the Restart Session offer.\nWhen a session terminates, it will offer to restart itself. Turn this on to suppress the offer permanently."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不显示重新启动会话的提示。\n会话终止后通常会提示可重新启动。开启后永久隐藏此提示。"
          }
        }
      }
    },
    "ui.advanced.setting.ShowSessionRestoredBanner.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When restoring a session without restoring a running job, draw a banner saying “Session Contents Restored” below the restored contents."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复会话但未恢复运行中的任务时，在恢复内容下方显示“会话内容已恢复”横幅。"
          }
        }
      }
    },
    "ui.advanced.setting.AutologAppends.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic session logging appends to existing files.\nWhen set to No, the file will be overwritten instead."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动会话日志追加到现有文件。\n设为“否”时改为覆盖文件。"
          }
        }
      }
    },
    "ui.advanced.setting.LogTimestampFormat.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Format for log timestamps. See Unicode TR 35-31 for syntax.\nYou must restart iTerm2 for changes to this setting to take effect."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "日志时间戳格式。语法请参阅 Unicode TR 35-31。\n更改后必须重新启动 iTerm2 才能生效。"
          }
        }
      }
    },
    "ui.advanced.setting.FocusNewSplitPaneWithFocusFollowsMouse.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When focus follows mouse is enabled, should new split panes automatically be focused?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用焦点跟随鼠标时，自动聚焦新分割的窗格？"
          }
        }
      }
    },
    "ui.advanced.setting.NoSyncSuppressRestartSessionConfirmationAlert.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Suppress restart session confirmation alert.\nDon't ask for a confirmation when manually restarting a session."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不显示重新启动会话的确认提示。\n手动重新启动会话时不再要求确认。"
          }
        }
      }
    },
    "ui.advanced.setting.ShowAutomaticProfileSwitchingBanner.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show a “Switched to profile” message when Automatic Profile Switching activates."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动切换配置文件生效时，显示“已切换到配置文件”消息。"
          }
        }
      }
    },
    "ui.advanced.setting.PreserveFontSizeOnAutomaticProfileSwitch.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preserve font zoom level when Automatic Profile Switching changes profiles."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动切换配置文件时保留字体缩放级别。"
          }
        }
      }
    },
    "ui.advanced.setting.AutoLockSessionNameOnEdit.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto-lock session name after editing it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "编辑会话名称后自动锁定名称。"
          }
        }
      }
    },
    "ui.advanced.setting.AiGeneratedTabTitles.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Name tabs after the work on screen, using on-device AI?\nWhen enabled, the session variable “aiTitle” holds a short name for the task visible in the session, which you can show by adding the “AI-generated name” title component or using \\(session.aiTitle) in a custom title format. Requires Apple Intelligence; the screen contents never leave this Mac, and no API key is used."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用端侧 AI，根据屏幕上的工作为标签页命名？\n启用后，会话变量“aiTitle”保存当前会话可见任务的简短名称。可添加“AI 生成的名称”标题组件，或在自定义标题格式中使用 \\(session.aiTitle) 显示。需要 Apple Intelligence；屏幕内容不会离开此 Mac，也不使用 API 密钥。"
          }
        }
      }
    },
    "ui.advanced.setting.TimeoutForDaemonAttachment.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How long to wait when trying to attach to an iTerm daemon at startup when restoring windows (in seconds)?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启动并恢复窗口时，尝试连接 iTerm 守护进程的等待时间（秒）？"
          }
        }
      }
    },
    "ui.advanced.setting.LogTimestampsWithPlainText.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When logging plain text, include timestamps for each line?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记录纯文本日志时，为每行添加时间戳？"
          }
        }
      }
    },
    "ui.advanced.setting.ComposerClearSequence.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hex codes to send to clear the command line when entering the composer.\n0x15 is ^U, 0x0b is ^K."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "进入编辑器时，为清除命令行而发送的十六进制代码。\n0x15 为 ^U，0x0b 为 ^K。"
          }
        }
      }
    },
    "ui.advanced.setting.AlwaysUseStatusBarComposer.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Temporarily add a composer to the status bar instead of opening the large composer view when a status bar is present."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有状态栏时，临时将编辑器添加到状态栏，而不打开大型编辑器视图。"
          }
        }
      }
    },
    "ui.advanced.setting.SuccessSound.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When Alert on Next Mark is configured to play a sound, use a file with this name for successful completion of the previous command.\nYou can name a system sound or a file in ~/Library/Sounds."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“下一个标记时提醒”配置为播放声音时，上一条命令成功完成所用的声音文件名。\n可指定系统声音或 ~/Library/Sounds 中的文件。"
          }
        }
      }
    },
    "ui.advanced.setting.ErrorSound.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When Alert on Next Mark is configured to play a sound, use a file with this name for erroneous completion of the previous command.\nYou can name a system sound or a file in ~/Library/Sounds."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“下一个标记时提醒”配置为播放声音时，上一条命令出错结束所用的声音文件名。\n可指定系统声音或 ~/Library/Sounds 中的文件。"
          }
        }
      }
    },
    "ui.advanced.setting.SessionEndMessageText.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Text displayed when a session ends. Leave empty to use default."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会话结束时显示的文本。留空使用默认值。"
          }
        }
      }
    },
    "ui.advanced.setting.SessionEndMessageDividerCharacter.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Character to use for divider lines in session end messages. Leave empty to use secure default (BrokenPipeDivider image). Examples: ━ ─ ═ ╌ ┄"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会话结束消息中分隔线使用的字符。留空使用安全默认值（BrokenPipeDivider 图片）。示例：━ ─ ═ ╌ ┄"
          }
        }
      }
    },
    "ui.advanced.setting.SessionRestartedMessageText.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Text displayed when a session is restarted."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会话重新启动时显示的文本。"
          }
        }
      }
    },
    "ui.advanced.setting.SessionFinishedMessageText.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Text displayed when a short-lived session finishes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "短时会话完成时显示的文本。"
          }
        }
      }
    },
    "ui.advanced.setting.OpenFileInNewWindows.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "DEPRECATED: Use “How should new instances be opened” instead.\nOpen files in new windows, not new tabs or split panes.\nThis affects shell scripts opened from Finder, for example. See also “Open files in split panes”."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已废弃：请改用“应如何打开新实例”。\n在新窗口中打开文件，而不是新标签页或分割窗格。\n例如会影响从 Finder 打开的 Shell 脚本。另请参阅“在分割窗格中打开文件”。"
          }
        }
      }
    },
    "ui.advanced.setting.OpenFileInSplitPanes.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "DEPRECATED: Use “How should new instances be opened” instead.\nOpen files in split panes.\nThis affects shell scripts opened from Finder, for example. You must set “Open files in new windows, not new tabs” to “No” for this to take effect. See also “When opening a file in a split pane, should it be a vertical split?”"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已废弃：请改用“应如何打开新实例”。\n在分割窗格中打开文件。\n例如会影响从 Finder 打开的 Shell 脚本。必须将“在新窗口而非新标签页中打开文件”设为“否”才能生效。另请参阅“在分割窗格中打开文件时，是否垂直分割？”"
          }
        }
      }
    },
    "ui.advanced.setting.OpenFileInVerticalSplitPane.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "DEPRECATED: Use “How should new instances be opened” instead.\nWhen opening a file in a split pane, should it be a vertical split?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已废弃：请改用“应如何打开新实例”。\n在分割窗格中打开文件时，是否垂直分割？"
          }
        }
      }
    },
    "ui.advanced.setting.NewInstanceOpenStyle.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How should new instances be opened when triggered by scripts or external applications?\n-1: Use legacy settings (default)\n0: New Window\n1: New Tab\n2: Vertical Split Pane\n3: Horizontal Split Pane\nThis provides a unified setting for controlling external instance creation."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "脚本或外部应用触发新实例时，应如何打开？\n-1：使用旧设置（默认）\n0：新窗口\n1：新标签页\n2：垂直分割窗格\n3：水平分割窗格\n提供统一设置以控制外部实例的创建方式。"
          }
        }
      }
    },
    "ui.advanced.setting.DisableWindowSizeSnap.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminal windows resize smoothly.\nDisables snapping to character grid. Holding Control will temporarily disable snap-to-grid."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "平滑调整终端窗口大小。\n禁用对齐字符网格。按住 Control 可临时禁用网格对齐。"
          }
        }
      }
    },
    "ui.advanced.setting.ProfilesWindowJoinsActiveSpace.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If the Profiles window is open, it always moves to join the active Space.\nYou must restart iTerm2 for a change in this setting to take effect."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配置文件窗口打开时，始终移动到当前空间。\n更改后必须重新启动 iTerm2 才能生效。"
          }
        }
      }
    },
    "ui.advanced.setting.DarkThemeHasBlackTitlebar.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dark themes give terminal windows black title bars by default."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "深色主题默认给终端窗口使用黑色标题栏。"
          }
        }
      }
    },
    "ui.advanced.setting.FontChangeAffectsBroadcastingSessions.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Should growing or shrinking the font in a session that's broadcasting input affect all session that broadcast input?\nThis only applies to changing the font size with Make Text Bigger, Make Text Normal Size, and Make Text Smaller"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在广播输入会话中增大或缩小字体时，影响所有广播输入会话？\n仅适用于“放大文本”“恢复正常文本大小”和“缩小文本”操作"
          }
        }
      }
    },
    "ui.advanced.setting.SerializeOpeningMultipleFullScreenWindows.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When opening multiple fullscreen windows, enter fullscreen one window at a time."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开多个全屏窗口时，逐个进入全屏。"
          }
        }
      }
    },
    "ui.advanced.setting.TrackingRunloopForLiveResize.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a tracking runloop for live resizing.\nThis allows the terminal to redraw during a resizing drag."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "实时调整窗口大小时使用跟踪运行循环。\n允许终端在拖动调整大小期间重绘。"
          }
        }
      }
    },
    "ui.advanced.setting.DisableWindowShadowWhenTransparencyOnMojave.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disable the window shadow on Mojave when the window has a transparent session to improve performance."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Mojave 中，窗口包含透明会话时禁用窗口阴影，以提高性能。"
          }
        }
      }
    },
    "ui.advanced.setting.DisableWindowShadowWhenTransparencyPreMojave.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disable the window shadow on High Sierra and earlier when the window has a transparent session to prevent text shadows."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 High Sierra 及更早版本中，窗口包含透明会话时禁用窗口阴影，以防止文字阴影。"
          }
        }
      }
    },
    "ui.advanced.setting.RestoreWindowsWithinScreens.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When restoring a window arrangement, ensure windows are entirely within the bounds of the current displays."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复窗口布局时，确保窗口完全位于当前显示器的边界内。"
          }
        }
      }
    },
    "ui.advanced.setting.ExtraSpaceBeforeCompactTopTabBar.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Amount of extra space (in points) between stoplight buttons and inline tab bar.\nThis only takes effect for the Compact and Minimal themes when the tab bar is visible and located at the top of the window."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "交通灯按钮与内嵌标签栏之间的额外间距（点）。\n仅在紧凑和精简主题中，标签栏可见且位于窗口顶部时生效。"
          }
        }
      }
    },
    "ui.advanced.setting.CompactTabBarStoplightButtonsWidth.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Width (in points) reserved for the window buttons (close/minimize/zoom) before the inline tab bar.\nThe default is 75. Reduce it to move tab content closer to the buttons, or increase it for more breathing room. This only takes effect for the Compact and Minimal themes when the tab bar is visible and located at the top of the window. Setting it smaller than the buttons themselves will let tabs overlap them."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内嵌标签栏之前为关闭、最小化和缩放按钮预留的宽度（点）。\n默认为 75。减小可让标签页内容靠近按钮，增大可留出更多空间。仅在紧凑和精简主题中，标签栏可见且位于窗口顶部时生效。小于按钮本身的宽度会让标签页与按钮重叠。"
          }
        }
      }
    },
    "ui.advanced.setting.WorkAroundMultiDisplayOSBug.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Work around a macOS bug where the OS moves windows to the first display for no good reason."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "规避 macOS 无故将窗口移到第一块显示器的问题。"
          }
        }
      }
    },
    "ui.advanced.setting.DisableDocumentedEditedIndicator.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disable documented edited indicator (black dot in close button)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "禁用文稿已编辑指示器（关闭按钮中的黑点）"
          }
        }
      }
    },
    "ui.advanced.setting.ShowWindowTitleWhenTabBarInvisible.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show window title when the tab bar is not visible?\nWhen disabled, the tab's title will be shown where the window title would normally go."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标签栏不可见时显示窗口标题？\n禁用后，在通常显示窗口标题的位置显示标签页标题。"
          }
        }
      }
    },
    "ui.advanced.setting.ShowWindowNameBesideTabs.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show the window name beside the tabs in the Compact and Minimal themes?\nThose themes have no title bar, so the window name is otherwise only visible when the tab bar is hidden. “When a custom name is set” (the default) shows it only after you name the window with Window > Edit Window Title, leaving windows you have not named unchanged. “Always” also shows the automatic title. This has no effect in themes that have a title bar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在紧凑和精简主题中，于标签页旁显示窗口名称？\n这两种主题没有标题栏，因此窗口名称原本只在标签栏隐藏时可见。“已设置自定义名称时”（默认）仅在通过“窗口 > 编辑窗口标题”命名后显示，不改变未命名窗口。“始终”还会显示自动标题。不影响有标题栏的主题。"
          }
        }
      }
    },
    "ui.advanced.setting.ShowWindowNameBesideTabs.option.0": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Never"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从不"
          }
        }
      }
    },
    "ui.advanced.setting.ShowWindowNameBesideTabs.option.1": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When a custom name is set"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已设置自定义名称时"
          }
        }
      }
    },
    "ui.advanced.setting.ShowWindowNameBesideTabs.option.2": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Always"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "始终"
          }
        }
      }
    },
    "ui.advanced.setting.SquareWindowCorners.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows have square corners.\nThis is only for users who have already hacked macOS to remove rounded corners. You must restart iTerm2 after changing this setting for it to take effect."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "窗口使用直角。\n仅供已经修改 macOS 以移除圆角的用户使用。更改后必须重新启动 iTerm2 才能生效。"
          }
        }
      }
    },
    "ui.advanced.setting.WindowBorderColor.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Border color for focused windows.\nShould be a web-style color, #rrggbb, or #rrggbbaa to also set opacity. You can also use p3#rrggbb or p3#rrggbbaa for p3 color space. Without an alpha component the border is drawn at 75% opacity. Requires “Show border around windows” with no title bar. Leave empty for the default color."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "聚焦窗口的边框颜色。\n使用网页颜色格式 #rrggbb，或 #rrggbbaa 同时指定不透明度。P3 色彩空间可用 p3#rrggbb 或 p3#rrggbbaa。不包含 alpha 分量时，以 75% 不透明度绘制边框。需启用“在窗口周围显示边框”且无标题栏。留空使用默认颜色。"
          }
        }
      }
    },
    "ui.advanced.setting.WindowBorderColorUnfocused.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Border color for unfocused windows.\nShould be a web-style color, #rrggbb, or #rrggbbaa to also set opacity. You can also use p3#rrggbb or p3#rrggbbaa for p3 color space. Without an alpha component the border is drawn at 75% opacity. Leave empty to match the focused color."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未聚焦窗口的边框颜色。\n使用网页颜色格式 #rrggbb，或 #rrggbbaa 同时指定不透明度。P3 色彩空间可用 p3#rrggbb 或 p3#rrggbbaa。不包含 alpha 分量时，以 75% 不透明度绘制边框。留空则与聚焦窗口一致。"
          }
        }
      }
    },
    "ui.advanced.setting.UseShortcutAccessoryViewController.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show window number in titlebar accessory?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在标题栏附属视图中显示窗口编号？"
          }
        }
      }
    },
    "ui.advanced.setting.IncludeShortcutInWindowsMenu.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Include keyboard shortcut for windows in Window menu?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在“窗口”菜单中包含窗口的键盘快捷键？"
          }
        }
      }
    },
    "ui.advanced.setting.ToolbeltFontSize.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Toolbelt font size in points.\nSet to 0 to use the system default. Changing this setting does not affect existing windows."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "工具侧栏字号（点）。\n设为 0 使用系统默认值。更改不影响现有窗口。"
          }
        }
      }
    },
    "ui.advanced.setting.ToolbeltFont.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Toolbelt font family name"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "工具侧栏字体家族名称"
          }
        }
      }
    },
    "ui.advanced.setting.FakeNotchHeight.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Simulated notch height"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模拟的刘海高度"
          }
        }
      }
    },
    "ui.advanced.setting.SplitPaneColor.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Custom color for split pane dividers. Leave empty to use default color.\nThis should be an HTML-style color, like #aabbcc."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自定义窗格分隔线颜色。留空使用默认颜色。\n使用 HTML 颜色格式，例如 #aabbcc。"
          }
        }
      }
    },
    "ui.advanced.setting.SplitPaneDividerWidth.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Custom width for split pane dividers in points (1-5). Set to 0 to use default width."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自定义窗格分隔线宽度（1–5 点）。设为 0 使用默认宽度。"
          }
        }
      }
    },
    "ui.advanced.setting.PaneTitleBarBackgroundColor.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Custom background color for pane title bars. Leave empty to use default color.\nThis should be an HTML-style color, like #aabbcc."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自定义窗格标题栏背景色。留空使用默认颜色。\n使用 HTML 颜色格式，例如 #aabbcc。"
          }
        }
      }
    },
    "ui.advanced.setting.PaneTitleBarTextColor.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Custom text color for pane title bars. Leave empty to use default color.\nThis should be an HTML-style color, like #aabbcc."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自定义窗格标题栏文字颜色。留空使用默认颜色。\n使用 HTML 颜色格式，例如 #aabbcc。"
          }
        }
      }
    },
    "ui.advanced.setting.BordersOnlyInLightMode.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opaque windows have a border only in light mode.\nThis setting modifies “Show border around windows”. Borders in opaque windows in dark mode are ugly and the OS draws one that is pretty serviceable. Enable this if you have trouble seeing them."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不透明窗口仅在浅色模式下显示边框。\n此项调整“在窗口周围显示边框”的行为。深色模式中的不透明窗口已有系统绘制的边框。如果看不清边框，可启用此项。"
          }
        }
      }
    },
    "ui.advanced.setting.AllowLiveResize.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow window resizing by dragging edges and corners?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许拖动边缘和角落调整窗口大小？"
          }
        }
      }
    },
    "ui.advanced.setting.ShowSecureKeyboardEntryIndicator.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show secure keyboard entry indicator?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示安全键盘输入指示器？"
          }
        }
      }
    },
    "ui.advanced.setting.LeftAlignTitleBarMinimalTahoe.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Left-align title bar in Minimal and Compact themes in macOS 26 and later?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 26 及更高版本中，精简和紧凑主题的标题栏左对齐？"
          }
        }
      }
    },
    "ui.advanced.setting.NoSyncNewWindowOrTabFromTmuxOpensTmux.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Suppress alert asking what kind of tab/window to open in tmux integration. Affects both windows and tabs.\nThis setting predates having separate settings for windows vs tabs. If it is off, then the two new settings will take effect."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不询问在 tmux 集成中应打开哪种标签页或窗口，同时影响两者。\n此设置早于窗口和标签页各自的独立设置。关闭后，两个新设置才会生效。"
          }
        }
      }
    },
    "ui.advanced.setting.NoSyncNewWindowFromTmuxOpensTmux.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Suppress alert asking what kind of window to open in tmux integration.\nNOTE: This only takes effect if the now-deprecated “Suppress alert asking what kind of tab/window to open in tmux integration” setting is off."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不询问在 tmux 集成中应打开哪种窗口。\n注意：只有关闭现已废弃的“不询问在 tmux 集成中应打开哪种标签页或窗口”设置后才生效。"
          }
        }
      }
    },
    "ui.advanced.setting.NoSyncNewTabFromTmuxOpensTmux.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Suppress alert asking what kind of tab to open in tmux integration.\nNOTE: This only takes effect if the now-deprecated “Suppress alert asking what kind of tab/window to open in tmux integration” setting is off."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不询问在 tmux 集成中应打开哪种标签页。\n注意：只有关闭现已废弃的“不询问在 tmux 集成中应打开哪种标签页或窗口”设置后才生效。"
          }
        }
      }
    },
    "ui.advanced.setting.TolerateUnrecognizedTmuxCommands.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tolerate unrecognized commands from server.\nIf disabled, an unknown command from tmux (such as output from ssh or wall) will end the session. Turning this off helps detect dead ssh sessions."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "容忍来自服务器的未知命令。\n禁用后，tmux 发来的未知命令（如 ssh 或 wall 的输出）将终止会话。关闭有助于检测已断开的 SSH 会话。"
          }
        }
      }
    },
    "ui.advanced.setting.UseBlackFillerColorForTmuxInFullScreen.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use black for filler area in tmux windows in full screen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全屏 tmux 窗口的填充区域使用黑色。"
          }
        }
      }
    },
    "ui.advanced.setting.TmuxWindowsShouldCloseAfterDetach.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close tmux windows after detaching?\nThis only takes effect when “Settings > Profiles > Session > After a session ends” is set to “No Action”."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分离后关闭 tmux 窗口？\n仅当“设置 > 配置文件 > 会话 > 会话结束后”设为“不执行操作”时生效。"
          }
        }
      }
    },
    "ui.advanced.setting.DisableTmuxWindowPositionRestoration.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disable window position restoration in tmux integration."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "禁用 tmux 集成中的窗口位置恢复。"
          }
        }
      }
    },
    "ui.advanced.setting.DisableTmuxWindowResizing.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Don't automatically resize tmux windows"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不自动调整 tmux 窗口大小"
          }
        }
      }
    },
    "ui.advanced.setting.AnonymousTmuxWindowsOpenInCurrentWindow.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where should new tmux windows not created by iTerm2 open?\n“Focused window” (the default) attaches the window as a tab of whichever iTerm2 window currently has keyboard focus. “Topmost session window” attaches it to the frontmost iTerm2 window that already shows a tab from this tmux session, regardless of focus."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "并非由 iTerm2 创建的新 tmux 窗口应在哪里打开？\n“聚焦窗口”（默认）将其作为标签页附加到当前拥有键盘焦点的 iTerm2 窗口。“最前方的会话窗口”则附加到已包含该 tmux 会话标签页的最前方 iTerm2 窗口，与焦点无关。"
          }
        }
      }
    },
    "ui.advanced.setting.AnonymousTmuxWindowsOpenInCurrentWindow.option.0": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New window"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新窗口"
          }
        }
      }
    },
    "ui.advanced.setting.AnonymousTmuxWindowsOpenInCurrentWindow.option.1": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Focused window"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "聚焦窗口"
          }
        }
      }
    },
    "ui.advanced.setting.AnonymousTmuxWindowsOpenInCurrentWindow.option.2": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Topmost session window"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最前方的会话窗口"
          }
        }
      }
    },
    "ui.advanced.setting.PollForTmuxForegroundJob.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Poll for foreground job name in tmux integration with tmux < 3.2?\nThis enables tab icons but can cause a lot of background traffic. This has no effect in tmux 3.2 and later, where polling is unnecessary."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 tmux 3.2 之前的版本时，在 tmux 集成中轮询前台任务名称？\n可启用标签页图标，但可能产生大量后台流量。tmux 3.2 及更高版本无需轮询，此项无效。"
          }
        }
      }
    },
    "ui.advanced.setting.TmuxTitlePrefix.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Insert this string at the start of tab and window titles to indicate tmux integration."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在标签页和窗口标题开头插入此字符串，以标识 tmux 集成。"
          }
        }
      }
    },
    "ui.advanced.setting.TmuxIncludeClientNameInWindowTitle.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When using tmux integration, should the tmux client name (typically the name of the attaching session or the host name) appear in brackets in the window title?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 tmux 集成时，在窗口标题的方括号中显示 tmux 客户端名称（通常为连接会话的名称或主机名）？"
          }
        }
      }
    },
    "ui.advanced.setting.RememberTmuxWindowSizes.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remember window sizes in tmux integration?\nRequires tmux 2.9 or later. The “variable window size” advanced setting must be enabled."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记住 tmux 集成中的窗口大小？\n需要 tmux 2.9 及更高版本，并启用“可变窗口大小”高级设置。"
          }
        }
      }
    },
    "ui.advanced.setting.TmuxWindowsOpenInBackground.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open tmux windows and tabs in the background?\nWhen enabled, attaching with tmux -CC (or when tmux creates a new window) will reveal the window or tab without moving keyboard focus to it. Focus stays on the attaching session."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在后台打开 tmux 窗口和标签页？\n启用后，通过 tmux -CC 连接或 tmux 创建新窗口时，会显示窗口或标签页，但不会将键盘焦点移到那里。焦点留在发起连接的会话。"
          }
        }
      }
    },
    "ui.advanced.setting.UnameCommand.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Command used to set the `uname` variable.\nThe main use of this is to use in the AI prompt so the language model knows the operating system."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置 `uname` 变量所用的命令。\n主要用于 AI 提示词，让语言模型了解操作系统。"
          }
        }
      }
    },
    "ui.advanced.setting.ValidCharactersInSSHUserNames.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Valid characters in SSH user names\nAlphanumerics are always valid. This specifies other valid characters."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH 用户名中的有效字符\n字母和数字始终有效。此项指定其他有效字符。"
          }
        }
      }
    },
    "ui.advanced.setting.NeverWarnAboutMeta.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Suppress a warning when ⌥ Key Acts as Meta is enabled in Settings > Profiles > Keys."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在“设置 > 配置文件 > 按键”中启用“⌥ 键用作 Meta”时不显示警告。"
          }
        }
      }
    },
    "ui.advanced.setting.NeverWarnAboutSpaces.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Suppress a warning about how to configure Spaces when setting a window's Space."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置窗口所在空间时，不显示如何配置空间的警告。"
          }
        }
      }
    },
    "ui.advanced.setting.NeverWarnAboutOverrides.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Suppress a warning about a change to a Profile key setting that overrides a global setting."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "修改配置文件按键设置并覆盖全局设置时，不显示警告。"
          }
        }
      }
    },
    "ui.advanced.setting.NeverWarnAboutPossibleOverrides.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Suppress a warning about a change to a global key that's overridden by a Profile."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "修改被配置文件覆盖的全局按键设置时，不显示警告。"
          }
        }
      }
    },
    "ui.advanced.setting.NoSyncNeverRemindPrefsChangesLostForUrl.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Suppress changed-setting warning when settings are loaded from a URL."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从 URL 加载设置时，不显示设置更改警告。"
          }
        }
      }
    },
    "ui.advanced.setting.NoSyncNeverRemindPrefsChangesLostForFile.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Suppress changed-setting warning when settings are loaded from a custom folder."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从自定义文件夹加载设置时，不显示设置更改警告。"
          }
        }
      }
    },
    "ui.advanced.setting.NoSyncSuppressAnnyoingBellOffer.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Suppress offer to silence bell when it rings too much."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "响铃过于频繁时，不提示可将其静音。"
          }
        }
      }
    },
    "ui.advanced.setting.SuppressMultilinePasteWarningWhenPastingOneLineWithTerminalNewline.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Suppress warning about multi-line paste when pasting a single line ending with a newline.\nThis suppresses all multi-line paste warnings when a single line is being pasted."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "粘贴以换行符结尾的单行文本时，不显示多行粘贴警告。\n粘贴单行时会抑制所有多行粘贴警告。"
          }
        }
      }
    },
    "ui.advanced.setting.SuppressMultilinePasteWarningWhenNotAtShellPrompt.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Suppress warning about multi-line paste when not at prompt.\nRequires Shell Integration to be installed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不在提示符处时，不显示多行粘贴警告。\n需要安装 Shell 集成。"
          }
        }
      }
    },
    "ui.advanced.setting.NoSyncSuppressBroadcastInputWarning.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Suppress warning about broadcasting input."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不显示广播输入警告。"
          }
        }
      }
    },
    "ui.advanced.setting.NoSyncSuppressCaptureOutputRequiresShellIntegrationWarning.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Suppress warning “Shell Integration is required for Capture Output.”"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不显示“捕获输出需要 Shell 集成”的警告。"
          }
        }
      }
    },
    "ui.advanced.setting.NoSyncSuppressCaptureOutputToolNotVisibleWarning.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Suppress warning that the Captured Output tool is not visible."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不显示“捕获的输出”工具不可见的警告。"
          }
        }
      }
    },
    "ui.advanced.setting.ClosingTmuxWindowKillsTmuxWindows.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Suppress kill/hide dialog when closing a tmux window."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭 tmux 窗口时，不显示终止或隐藏对话框。"
          }
        }
      }
    },
    "ui.advanced.setting.ClosingTmuxTabKillsTmuxWindows.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Suppress kill/hide dialog when closing a tmux tab."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭 tmux 标签页时，不显示终止或隐藏对话框。"
          }
        }
      }
    },
    "ui.advanced.setting.AboutToPasteTabsWithCancel.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Suppress warning when pasting tabs with offer to convert them to spaces or perform advanced paste."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "粘贴制表符时，不显示可转换为空格或使用高级粘贴的提示。"
          }
        }
      }
    },
    "ui.advanced.setting.ShortLivedSessionDuration.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Warn about short-lived sessions that live less than this many seconds."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对存活时间少于此秒数的短时会话发出警告。"
          }
        }
      }
    },
    "ui.advanced.setting.NoSyncDoNotWarnBeforeMultilinePaste.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Suppress warning about multi-line pastes (or a single line ending in a newline).\nThis applies whether you are at the shell prompt or not, provided two or more lines are being pasted."
          }
        },
        "zh-Hans": {
