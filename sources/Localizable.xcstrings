          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安装工作组"
          }
        }
      }
    },
    "ui.swift.claudecode.claudecodeonboarding.iterm2_s_python_api_is_enabled_a_cc.4fe94a0c": {
      "comment": "User-facing text in ClaudeCodeOnboarding.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "• iTerm2’s Python API is enabled\n• A cc-status hook is added to ~/.claude/settings.json\n• The toolbelt is shown\n• A Claude Code workgroup is added to iTerm2’s settings\n• Enter/Exit Workgroup triggers are added to the profiles you pick"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "• 启用 iTerm2 的 Python API\n• 将 cc-status 钩子添加到 ~/.claude/settings.json\n• 显示工具侧栏\n• 将 Claude Code 工作组添加到 iTerm2 设置\n• 将“进入/退出工作组”触发器添加到您选择的配置文件"
          }
        }
      }
    },
    "ui.swift.claudecode.claudecodeonboarding.learn_more_about_the_claude_code_integration.429eec85": {
