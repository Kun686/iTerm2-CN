    "ui.swift.api.itermuvmigration.some_scripts_were_written_for_python_versions_that.2cbe8ecc": {
      "comment": "Warning shown when multiple scripts must use newer Python versions. Preserve the formatted bullet-list placeholder.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some scripts were written for Python versions that are no longer available and now use newer ones. Python versions are not always compatible across releases, so a bumped script may need small changes.\n\n%1$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分脚本原本使用的 Python 版本已不可用，因此现在改用较新版本。不同版本的 Python 并不总是兼容，因此升级版本后的脚本可能需要少量修改。\n\n%1$@"
          }
        }
      }
    },
    "ui.swift.api.itermuvmigration.the_script_0_was_written_for_python_1_which.8b88ba0f": {
