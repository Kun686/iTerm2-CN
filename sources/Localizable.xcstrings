    "ui.statusbar.components.itermstatusbargitcomponent.running_git_in_didn_t_finish_within_seconds_so_the_status_bar_component.00afdff2": {
      "comment": "User-facing text in iTermStatusBarGitComponent (indirect UI).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Running git in %@ didn’t finish within %@ seconds, so the status bar component can’t show the branch. This often happens in very large repositories or when the working tree is on a slow filesystem.\n\nWould you like to increase the timeout to %@ seconds?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 %@ 中运行 git 未能在 %@ 秒内完成，因此状态栏组件无法显示分支。这通常发生在非常大的仓库中，或工作树位于较慢的文件系统上。\n\n要将超时时间增加到 %@ 秒吗？"
          }
        }
      }
    },
