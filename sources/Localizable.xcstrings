    "ui.swift.aiterm.chatviewcontroller.granted_this_chat_permission_to_control_0_you.f76ffede": {
      "comment": "User-facing text in ChatViewController.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**Granted this chat permission to control “%1$@”.**\n\nYou @-mentioned it, so the agent can act there without asking. Revoke to require approval again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "**已授予此聊天控制“%1$@”的权限。**\n\n您通过 @ 提及了它，因此代理无需询问即可在那里执行操作。撤销权限后将再次要求批准。"
          }
        }
      }
    },
    "ui.swift.aiterm.chatviewcontroller.help.b79cac92": {
      "comment": "User-facing text in ChatViewController.",
      "extractionState": "manual",
