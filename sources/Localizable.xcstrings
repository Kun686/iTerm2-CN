    "ui.terminalview.pseudoterminal.window_context_mistake_help": {
      "comment": "Help shown when a session variable is used in a window title expression.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This interpolated string is evaluated in the window’s context, not the session’s context. To access variables in the current session, use currentTab.currentSession.sessionVariableNameHere"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此插值字符串在窗口上下文中求值，而非会话上下文。若要访问当前会话中的变量，请使用 currentTab.currentSession.sessionVariableNameHere。"
          }
        }
      }
    },
