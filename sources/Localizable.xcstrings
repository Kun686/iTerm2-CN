    "ui.staterestoration.itermrestorablestatesqlite.iterm2_is_taking_longer_than_usual_to_verify.2ca2ee5a": {
      "comment": "User-facing text in iTermRestorableStateSQLite (source UI).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iTerm2 is taking longer than usual to verify your saved windows and tabs. This usually means the system is busy and it’s safe to keep waiting, but a damaged state restoration database could also cause it. You can discard the saved windows instead if you’d rather not wait."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iTerm2 验证已保存窗口和标签页所用的时间比平时更长。这通常表示系统正忙，可以安全地继续等待，但状态恢复数据库损坏也可能导致此情况。如果不想等待，可以丢弃已保存的窗口。"
          }
        }
      }
    },
