    "ui.swift.claudecode.claudecodeonboarding.the_claude_code_integration_relies_on_iterm2_s.30fd57aa": {
      "comment": "User-facing text in ClaudeCodeOnboarding.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Claude Code integration relies on iTerm2’s Python API to find sessions running Claude and track their status.\n\nThe Python API is currently disabled. Setup can’t continue until it is enabled. Click Enable to turn it on."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code 集成依赖 iTerm2 的 Python API 来查找正在运行 Claude 的会话并跟踪其状态。\n\nPython API 当前已禁用。启用前无法继续设置。点按“启用”将其开启。"
          }
        }
      }
    },
    "ui.swift.claudecode.claudecodeonboarding.these_profiles_are_dynamic_and_not_marked_rewritable.4fe68e3f": {
      "comment": "User-facing text in ClaudeCodeOnboarding.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These profiles are dynamic and not marked “rewritable,” so iTerm2 normally regenerates them from disk and any change here would be lost:\n\n%1$@\n\niTerm2 can write the triggers back to dynamic profiles when they’re marked rewritable. Rewriting can change the order of values in the underlying file."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些配置文件是动态的，且未标记为“可重写”，因此 iTerm2 通常会从磁盘重新生成它们；此处所做的任何更改都将丢失：\n\n%1$@\n\n当动态配置文件标记为可重写时，iTerm2 可以将触发器写回。重写可能会改变底层文件中各值的顺序。"
          }
        }
      }
    },
