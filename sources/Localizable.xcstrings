    "ui.shell_integration.steps.done": {"comment":"Display-only installer step fragment; keep format arguments and shell names unchanged.","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Done! Select “Continue” to proceed."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"完成！选择“继续”以进行下一步。"}}}},
    "ui.browser.toolbar.dev_null_help": {
      "comment": "Browser privacy-mode help. Preserve Markdown and the literal /dev/null name.",
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "## /dev/null Mode\n\nYour browsing activity is not being saved. No history, bookmarks, or other data will be stored.\n\nThis mode is set in the browser’s Profile under **Settings > Profile > Web > Privacy**.\n\n## 🙈 🙉 🙊" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "## /dev/null 模式\n\n不会保存你的浏览活动，也不会存储历史记录、书签或其他数据。\n\n此模式可在浏览器的配置文件中设置，位置为 **设置 > 配置文件 > 网页 > 隐私**。\n\n## 🙈 🙉 🙊" } }
      }
    },
    "ui.appkit.itermapplicationdelegate.gpu_reason.no_gpu": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"no usable GPU found on this machine."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此电脑上未找到可用的 GPU。"}}}},
    "ui.appkit.itermapplicationdelegate.gpu_reason.disabled": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"GPU Renderer is disabled in Settings > General."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"GPU 渲染器已在“设置 > 通用”中停用。"}}}},
    "ui.appkit.itermapplicationdelegate.gpu_reason.ligatures": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"ligatures are enabled. You can disable them in Settings > Profiles > Text > Use ligatures."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已启用连字。可在“设置 > 配置文件 > 文本 > 使用连字”中停用。"}}}},
    "ui.appkit.itermapplicationdelegate.gpu_reason.initializing": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"the GPU renderer is initializing. It should be ready soon."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"GPU 渲染器正在初始化，即将就绪。"}}}},
    "ui.appkit.itermapplicationdelegate.gpu_reason.invalid_size": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"the session is too large or too small."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"会话尺寸过大或过小。"}}}},
    "ui.appkit.itermapplicationdelegate.gpu_reason.session_initializing": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"the session is initializing."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"会话正在初始化。"}}}},
    "ui.appkit.itermapplicationdelegate.gpu_reason.transparency": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"transparent windows are not supported. They can be disabled in Settings > Profiles > Window > Transparency."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"不支持透明窗口。可在“设置 > 配置文件 > 窗口 > 透明度”中停用透明效果。"}}}},
    "ui.appkit.itermapplicationdelegate.gpu_reason.vertical_spacing": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"the font's vertical spacing set to less than 100%. You can change it in Settings > Profiles > Text > Change Font."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"字体的垂直间距小于 100%。可在“设置 > 配置文件 > 文本 > 更改字体”中调整。"}}}},
    "ui.appkit.itermapplicationdelegate.gpu_reason.margin_size": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"terminal window margins are too small. You can edit them in Settings > Advanced."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"终端窗口边距过小。可在“设置 > 高级”中调整。"}}}},
    "ui.appkit.itermapplicationdelegate.gpu_reason.annotations": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"annotations or URL shortcuts are open."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"批注或 URL 快捷方式处于打开状态。"}}}},
    "ui.appkit.itermapplicationdelegate.gpu_reason.portholes": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"this session has natively rendered items."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此会话包含原生渲染的项目。"}}}},
    "ui.appkit.itermapplicationdelegate.gpu_reason.find_panel": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"the find panel is open."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"查找面板处于打开状态。"}}}},
    "ui.appkit.itermapplicationdelegate.gpu_reason.paste_indicator": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"the paste progress indicator is open."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"粘贴进度指示器处于打开状态。"}}}},
    "ui.appkit.itermapplicationdelegate.gpu_reason.announcement": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"an announcement (yellow bar) is visible."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"通知栏（黄色横条）处于显示状态。"}}}},
    "ui.appkit.itermapplicationdelegate.gpu_reason.url_preview": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"a URL preview is visible."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"URL 预览处于显示状态。"}}}},
    "ui.appkit.itermapplicationdelegate.gpu_reason.window_resizing": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"the window is being resized."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"正在调整窗口大小。"}}}},
    "ui.appkit.itermapplicationdelegate.gpu_reason.disconnected_from_power": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"the computer is not connected to power. You can enable GPU rendering while disconnected from power in Settings > General > Advanced GPU Settings."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"电脑未连接电源。可在“设置 > 通用 > 高级 GPU 设置”中启用未连接电源时的 GPU 渲染。"}}}},
    "ui.appkit.itermapplicationdelegate.gpu_reason.idle": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"the session is idle. You can enable Metal while idle in Settings > Advanced."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"会话处于空闲状态。可在“设置 > 高级”中启用空闲时的 Metal 渲染。"}}}},
    "ui.appkit.itermapplicationdelegate.gpu_reason.too_many_panes_reason": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"This tab has too many split panes"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此标签页的分割窗格过多"}}}},
    "ui.appkit.itermapplicationdelegate.gpu_reason.no_focus": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"the window does not have keyboard focus."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"窗口没有键盘焦点。"}}}},
    "ui.appkit.itermapplicationdelegate.gpu_reason.tab_inactive": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"this tab is not active."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此标签页未处于活动状态。"}}}},
    "ui.appkit.itermapplicationdelegate.gpu_reason.tab_bar_temporarily_visible": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"the tab bar is temporarily visible."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"标签栏暂时处于显示状态。"}}}},
    "ui.appkit.itermapplicationdelegate.gpu_reason.screens_changing": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"the screen configuration has just changed."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"屏幕配置刚刚发生变化。"}}}},
    "ui.appkit.itermapplicationdelegate.gpu_reason.context_allocation_failure": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"of a temporary failure to allocate a graphics context."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"暂时无法分配图形上下文。"}}}},
    "ui.appkit.itermapplicationdelegate.gpu_reason.tab_drag_in_progress": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"a tab is being dragged."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"正在拖动标签页。"}}}},
    "ui.appkit.itermapplicationdelegate.gpu_reason.session_has_no_window": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"the current session has no window (this shouldn't happen)."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"当前会话没有窗口（正常情况下不应发生）。"}}}},
    "ui.appkit.itermapplicationdelegate.gpu_reason.drop_targets_visible": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"secure copy drop targets are visible."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"安全拷贝放置目标处于显示状态。"}}}},
    "ui.appkit.itermapplicationdelegate.gpu_reason.swiping_between_tabs": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"swiping between tabs"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"正在轻扫切换标签页"}}}},
    "ui.appkit.itermapplicationdelegate.gpu_reason.split_pane_being_dragged": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"a split pane is being dragged."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"正在拖动分割窗格。"}}}},
    "ui.appkit.itermapplicationdelegate.gpu_reason.window_obscured": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"the window is mostly under another window."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"窗口大部分被其他窗口遮挡。"}}}},
    "ui.appkit.itermapplicationdelegate.gpu_reason.lower_power_mode": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"macOS is in low power mode."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"macOS 处于低电量模式。"}}}},
    "ui.appkit.itermapplicationdelegate.gpu_reason.not_a_terminal": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"the current session is not a terminal."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"当前会话不是终端。"}}}},
    "ui.toolbelt.tool_name.actions": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Actions"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"操作"}}}},
