    "ui.swift.appkit.itermapplicationdelegate.a_coprocess_is_a_program_that_automates_interactions.cc083d25": {
      "comment": "User-facing text in iTermApplicationDelegate.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A **Coprocess** is a program that automates interactions in the terminal. Input to the terminal is redirected to stdin of the coprocess, and its output is sent back to the terminal as though the coprocess were typing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "**协进程**是自动执行终端交互的程序。终端输入会重定向到协进程的标准输入，而协进程的输出会像由协进程键入一样发送回终端。"
          }
        }
      }
    },
    "ui.swift.appkit.itermapplicationdelegate.a_mark_appears_as_a_blue_triangle_in.0e7acf1f": {
      "comment": "User-facing text in iTermApplicationDelegate.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A **Mark** appears as a blue triangle in the left margin. You can easily navigate among marks using **Jump to Mark**, **Next Mark**, and **Previous Mark**. If Shell Integration is enabled, a Mark is automatically added at each shell prompt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "**标记**在左侧边距中显示为蓝色三角形。您可以使用**跳转到标记**、**下一个标记**和**上一个标记**在标记间轻松导航。启用 Shell 集成后，每个 Shell 提示符处都会自动添加标记。"
          }
        }
      }
    },
    "ui.swift.appkit.itermapplicationdelegate.a_named_mark_appears_as_a_blue_triangle.40bbc8d8": {
      "comment": "User-facing text in iTermApplicationDelegate.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A **Named Mark** appears as a blue triangle in the left margin. In addition to being easy to navigate with **Next Mark** and **Previous Mark**, you can also find Named Marks in the Toolbelt’s **Named Marks** tool."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "**命名标记**在左侧边距中显示为蓝色三角形。除了可使用**下一个标记**和**上一个标记**轻松导航外，您还可以在工具侧栏的**命名标记**工具中找到它们。"
          }
        }
      }
    },
    "ui.swift.appkit.itermapplicationdelegate.a_named_mark_appears_as_a_blue_triangle.6b57d9fa": {
      "comment": "User-facing text in iTermApplicationDelegate.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A **Named Mark** appears as a blue triangle in the left margin. In addition to being easy to navigate with **Next Mark** and **Previous Mark**, you can also find Named Marks in this Toolbelt tool."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "**命名标记**在左侧边距中显示为蓝色三角形。除了可使用**下一个标记**和**上一个标记**轻松导航外，您还可以在此工具侧栏工具中找到命名标记。"
          }
        }
      }
    },
    "ui.swift.appkit.itermapplicationdelegate.a_pinned_hotkey_window_does_not_close_automatically.e06ec233": {
      "comment": "User-facing text in iTermApplicationDelegate.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A **pinned** Hotkey Window does not close automatically when it loses keyboard focus."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "**已固定**的热键窗口在失去键盘焦点时不会自动关闭。"
          }
        }
      }
    },
    "ui.swift.appkit.itermapplicationdelegate.actions_are_saved_instructions_for_iterm2_for_example.586c553f": {
      "comment": "User-facing text in iTermApplicationDelegate.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Actions are saved instructions for iTerm2. For example, you could create an action that opens a new window and then creates a split pane."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "动作是为 iTerm2 保存的指令。例如，您可以创建一个先打开新窗口、再创建分割窗格的动作。"
          }
        }
      }
    },
    "ui.swift.appkit.itermapplicationdelegate.adds_or_removes_this_session_from_the_set.f5218766": {
      "comment": "User-facing text in iTermApplicationDelegate.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adds or removes this session from the set of sessions in this window that have broadcast enabled. When you type in a session with broadcast enabled, the keystrokes are sent to all other sessions in the same window that have broadcast enabled."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将此会话添加到此窗口中启用了广播的会话集合，或从中移除。在启用了广播的会话中键入内容时，按键会发送到同一窗口中所有其他启用了广播的会话。"
          }
        }
      }
    },
    "ui.swift.appkit.itermapplicationdelegate.advanced_paste_lets_you_edit_text_before_pasting.279787b7": {
      "comment": "User-facing text in iTermApplicationDelegate.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**Advanced Paste** lets you edit text before pasting, remove control characters, convert tabs, base64-encode, and perform regular expression substitutions. It also lets you fine-tune how quickly pasted text is sent."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "**高级粘贴**可让您在粘贴前编辑文本、移除控制字符、转换制表符、进行 base64 编码和正则表达式替换，还可精细调整粘贴文本的发送速度。"
          }
        }
      }
    },
    "ui.swift.appkit.itermapplicationdelegate.ai_chats_opens_a_chat_window_where_you.a49d5af9": {
      "comment": "User-facing text in iTermApplicationDelegate.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**AI Chats** opens a chat window where you can interact with AI. It can optionally view and control the terminal if you grant it permission."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "**AI 聊天**会打开一个与 AI 交互的聊天窗口。如果您授予权限，AI 还可以选择性地查看和控制终端。"
          }
        }
      }
    },
    "ui.swift.appkit.itermapplicationdelegate.annotations_are_inline_markup_when_closed_they_appear.f3bb3b77": {
      "comment": "User-facing text in iTermApplicationDelegate.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Annotations are inline markup. When closed, they appear as a yellow underline; when open, they look like yellow stickies where you can write memos about content in the terminal window."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "注释是行内标记。关闭时显示为黄色下划线；打开时则像黄色便签，您可以在其中记录有关终端窗口内容的备忘。"
          }
        }
      }
    },
    "ui.swift.appkit.itermapplicationdelegate.auto_composer_replaces_your_shell_prompt_with_a.da24a70b": {
      "comment": "User-facing text in iTermApplicationDelegate.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**Auto Composer** replaces your shell prompt with a macOS-native text field. It does syntax highlighting and command and filename completion. You can also enable AI-powered suggestions. Shell Integration is required."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "**自动编写器**会用 macOS 原生文本字段替换 Shell 提示符。它支持语法高亮以及命令和文件名补全，也可启用 AI 建议。此功能需要 Shell 集成。"
          }
        }
      }
    },
    "ui.swift.appkit.itermapplicationdelegate.buried_sessions_are_hidden_in_the_buried_sessions.56aa64a3": {
      "comment": "User-facing text in iTermApplicationDelegate.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Buried sessions are hidden in the **Buried Sessions** menu below and do not appear in any window. These are particularly useful for the session where you initiate tmux integration by running `tmux -CC`."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "隐藏的会话会收纳在下方的**已隐藏的会话**菜单中，不会出现在任何窗口里。对于通过运行 `tmux -CC` 启动 tmux 集成的会话，这尤其有用。"
          }
        }
      }
    },
    "ui.swift.appkit.itermapplicationdelegate.captured_output_works_in_conjunction_with_a_trigger.5580682f": {
      "comment": "User-facing text in iTermApplicationDelegate.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**Captured Output** works in conjunction with a Trigger to detect interesting text in the terminal and make it easy to find. The Toolbelt tool shows a list of captured text. You can click to navigate to it or double-click to enter a programmable command. This is useful for finding errors in the output of a build command, for example. It requires Shell Integration."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "**捕获的输出**与触发器配合使用，可检测终端中值得关注的文本并便于查找。工具侧栏会显示捕获文本的列表；您可以点按以跳转到对应位置，或双击输入可编程命令。例如，这有助于查找构建命令输出中的错误。此功能需要 Shell 集成。"
          }
        }
      }
    },
    "ui.swift.appkit.itermapplicationdelegate.checks_whether_the_gpu_renderer_is_currently_being.bc30713f": {
      "comment": "User-facing text in iTermApplicationDelegate.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checks whether the GPU Renderer is currently being used in the active session. This is sometimes useful for debugging."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查活动会话当前是否正在使用 GPU 渲染器。这有时有助于调试。"
          }
        }
      }
    },
    "ui.swift.appkit.itermapplicationdelegate.codecierge_uses_ai_to_help_you_achieve_a.d62e3dfb": {
      "comment": "User-facing text in iTermApplicationDelegate.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**Codecierge** uses AI to help you achieve a goal. Tell it what you want to do, and it can watch your terminal to interpret output and suggest commands. Shell Integration is required."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "**Codecierge** 使用 AI 帮助您实现目标。告诉它您想做什么，它便可观察终端、解读输出并建议命令。此功能需要 Shell 集成。"
          }
        }
      }
    },
    "ui.swift.appkit.itermapplicationdelegate.debug_logs_are_saved_in_memory_while_this.306f414a": {
      "comment": "User-facing text in iTermApplicationDelegate.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Debug logs are saved in memory while this setting is enabled and written to `/tmp/debuglog.txt` when you turn it off. Memory use is capped at about 200MB; if the log grows past that, the oldest entries are discarded so the most recent activity is always kept."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用此设置时，调试日志保存在内存中；关闭时会写入 `/tmp/debuglog.txt`。内存占用上限约为 200MB；如果日志超过此大小，最旧的条目会被丢弃，以始终保留最近的活动。"
          }
        }
      }
    },
    "ui.swift.appkit.itermapplicationdelegate.filter_allows_you_to_hide_any_lines_that.04dbd695": {
      "comment": "User-facing text in iTermApplicationDelegate.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**Filter** allows you to hide any lines that do not match a search query, which can be a substring or regular expression. It updates live as new text arrives."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "**过滤器**可隐藏所有不匹配搜索查询的行；查询可以是子字符串或正则表达式。新文本到达时，结果会实时更新。"
          }
        }
      }
    },
    "ui.swift.appkit.itermapplicationdelegate.fold_lets_you_collapse_multiple_lines_into_a.95ce8655": {
      "comment": "User-facing text in iTermApplicationDelegate.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**Fold** lets you collapse multiple lines into a single line to hide distracting text. You can always unfold it by clicking the arrow in the margin, selecting the text and using **Edit > Unfold in Selection**, or right-clicking and choosing **Unfold**."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "**折叠**可将多行收起为一行，以隐藏干扰内容。您随时可以通过点按边距中的箭头、选择文本并使用**编辑 > 展开所选内容**，或右键点按并选择**展开**来恢复显示。"
          }
        }
      }
    },
    "ui.swift.appkit.itermapplicationdelegate.hides_everything_except_the_lines_of_selected_text.1414dcab": {
      "comment": "User-facing text in iTermApplicationDelegate.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hides everything except the lines of selected text to remove distractions."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "隐藏所选文本行以外的所有内容，减少干扰。"
          }
        }
      }
    },
    "ui.swift.appkit.itermapplicationdelegate.highlights_the_location_of_the_cursor_and_unhides.22489deb": {
      "comment": "User-facing text in iTermApplicationDelegate.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Highlights the location of the cursor and unhides it if it is currently hidden."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "突出显示光标位置；如果光标当前被隐藏，则将其显示出来。"
          }
        }
      }
    },
    "ui.swift.appkit.itermapplicationdelegate.if_enabled_you_ll_be_prompted_to_confirm.3b871453": {
      "comment": "User-facing text in iTermApplicationDelegate.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If enabled, you’ll be prompted to confirm that you wish to send a newline when pasting a single line of text ending in a newline. Shell Integration is required."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用后，粘贴以换行符结尾的单行文本时，系统会提示您确认是否发送换行符。此功能需要 Shell 集成。"
          }
        }
      }
    },
    "ui.swift.appkit.itermapplicationdelegate.if_shell_integration_is_installed_command_history_shows.f2d35e5b": {
      "comment": "User-facing text in iTermApplicationDelegate.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If Shell Integration is installed, **Command History** shows a searchable list of recently run commands on the current host."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安装 Shell 集成后，**命令历史**会显示当前主机上最近运行命令的可搜索列表。"
          }
        }
      }
    },
    "ui.swift.appkit.itermapplicationdelegate.if_you_want_to_share_python_api_scripts.5792f170": {
      "comment": "User-facing text in iTermApplicationDelegate.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you want to share Python API scripts, you can export them to an `.its` file. If you have a code signing certificate and private key in your Keychain, you can also sign the `.its` file."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果要共享 Python API 脚本，可以将其导出为 `.its` 文件。如果钥匙串中有代码签名证书和私钥，还可以为 `.its` 文件签名。"
          }
        }
      }
    },
    "ui.swift.appkit.itermapplicationdelegate.instant_replay_lets_you_review_recent_terminal_history.cbfde430": {
      "comment": "User-facing text in iTermApplicationDelegate.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**Instant Replay** lets you review recent terminal history. It’s handy if something just disappeared from the screen and it isn’t in scrollback history."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "**即时回放**可查看最近的终端历史。如果某些内容刚从屏幕上消失且不在回滚历史中，此功能会很有用。"
          }
        }
      }
    },
    "ui.swift.appkit.itermapplicationdelegate.iterm2_s_python_runtime_is_a_large_binary.ba3e4687": {
      "comment": "User-facing text in iTermApplicationDelegate.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iTerm2’s Python Runtime is a large binary package (hundreds of MBs) that enables the Python API by installing a pre-built Python environment that scripts can use."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iTerm2 的 Python 运行时是一个体积较大的二进制包（数百 MB），它通过安装供脚本使用的预构建 Python 环境来启用 Python API。"
          }
        }
      }
    },
    "ui.swift.appkit.itermapplicationdelegate.locked_windows_resist_being_resized_this_can_be.3c9425e2": {
      "comment": "User-facing text in iTermApplicationDelegate.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Locked windows resist being resized. This can be useful when macOS screws up your windows when connecting or disconnecting displays."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "锁定的窗口不易被调整大小。当连接或断开显示器时 macOS 打乱窗口尺寸，这会很有用。"
          }
        }
      }
    },
    "ui.swift.appkit.itermapplicationdelegate.notes_is_a_single_persistent_notepad_in_your.57130e5d": {
      "comment": "User-facing text in iTermApplicationDelegate.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**Notes** is a single, persistent notepad in your Toolbelt. It’s useful for keeping track of what you’re doing or composing messages."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "**便笺**是工具侧栏中一个持久保存的记事本，可用于记录当前工作或撰写消息。"
          }
        }
      }
    },
    "ui.swift.appkit.itermapplicationdelegate.open_quickly_provides_quick_access_to_many_common.9f6d73a2": {
      "comment": "User-facing text in iTermApplicationDelegate.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**Open Quickly** provides quick access to many common actions. You can use it to find a session by typing its name, directory, hostname, or recent command. You can also use it to switch profiles or create a new window by typing the name of a profile. Restore an arrangement by entering its name. Press `/` to get tips for quick commands."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "**快速打开**可让您快速访问许多常用操作。输入会话名称、目录、主机名或最近使用的命令即可查找会话；输入配置文件名称还可切换配置文件或创建新窗口。输入窗口布局名称可恢复该布局。按 `/` 可查看快捷命令提示。"
          }
        }
      }
    },
    "ui.swift.appkit.itermapplicationdelegate.opens_a_ui_where_you_can_add_update.1fc3e7a7": {
      "comment": "User-facing text in iTermApplicationDelegate.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens a UI where you can add, update, or remove pip dependencies of a Python API script."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开一个界面，可在其中添加、更新或移除 Python API 脚本的 pip 依赖项。"
          }
        }
      }
    },
    "ui.swift.appkit.itermapplicationdelegate.paste_history_shows_text_that_you_have_copied.36ce4610": {
      "comment": "User-facing text in iTermApplicationDelegate.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**Paste History** shows text that you have copied and pasted in iTerm2. You can configure it to be saved long term."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "**粘贴历史**显示您在 iTerm2 中拷贝和粘贴过的文本。您可以将其配置为长期保存。"
          }
        }
      }
    },
    "ui.swift.appkit.itermapplicationdelegate.prompts_you_to_select_a_profile_and_then.efe9077a": {
      "comment": "User-facing text in iTermApplicationDelegate.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prompts you to select a profile and then splits the current session vertically, placing the new session in the right half."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提示您选择配置文件，然后垂直分割当前会话，并在右半边放置新会话。"
          }
        }
      }
    },
    "ui.swift.appkit.itermapplicationdelegate.prompts_you_to_select_a_profile_and_then.f059e926": {
      "comment": "User-facing text in iTermApplicationDelegate.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prompts you to select a profile and then splits the current session horizontally, placing the new session in the bottom half."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提示您选择配置文件，然后水平分割当前会话，并在下半边放置新会话。"
          }
        }
      }
    },
    "ui.swift.appkit.itermapplicationdelegate.records_the_current_width_of_the_toolbelt_for.67601c5b": {
      "comment": "User-facing text in iTermApplicationDelegate.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Records the current width of the toolbelt for use in newly created windows."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记录工具侧栏的当前宽度，供新建窗口使用。"
          }
        }
      }
    },
    "ui.swift.appkit.itermapplicationdelegate.render_natively_shows_a_nicely_formatted_syntax_highlighted.a471a119": {
      "comment": "User-facing text in iTermApplicationDelegate.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**Render Natively** shows a nicely formatted, syntax-highlighted rendition of a document. For example, Markdown renders beautifully. It also allows for horizontal scrolling, making it a convenient way to view log files."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "**原生渲染**会以精美格式和语法高亮显示文档。例如，Markdown 可获得良好的渲染效果。它还支持水平滚动，便于查看日志文件。"
          }
        }
      }
    },
    "ui.swift.appkit.itermapplicationdelegate.secure_keyboard_entry_prevents_other_programs_from_intercepting.d4ae15e8": {
      "comment": "User-facing text in iTermApplicationDelegate.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**Secure Keyboard Entry** prevents other programs from intercepting your keystrokes in the terminal. However, it also breaks some functionality: other programs cannot activate their windows while this is enabled. For example, the `open` command will still open an app, but it won’t be activated."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "**安全键盘输入**可防止其他程序截获您在终端中的按键。不过，它也会影响部分功能：启用后，其他程序无法激活自己的窗口。例如，`open` 命令仍会打开应用，但不会将其激活。"
          }
        }
      }
    },
    "ui.swift.appkit.itermapplicationdelegate.shell_integration_consists_of_shell_scripts_that_run.853fee64": {
      "comment": "User-facing text in iTermApplicationDelegate.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**Shell Integration** consists of shell scripts that run when you log in. They inform iTerm2 of where your shell prompt is. This enables dozens of useful features such as command history, directory history, AI features, and more."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "**Shell 集成**由登录时运行的 Shell 脚本组成，它们会告知 iTerm2 Shell 提示符的位置，从而启用命令历史、目录历史、AI 功能等数十项实用功能。"
          }
        }
      }
    },
    "ui.swift.appkit.itermapplicationdelegate.shows_a_list_of_your_profiles_so_you.b119f019": {
      "comment": "User-facing text in iTermApplicationDelegate.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows a list of your profiles so you can create new sessions easily."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示配置文件列表，方便您创建新会话。"
          }
        }
      }
    },
    "ui.swift.appkit.itermapplicationdelegate.shows_your_most_used_directories_sorted_by_a.7740bb8a": {
      "comment": "User-facing text in iTermApplicationDelegate.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows your most used directories, sorted by a combination of frequency and recency of use. Requires Shell Integration."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示最常用的目录，并综合使用频率和最近使用时间排序。此功能需要 Shell 集成。"
          }
        }
      }
    },
    "ui.swift.appkit.itermapplicationdelegate.snippets_are_pieces_of_text_that_you_save.8e6cc5bb": {
      "comment": "User-facing text in iTermApplicationDelegate.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Snippets are pieces of text that you save to reuse later. They’re great for frequently used commands, hard-to-remember directories, and much more."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "代码片段是保存下来供以后重复使用的文本，适合存放常用命令、难记的目录等内容。"
          }
        }
      }
    },
    "ui.swift.appkit.itermapplicationdelegate.splits_the_current_session_horizontally_placing_a_new.d6eac7d1": {
      "comment": "User-facing text in iTermApplicationDelegate.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Splits the current session horizontally, placing a new session in the bottom half. The new session inherits the profile of the current session, including any changes made in `Session > Edit Session`."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "水平分割当前会话，并在下半边放置新会话。新会话会继承当前会话的配置文件，包括在 `会话 > 编辑会话` 中所做的任何更改。"
          }
        }
      }
    },
    "ui.swift.appkit.itermapplicationdelegate.splits_the_current_session_vertically_placing_a_new.34e401a5": {
      "comment": "User-facing text in iTermApplicationDelegate.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Splits the current session vertically, placing a new session in the right half. The new session inherits the profile of the current session, including any changes made in `Session > Edit Session`."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "垂直分割当前会话，并在右半边放置新会话。新会话会继承当前会话的配置文件，包括在 `会话 > 编辑会话` 中所做的任何更改。"
          }
        }
      }
    },
    "ui.swift.appkit.itermapplicationdelegate.stops_the_active_coprocess_input_to_the_terminal.b35ebc48": {
      "comment": "User-facing text in iTermApplicationDelegate.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stops the active coprocess. Input to the terminal is no longer redirected to the coprocess, and its output ceases."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "停止活动的协进程。终端输入将不再重定向到协进程，协进程的输出也会停止。"
          }
        }
      }
    },
    "ui.swift.appkit.itermapplicationdelegate.the_composer_is_a_window_within_the_terminal.c32a11a5": {
      "comment": "User-facing text in iTermApplicationDelegate.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Composer is a window within the terminal where you can edit text using macOS-native controls. It does syntax highlighting, command and filename completion—even over SSH (provided you use SSH Integration). If AI features are enabled, you can also get AI-powered suggestions. You can even have multiple cursors! When you're ready, you can send the whole buffer or just a line at a time to your shell."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "编写器是终端内的一个窗口，可使用 macOS 原生控件编辑文本。它支持语法高亮、命令和文件名补全，甚至可通过 SSH 使用（需要 SSH 集成）。启用 AI 功能后，还可获得 AI 建议，甚至可以使用多个光标。准备就绪后，您可以将整个缓冲区或逐行发送到 Shell。"
          }
        }
      }
    },
    "ui.swift.appkit.itermapplicationdelegate.the_password_manager_helps_you_keep_track_of.dc509649": {
      "comment": "User-facing text in iTermApplicationDelegate.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The **Password Manager** helps you keep track of your passwords securely. By default, it stores them in the macOS Keychain, but it can also use 1Password or LastPass."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "**密码管理器**可帮助您安全管理密码。默认情况下，密码存储在 macOS 钥匙串中，也可以使用 1Password 或 LastPass。"
          }
        }
      }
    },
    "ui.swift.appkit.itermapplicationdelegate.the_python_repl_opens_a_window_running_a.279e2422": {
      "comment": "User-facing text in iTermApplicationDelegate.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Python REPL opens a window running a special Python interpreter that lets you experiment with iTerm2’s Python API. You can use `await` at the top level of the interpreter."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Python REPL 会打开一个运行专用 Python 解释器的窗口，供您试用 iTerm2 的 Python API。您可以在解释器顶层使用 `await`。"
          }
        }
      }
    },
    "ui.swift.appkit.itermapplicationdelegate.the_session_status_tool_shows_the_status_of.bb3817e1": {
      "comment": "User-facing text in iTermApplicationDelegate.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The **Session Status** tool shows the status of sessions across all tabs. Statuses can be set by the **Set Tab Status** trigger or by programs using a control sequence. Each entry shows the session name, a colored indicator dot, status text, and a keyboard shortcut to jump to that session."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "**会话状态**工具显示所有标签页中各会话的状态。状态可由**设置标签页状态**触发器设置，也可由程序通过控制序列设置。每个条目都会显示会话名称、彩色指示点、状态文本，以及跳转到该会话的键盘快捷键。"
          }
        }
      }
    },
    "ui.swift.appkit.itermapplicationdelegate.the_tmux_dashboard_helps_you_switch_between_tmux.15e32861": {
      "comment": "User-facing text in iTermApplicationDelegate.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The **tmux Dashboard** helps you switch between tmux sessions, show and hide windows, and administer other features of tmux without needing to use tmux’s commands."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "**tmux 仪表盘**可帮助您切换 tmux 会话、显示和隐藏窗口，以及管理 tmux 的其他功能，无需使用 tmux 命令。"
          }
        }
      }
    },
    "ui.swift.appkit.itermapplicationdelegate.the_toolbelt_provides_a_versatile_dockable_sidebar_that.14fc12e1": {
      "comment": "User-facing text in iTermApplicationDelegate.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The **Toolbelt** provides a versatile, dockable sidebar that offers quick access to frequently used features and information. It supports multiple panels that can be displayed simultaneously, including clipboard history, recently opened directories, command history, a scratchpad for notes, and more.\n"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "**工具侧栏**是一种用途广泛、可停靠的侧边栏，可快速访问常用功能和信息。它支持同时显示多个面板，包括剪贴板历史、最近打开的目录、命令历史、记事便笺等。\n"
          }
        }
      }
    },
    "ui.swift.appkit.itermapplicationdelegate.this_is_effective_only_when_warn_before_multi.1f0d529f": {
      "comment": "User-facing text in iTermApplicationDelegate.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is effective only when **Warn Before Multi-Line Paste** is enabled. It also requires Shell Integration. When enabled, it suppresses confirmation when pasting text containing a newline if you are not at a shell prompt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此选项仅在启用**多行粘贴前警告**时生效，并且需要 Shell 集成。启用后，如果当前不在 Shell 提示符处，粘贴包含换行符的文本时将不再要求确认。"
          }
        }
      }
    },
    "ui.swift.appkit.itermapplicationdelegate.this_is_meant_to_be_used_at_the.fad0fbaa": {
      "comment": "User-facing text in iTermApplicationDelegate.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is meant to be used at the shell prompt after executing a command. It requires Shell Integration. The output of the preceding (or selected) command is sent to AI, which annotates the output and opens a chat window for further discussion."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此功能用于在执行命令后从 Shell 提示符调用，并且需要 Shell 集成。前一个（或所选）命令的输出会发送给 AI，由 AI 为输出添加注释并打开聊天窗口以便进一步讨论。"
          }
        }
      }
    },
    "ui.swift.appkit.itermapplicationdelegate.this_mode_is_generally_not_recommended_disambiguate_escape.b59258cd": {
      "comment": "User-facing text in iTermApplicationDelegate.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This mode is generally not recommended. **Disambiguate Escape** is a more modern approach."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通常不建议使用此模式。**区分 Escape** 是更现代的方式。"
          }
        }
      }
    },
    "ui.swift.appkit.itermapplicationdelegate.triggers_are_actions_the_terminal_performs_automatically_when.41a13f5a": {
      "comment": "User-facing text in iTermApplicationDelegate.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**Triggers** are actions the terminal performs automatically when text matching a regular expression is received. For example, you can highlight text or display an alert."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "**触发器**是终端在收到匹配正则表达式的文本时自动执行的动作。例如，可以突出显示文本或显示提醒。"
          }
        }
      }
    },
    "ui.swift.appkit.itermapplicationdelegate.use_import_to_install_scripts_others_have_shared.a7a61618": {
      "comment": "User-facing text in iTermApplicationDelegate.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use **Import** to install scripts others have shared with you. These scripts have the `.its` extension."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用**导入**安装他人共享给您的脚本。这些脚本使用 `.its` 扩展名。"
          }
        }
      }
    },
    "ui.swift.appkit.itermapplicationdelegate.view_errors_and_low_level_communication_between_python.ec6905c9": {
      "comment": "User-facing text in iTermApplicationDelegate.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "View errors and low-level communication between Python API scripts and iTerm2 here.\n\nThe Inspector can be accessed from the Console. It allows you to browse variables in sessions, tabs, and windows."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在此查看 Python API 脚本与 iTerm2 之间的错误和底层通信。\n\n可以从控制台访问检查器，用它浏览会话、标签页和窗口中的变量。"
          }
        }
      }
    },
    "ui.swift.appkit.itermapplicationdelegate.when_a_window_s_layout_is_locked_its.f0519c56": {
      "comment": "User-facing text in iTermApplicationDelegate.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When a window’s layout is locked, its tabs and panes can’t be added, closed, reordered, dragged, or moved to another window, so a stray click or drag can’t rearrange it. Resizing panes, opening new windows, and closing the window still work. This is an alternative to Lock Size; turning one on turns the other off."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "锁定窗口布局后，无法添加、关闭、重新排序或拖动其中的标签页和窗格，也无法将其移到其他窗口，因此误点按或拖动不会打乱布局。仍可调整窗格大小、打开新窗口以及关闭窗口。此功能与“锁定大小”互斥；启用其中一个会关闭另一个。"
          }
        }
      }
    },
    "ui.swift.appkit.itermapplicationdelegate.when_enabled_anything_you_type_in_this_tab.b27b34c3": {
      "comment": "User-facing text in iTermApplicationDelegate.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When enabled, anything you type in this tab is sent to all sessions in this tab."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用后，您在此标签页中键入的任何内容都会发送到此标签页中的所有会话。"
          }
        }
      }
    },
    "ui.swift.appkit.itermapplicationdelegate.when_enabled_anything_you_type_in_this_window.d9344e96": {
      "comment": "User-facing text in iTermApplicationDelegate.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When enabled, anything you type in this window is sent to all sessions in this window."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用后，您在此窗口中键入的任何内容都会发送到此窗口中的所有会话。"
          }
        }
      }
    },
    "ui.swift.appkit.itermapplicationdelegate.when_enabled_control_characters_are_displayed_visually_rather.62d2a288": {
      "comment": "User-facing text in iTermApplicationDelegate.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When enabled, control characters are displayed visually rather than being interpreted as usual."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用后，控制字符会以可见形式显示，而不会按通常方式解释。"
          }
        }
      }
    },
    "ui.swift.appkit.itermapplicationdelegate.when_enabled_dividers_rendered_by_programs_like_vim.ce94148c": {
      "comment": "User-facing text in iTermApplicationDelegate.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When enabled, dividers rendered by programs like vim or emacs are detected, and text selection wraps around them."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用后，会检测 vim 或 emacs 等程序绘制的分隔线，并让文本选择绕过这些分隔线。"
          }
        }
      }
    },
    "ui.swift.appkit.itermapplicationdelegate.when_enabled_prominent_red_lines_are_drawn_in.af21f67d": {
      "comment": "User-facing text in iTermApplicationDelegate.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When enabled, prominent red lines are drawn in the background to indicate that text you type is being broadcast to other sessions."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用后，背景中会绘制醒目的红线，表示您键入的文本正广播到其他会话。"
          }
        }
      }
    },
    "ui.swift.appkit.itermapplicationdelegate.when_enabled_the_next_time_any_session_in.2cad386c": {
      "comment": "User-facing text in iTermApplicationDelegate.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When enabled, the next time any session in this window changes its status (such as waiting, idle, or busy) an alert is shown and this setting turns itself back off. This is the same toggle as the bell button in the **Session Status** toolbelt tool, which must be open for this to be available."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用后，此窗口中的任一会话下次改变状态（例如等待、空闲或忙碌）时会显示提醒，然后此设置会自动关闭。它与工具侧栏**会话状态**工具中的铃铛按钮是同一个开关；必须打开该工具才能使用此设置。"
          }
        }
      }
    },
    "ui.swift.appkit.itermapplicationdelegate.when_enabled_typing_in_this_session_is_broadcast.c9c11cad": {
      "comment": "User-facing text in iTermApplicationDelegate.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When enabled, typing in this session is broadcast to other sessions in the same broadcast domain. Typing in other sessions sends input only to those sessions."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用后，在此会话中键入的内容会广播到同一广播域中的其他会话；在其他会话中键入时，输入只会发送到相应会话。"
          }
        }
      }
    },
    "ui.swift.appkit.itermapplicationdelegate.when_selected_at_a_shell_prompt_provided_shell.22f96f65": {
      "comment": "User-facing text in iTermApplicationDelegate.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When selected at a shell prompt (provided Shell Integration is installed) or in the Composer, it sends the current command to the configured AI system along with a prompt for it to generate a command. If no input is provided, you’ll be asked to give instructions. The generated command goes into the Composer."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Shell 提示符处（需要安装 Shell 集成）或编写器中选择此项时，当前命令会连同生成命令的提示一起发送给已配置的 AI 系统。如果没有输入内容，系统会要求您提供说明。生成的命令将进入编写器。"
          }
        }
      }
    },
    "ui.swift.appkit.itermapplicationdelegate.while_buffer_input_is_turned_on_keyboard_input.5309f7d0": {
      "comment": "User-facing text in iTermApplicationDelegate.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While Buffer Input is turned on, keyboard input is stored in a buffer. It will be sent when Buffer Input is turned off. You can also configure a trigger to change the Buffer Input setting."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用缓冲输入时，键盘输入会存储在缓冲区中；关闭缓冲输入后才会发送。您也可以配置触发器来更改缓冲输入设置。"
          }
        }
      }
    },
    "ui.swift.appkit.itermapplicationdelegate.window_arrangements_are_a_saved_record_of_one.4599eb95": {
      "comment": "User-facing text in iTermApplicationDelegate.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**Window Arrangements** are a saved record of one or more windows, their tabs, and split panes, including how each pane is configured. They do not include content. They’re a quick way to create a working environment with multiple sessions in various configurations."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "**窗口布局**是一个或多个窗口及其标签页和分割窗格的保存记录，其中包括每个窗格的配置，但不包含内容。借助窗口布局，可以快速创建由多个会话和不同配置组成的工作环境。"
          }
        }
      }
    },
    "ui.swift.appkit.itermapplicationdelegate.you_ll_be_prompted_any_time_you_paste.efb25d74": {
      "comment": "User-facing text in iTermApplicationDelegate.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You’ll be prompted any time you paste text containing a newline. See also **Limit Multi-Line Paste Warning to Shell Prompt**."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每当粘贴包含换行符的文本时都会提示您。另请参阅**仅在 Shell 提示符处显示多行粘贴警告**。"
          }
        }
      }
    },
    "ui.swift.appkit.itermmacos13requirementnotice.deprecation_notice.b5224f00": {
      "comment": "User-facing text in iTermMacOS13RequirementNotice.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deprecation Notice"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "停止支持通知"
          }
        }
      }
    },
    "ui.swift.appkit.itermmacos13requirementnotice.future_versions_of_iterm2_will_require_macos_13.ef14fde0": {
      "comment": "User-facing text in iTermMacOS13RequirementNotice.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Future versions of iTerm2 will require macOS 13 (Ventura) or later. This is the last version that supports macOS 12. Sorry for the inconvenience!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未来版本的 iTerm2 将需要 macOS 13（Ventura）或更高版本。这是最后一个支持 macOS 12 的版本。给您带来不便，敬请谅解！"
          }
        }
      }
    },
    "ui.swift.appkit.itermmacos13requirementnotice.ok.565339bc": {
      "comment": "User-facing text in iTermMacOS13RequirementNotice.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OK"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "好"
          }
        }
      }
    },
    "ui.swift.appkit.itermsuppressedalertswindowcontroller.alert.44a57b22": {
