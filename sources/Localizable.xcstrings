            "value": "徽标使用的字体。"
          }
        }
      }
    },
    "ui.advanced.setting.BadgeFontIsBold.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Should the badge render in bold type?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以粗体显示徽标？"
          }
        }
      }
    },
    "ui.advanced.setting.BadgeMaxWidthFraction.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Maximum width of the badge\nAs a fraction of the width of the terminal, between 0 and 1.0. This is the default value if a profile does not have a setting."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "徽标的最大宽度\n占终端宽度的比例，介于 0 和 1.0 之间。配置文件未设置时使用此默认值。"
          }
        }
      }
    },
    "ui.advanced.setting.BadgeMaxHeightFraction.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Maximum height of the badge\nAs a fraction of the height of the terminal, between 0 and 1.0. This is the default value if a profile does not have a setting."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "徽标的最大高度\n占终端高度的比例，介于 0 和 1.0 之间。配置文件未设置时使用此默认值。"
          }
        }
      }
    },
    "ui.advanced.setting.BadgeRightMargin.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Default value for right margin for the badge\nHow much space to leave between the right edge of the badge and the right edge of the terminal. Can be overridden by a profile setting. This is the default value if a profile does not have a setting."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "徽标右边距的默认值\n徽标右边缘与终端右边缘之间的间距。可由配置文件设置覆盖；配置文件未设置时使用此默认值。"
          }
        }
      }
    },
    "ui.advanced.setting.BadgeTopMargin.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Default value for the top margin for the badge\nHow much space to leave between the top edge of the badge and the top edge of the terminal. Can be overridden by a profile setting. This is the default value if a profile does not have a setting."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "徽标上边距的默认值\n徽标上边缘与终端上边缘之间的间距。可由配置文件设置覆盖；配置文件未设置时使用此默认值。"
          }
        }
      }
    },
    "ui.advanced.setting.WebKitAdblockEnabled.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable ad blocking in the web browser?\nWhen enabled, downloads and applies ad blocking rules from the configured URL."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在网页浏览器中启用广告拦截？\n启用后，从配置的 URL 下载并应用广告拦截规则。"
          }
        }
      }
    },
    "ui.advanced.setting.AdblockListURL.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "URL for ad blocking filter list\nThis should be a JSON file in WebKit content blocker format. The list is downloaded automatically every 24 hours."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "广告拦截过滤列表的 URL\n应为 WebKit 内容拦截器格式的 JSON 文件。每 24 小时自动下载一次。"
          }
        }
      }
    },
    "ui.advanced.setting.BrowserProxyEnabled.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable HTTP proxy for web browser?\nWhen enabled, routes all browser traffic through the configured proxy server."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为网页浏览器启用 HTTP 代理？\n启用后，所有浏览器流量通过配置的代理服务器。"
          }
        }
      }
    },
    "ui.advanced.setting.BrowserProxyHost.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP proxy hostname or IP address\nThe address of the proxy server to use for browser connections."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP 代理主机名或 IP 地址\n浏览器连接使用的代理服务器地址。"
          }
        }
      }
    },
    "ui.advanced.setting.BrowserProxyPort.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP proxy port\nThe port number of the proxy server."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP 代理端口\n代理服务器的端口号。"
          }
        }
      }
    },
    "ui.advanced.setting.WebInstantReplayFrameRate.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Instant replay frame rate for web browser sessions"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网页浏览器会话的即时回放帧率"
          }
        }
      }
    },
    "ui.advanced.setting.BrowserPluginPathHint.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location of browser plugin if it cannot be auto-detected"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法自动检测浏览器插件时使用的插件位置"
          }
        }
      }
    },
    "ui.advanced.setting.KillSessionsOnLogout.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kill sessions on logout.\nA possible fix for issue 4147."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "注销时终止会话。\n可能解决问题 4147。"
          }
        }
      }
    },
    "ui.advanced.setting.UseExperimentalFontMetrics.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a more theoretically correct technique to measure line height.\nYou must restart iTerm2 or adjust a session's font size for this change to take effect."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用理论上更准确的方法测量行高。\n需重新启动 iTerm2 或调整会话字号才能生效。"
          }
        }
      }
    },
    "ui.advanced.setting.FastForegroundJobUpdates.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable low-latency updates of the current foreground job"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用当前前台任务的低延迟更新"
          }
        }
      }
    },
    "ui.advanced.setting.TmuxVariableWindowSizesSupported.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow variable window sizes in tmux integration.\nRequres tmux version 2.9 or later."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许 tmux 集成使用可变窗口大小。\n需要 tmux 2.9 及更高版本。"
          }
        }
      }
    },
    "ui.advanced.setting.AggressiveBaseCharacterDetection.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Detect base unicode characters with lookup table.\nApple's algorithm for segmenting composed characters makes bad choices, such as for Tamil. Enable this to reduce text overlapping."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用查找表检测 Unicode 基础字符。\nApple 的组合字符分段算法有时会错误处理，例如泰米尔文。启用可减少文本重叠。"
          }
        }
      }
    },
    "ui.advanced.setting.EscapeWithQuotes.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Escape file names with single quotes instead of backslashes.\nThis is intended for users of xonsh, which does not accept backslash escaping."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用单引号而非反斜杠转义文件名。\n供不支持反斜杠转义的 xonsh 用户使用。"
          }
        }
      }
    },
    "ui.advanced.setting.FontsForGenerousRounding.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "List of fonts to use alternate rounding algorithm for line height calculation.\nThis fixes consolas and emulates Terminal.app’s behavior on macOS 10.15. This is a comma-delimited list of font family substrings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用替代舍入算法计算行高的字体列表。\n修复 consolas，并模拟 macOS 10.15 中 Terminal.app 的行为。以逗号分隔字体家族名称的子字符串。"
          }
        }
      }
    },
    "ui.advanced.setting.ExperimentalKeyHandling.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Improved support for input method editors like AquaSKK."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "改进对 AquaSKK 等输入法编辑器的支持。"
          }
        }
      }
    },
    "ui.advanced.setting.AllowSendingFunctionKeysToCocoa.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow function keys to be handled by macOS text input system.\nThis supports using function keys with modifiers as compose/dead keys in custom keyboard layouts."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许 macOS 文本输入系统处理功能键。\n支持在自定义键盘布局中，将功能键与修饰键组合用作组合键或死键。"
          }
        }
      }
    },
    "ui.advanced.setting.DisableMetalWhenIdle.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disable metal renderer when idle to save CPU utilization?\nRequires Metal renderer"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "空闲时禁用 Metal 渲染器以节省 CPU 占用？\n需要 Metal 渲染器"
          }
        }
      }
    },
    "ui.advanced.setting.DismemberScrollView.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dismember scroll view for better GPU performance?\nThis enables a dangerous hack that might improve drawing performance on macOS 10.14 only."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拆分滚动视图以改善 GPU 性能？\n启用一种有风险的变通方式，仅可能改善 macOS 10.14 的绘制性能。"
          }
        }
      }
    },
    "ui.advanced.setting.ExtendBackgroundColorIntoMargins.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Extend background color into margins in alternate screen mode?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "备用屏幕模式下，将背景色延伸到边距区域？"
          }
        }
      }
    },
    "ui.advanced.setting.SupportREPCode.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable support for REP (Repeat previous character) escape sequence?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "支持 REP（重复前一个字符）转义序列？"
          }
        }
      }
    },
    "ui.advanced.setting.ProportionalScrollWheelReporting.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Report multiple mouse scroll events when scrolling quickly?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "快速滚动时报告多个鼠标滚动事件？"
          }
        }
      }
    },
    "ui.advanced.setting.UseModernScrollWheelAccumulator.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use modern scroll wheel accumulator.\nThis should support wheel mice better and feel more natural."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用现代滚轮累加器。\n应能更好地支持滚轮鼠标，使手感更自然。"
          }
        }
      }
    },
    "ui.advanced.setting.ResetSGROnPrompt.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reset colors at shell prompt?\nUses shell integration to detect a shell prompt and, if enabled, resets colors to their defaults."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Shell 提示符处重置颜色？\n通过 Shell 集成检测提示符，启用后将颜色恢复为默认值。"
          }
        }
      }
    },
    "ui.advanced.setting.RetinaInlineImages.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show inline images at Retina resolution."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以 Retina 分辨率显示内联图片。"
          }
        }
      }
    },
    "ui.advanced.setting.ThrottleMetalConcurrentFrames.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduce number of frames in flight when GPU can't produce drawables quickly."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "GPU 无法快速提供可绘制对象时，减少处理中帧数。"
          }
        }
      }
    },
    "ui.advanced.setting.MetalSynchronizedDrawing.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use synchronized Metal drawable presentation?\nDefers drawable acquisition until rendering completes, presents synchronously with Core Animation, and acquires drawables on the private render queue. May improve frame rates."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用同步的 Metal 可绘制对象呈现？\n将获取可绘制对象推迟到渲染完成，与 Core Animation 同步呈现，并在私有渲染队列获取对象。可能提高帧率。"
          }
        }
      }
    },
    "ui.advanced.setting.MetalRowOutputCacheEnabled.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cache per-row GPU build output?\nSkips rebuilding the glyph and color data for rows whose content and configuration have not changed since the last frame. Experimental."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "缓存每行的 GPU 构建输出？\n若某行内容和配置自上一帧起未变化，则跳过重建其字形及颜色数据。实验性功能。"
          }
        }
      }
    },
    "ui.advanced.setting.SshURLsSupportPath.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH URLs respect the path.\nThey run the command: ssh -t \"cd $$PATH$$; exec \\$SHELL -l\""
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH URL 遵循路径。\n运行命令：ssh -t \"cd $$PATH$$; exec \\$SHELL -l\""
          }
        }
      }
    },
    "ui.advanced.setting.UseDivorcedProfileToSplit.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When splitting a pane, use the profile with local modifications, not the backing profile."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分割窗格时，使用包含本地修改的配置文件，而非原始配置文件。"
          }
        }
      }
    },
    "ui.advanced.setting.SynergyModifierRemappingEnabled.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Support modifier remapping for keystrokes originated by Synergy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "支持对来自 Synergy 的按键重映射修饰键。"
          }
        }
      }
    },
    "ui.advanced.setting.ShouldSetLCTerminal.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set LC_TERMINAL=iTerm2.\nopenssh and mosh pass this to hosts you connect to. It communicates the current terminal emulator. This is useful for enabling terminal emulator-specific features."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置 LC_TERMINAL=iTerm2。\nopenssh 和 mosh 将它传给连接的主机，用于告知当前终端模拟器，便于启用模拟器专属功能。"
          }
        }
      }
    },
    "ui.advanced.setting.ClearBellIconAggressively.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear bell icon when a session becomes active.\nWhen off, you must type in the session to clear the bell icon."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会话变为活动状态时清除响铃图标。\n关闭时，必须在会话中输入才能清除图标。"
          }
        }
      }
    },
    "ui.advanced.setting.WorkAroundNumericKeypadBug.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Treat the equals sign on the numeric keypad as a key on the numeric keypad.\nFor mysterious reasons, macOS does not treat this key as belonging to the numeric keypad. Enable this setting to work around the bug."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将数字小键盘的等号键视为数字小键盘按键。\nmacOS 因不明原因未将其归入数字小键盘。启用此项可规避该问题。"
          }
        }
      }
    },
    "ui.advanced.setting.EnableCharacterAccentMenu.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable character accent menu.\nThis disables the ordinary key repeat behavior for press-and-hold. You must restart iTerm2 for this change to take effect."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用字符重音菜单。\n会禁用长按按键时通常的重复输入行为。必须重新启动 iTerm2 才能生效。"
          }
        }
      }
    },
    "ui.advanced.setting.AccelerateUploads.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make uploads with it2ul really fast."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显著加快 it2ul 上传。"
          }
        }
      }
    },
    "ui.advanced.setting.Multiserver.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable multi-server daemon.\nA new implementation of session restoration that combines daemon processes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用多服务器守护进程。\n一种合并守护进程的会话恢复新实现。"
          }
        }
      }
    },
    "ui.advanced.setting.UseRestorableStateController.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable restorable state controller?\nThis makes window restoration more reliable."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用可恢复状态控制器？\n可使窗口恢复更可靠。"
          }
        }
      }
    },
    "ui.advanced.setting.FixMouseWheel.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mouse wheel always scrolls when scroll bars are visible"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "滚动条可见时，鼠标滚轮始终滚动"
          }
        }
      }
    },
    "ui.advanced.setting.OscColorReport16Bits.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Report 16-bit color values to OSC 4 and 10 through 19.\nWorks around a bug in older vim where they could not properly parse 8-bit values."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "向 OSC 4 及 OSC 10 到 19 报告 16 位颜色值。\n规避旧版 vim 无法正确解析 8 位值的问题。"
          }
        }
      }
    },
    "ui.advanced.setting.ShowLocationsInScrollbar.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show search result and prompt locations in scroll bar.\nChanging this setting will not affect existing sessions until you restart."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在滚动条中显示搜索结果和提示符位置。\n重新启动前，更改不影响现有会话。"
          }
        }
      }
    },
    "ui.advanced.setting.ShowMarksInScrollbar.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show prompt locations in scroll bar?\nChanging this setting will not affect existing sessions until you restart. You must also enable “Show search result and prompt locations in scroll bar” for this to take effect."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在滚动条中显示提示符位置？\n重新启动前，更改不影响现有会话。还须启用“在滚动条中显示搜索结果和提示符位置”才能生效。"
          }
        }
      }
    },
    "ui.advanced.setting.AllowTabbarInTitlebarAccessoryBigSur.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make the tab bar a titlebar accessory view in Big Sur?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Big Sur 中将标签栏设为标题栏附属视图？"
          }
        }
      }
    },
    "ui.advanced.setting.StoreStateInSqlite.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Store window restoration state in SQLite"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将窗口恢复状态存储到 SQLite"
          }
        }
      }
    },
    "ui.advanced.setting.UseNewContentFormat.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save unlimited amount of window contents.\nThis is going to be slow unless you enable SQLite-based window restoration too."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不限制保存的窗口内容数量。\n除非同时启用基于 SQLite 的窗口恢复，否则会很慢。"
          }
        }
      }
    },
    "ui.advanced.setting.Vs16Supported.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Support variation selector 16 making emoji fullwidth in all modes?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在所有模式中支持变体选择符 16 将表情符号设为全宽？"
          }
        }
      }
    },
    "ui.advanced.setting.Vs16SupportedInPrimaryScreen.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Support variation selector 16 making emoji fullwidth outside of alternate screen mode?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在备用屏幕模式以外，支持变体选择符 16 将表情符号设为全宽？"
          }
        }
      }
    },
    "ui.advanced.setting.FastTrackpad.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Trackpad scrolls fast?\nSet to No for legacy scrolling speed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "触控板快速滚动？\n设为“否”使用旧版滚动速度。"
          }
        }
      }
    },
    "ui.advanced.setting.SupportDecsetMetaSendsEscape.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Support DECSET 1036?\nThis allows apps in the terminal to control whether the option key sends esc+ or acts like a regular option key."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "支持 DECSET 1036？\n允许终端内的应用控制 Option 键发送 esc+，还是按普通 Option 键处理。"
          }
        }
      }
    },
    "ui.advanced.setting.FastTriggerRegexes.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fast regular expression evaluation for triggers.\nThis is experimental because it could potentially change how regular expressions are interpreted."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "快速评估触发器的正则表达式。\n可能改变正则表达式的解释方式，因此属于实验性功能。"
          }
        }
      }
    },
    "ui.advanced.setting.PostFakeFlagsChangedEvents.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Post fake flags-changed events when remapping modifiers with an event tap.\nThis is an attempt to work around incompatibilities with AltTab in issue 10220."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过事件监听重映射修饰键时，发送模拟的修饰键状态变化事件。\n尝试规避问题 10220 中与 AltTab 的不兼容。"
          }
        }
      }
    },
    "ui.advanced.setting.FullWidthFlags.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Flag emoji render full-width"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将旗帜表情符号渲染为全宽"
          }
        }
      }
    },
    "ui.advanced.setting.PreconvertStringsOnParserThread.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pre-convert non-ASCII strings to screen characters on the parser thread.\nThis exploits parallelism between parsing and screen mutation for better performance."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在解析线程中，将非 ASCII 字符串预转换为屏幕字符。\n利用解析与屏幕变更之间的并行性提高性能。"
          }
        }
      }
    },
    "ui.advanced.setting.AsyncPreconvertStrings.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pre-convert long non-ASCII strings on a background queue.\nThis decouples preconversion from the parser thread for better throughput."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在后台队列预转换较长的非 ASCII 字符串。\n将预转换与解析线程解耦，以提高吞吐量。"
          }
        }
      }
    },
    "ui.advanced.setting.AsyncPreconvertMinStringLength.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Minimum string length (in UTF-16 code units) to dispatch for async pre-conversion."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分派到异步预转换的最小字符串长度（UTF-16 码元）。"
          }
        }
      }
    },
    "ui.advanced.setting.AsyncPreconvertMaxOutstandingBytes.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Maximum bytes of outstanding async pre-conversions.\nWhen this limit is reached, new strings are converted synchronously on the mutation thread."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未完成的异步预转换最大字节数。\n达到上限时，新字符串改在变更线程同步转换。"
          }
        }
      }
    },
    "ui.advanced.setting.LogNonASCIIStringLengthHistogram.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Log a histogram of non-ASCII string lengths periodically.\nUseful for tuning the async pre-conversion minimum string length."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "定期记录非 ASCII 字符串长度直方图。\n用于调优异步预转换的最小字符串长度。"
          }
        }
      }
    },
    "ui.advanced.setting.AiModernModelPrefixes.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI model name substrings that use the modern 'completions' API.\nSubstrings should be space-delimited. This handles OpenRouter-style names like 'openai/gpt-4o'. Note that o1 models use a different API and have hard-coded behavior."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用现代“completions”API 的 AI 模型名称子字符串。\n用空格分隔。支持“openai/gpt-4o”等 OpenRouter 风格名称。注意：o1 模型使用另一套 API，行为在代码中固定。"
          }
        }
      }
    },
    "ui.advanced.setting.AiProxy.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Host and port for proxy for AI requests.\ni.e., example.com:8080"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 请求代理的主机和端口。\n例如 example.com:8080"
          }
        }
      }
    },
    "ui.advanced.setting.AddUtilitiesToPATH.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add path to iTerm2 utilities to $PATH for new sessions?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为新会话将 iTerm2 工具路径添加到 $PATH？"
          }
        }
      }
    },
    "ui.advanced.setting.AutoSearch.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatically search for selected text after making a selection?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选中文本后自动搜索？"
          }
        }
      }
    },
    "ui.advanced.setting.SmartLoggingWithAutoComposer.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable more compact logging when using auto composer?\nThis will avoid logging raw data in your prompt and your interactions with it. Instead, the prompt is logged once in plain text and the command is logged when sent."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用自动编辑器时启用更精简的日志？\n不再记录提示符及交互的原始数据；提示符仅以纯文本记录一次，命令在发送时记录。"
          }
        }
      }
    },
    "ui.advanced.setting.DisclaimChildren.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disclaim ownership of children.\nBy enabling this, when launching a Cocoa app from a terminal window TCC should attribute ownership to the app, not iTerm2, for permissions. In order for changes to this setting to take effect, you must kill iTermServer."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "放弃对子进程的归属声明。\n启用后，从终端窗口启动 Cocoa 应用时，TCC 的权限归属应指向该应用而非 iTerm2。更改后必须终止 iTermServer 才能生效。"
          }
        }
      }
    },
    "ui.advanced.setting.RestoreKeyModeAutomaticallyOnHostChange.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatically restore keyboard mode when an ssh session ends?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH 会话结束时自动恢复键盘模式？"
          }
        }
      }
    },
    "ui.advanced.setting.ChaseAnchoredScreen.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggressively keep windows on the screen they were configured to be on"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "积极将窗口保持在为其配置的屏幕上"
          }
        }
      }
    },
    "ui.advanced.setting.CodeciergeGhostRidingPrompt.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prompt to send to LLM for Codecierge when it is able to execute commands automatically.\n$GOAL and $CONTEXT are replaced with the user-specified goal and info about the running environment, respectively."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Codecierge 可自动执行命令时，发送给 LLM 的提示词。\n$GOAL 和 $CONTEXT 分别替换为用户指定的目标及运行环境信息。"
          }
        }
      }
    },
    "ui.advanced.setting.CodeciergeCommandWarningCount.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After this many commands, make codecierge confirm that you intend to keep it enabled."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "执行此数量的命令后，让 Codecierge 确认您仍希望保持其启用。"
          }
        }
      }
    },
    "ui.advanced.setting.CodeciergeRegularPrompt.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prompt to send to LLM for Codecierge when it is NOT able to execute commands automatically.\n$GOAL and $CONTEXT are replaced with the user-specified goal and info about the running environment, respectively."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Codecierge 无法自动执行命令时，发送给 LLM 的提示词。\n$GOAL 和 $CONTEXT 分别替换为用户指定的目标及运行环境信息。"
          }
        }
      }
    },
    "ui.advanced.setting.GenerativeAIAllowed.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow the use of large language model APIs?\nThe purpose of this setting is to make it easy for managed environments to disable the use of LLMs. The user defaults key is `GenerativeAIAllowed`."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许使用大语言模型 API？\n便于受管理环境禁用 LLM。User Defaults 键为 `GenerativeAIAllowed`。"
          }
        }
      }
    },
    "ui.advanced.setting.CompanionPairingAllowed.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow pairing a companion iOS device?\nOff by default while this feature is in development. When off, the Companion Device Settings menu item is hidden. Managed environments can also use this to disable the feature. The user defaults key is `CompanionPairingAllowed`."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许配对 iOS 伴侣设备？\n此功能开发期间默认关闭。关闭时隐藏“伴侣设备设置”菜单项。受管理环境也可用它禁用此功能。User Defaults 键为 `CompanionPairingAllowed`。"
          }
        }
      }
    },
    "ui.advanced.setting.CompanionRelayOrigin.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay origin for companion iOS device pairing.\nMust be a bare https origin (scheme and host, no path), such as https://companion-relay.iterm2.com. The relay is the only transport, so this must be set for pairing to work; forks can point it at their own Worker. Leave empty to disable the relay entirely. The user defaults key is `CompanionRelayOrigin`."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 伴侣设备配对使用的中继源站。\n必须是纯 https 源站（仅协议和主机，无路径），如 https://companion-relay.iterm2.com。中继是唯一传输通道，必须设置才能配对；Fork 可指向自己的 Worker。留空完全禁用中继。User Defaults 键为 `CompanionRelayOrigin`。"
          }
        }
      }
    },
    "ui.advanced.setting.CompanionResolverURL.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shard-map URL for companion iOS device pairing.\nAn https URL pointing directly at the static shard-map JSON, used to find the relay shard that serves the phone-to-mac connection. It is fetched verbatim (nothing is appended). Leave empty to use direct connections (such as if you run your own relay)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 伴侣设备配对使用的分片映射 URL。\n直接指向静态分片映射 JSON 的 https URL，用于查找处理手机与 Mac 连接的中继分片。按原地址获取，不附加任何内容。留空使用直连（例如自行运行中继时）。"
          }
        }
      }
    },
    "ui.advanced.setting.LlmPlatform.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "LLM Platform.\nLegal values are: OpenAI, Azure, Gemini. This determines the format of requests and responses."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "LLM 平台。\n有效值为 OpenAI、Azure、Gemini。决定请求和响应的格式。"
          }
        }
      }
    },
    "ui.advanced.setting.AiModelCatalogURL.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "URL to check for updates to the AI model catalog.\nThe catalog defines the built-in AI models (context window, capabilities, and the recommended model per vendor). iTerm2 periodically downloads a signed newer copy so new models become available without an app update. This happens only when AI features are enabled and you have granted permission; a non-empty URL by itself does not enable checking. Clearing this URL disables checking entirely."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查 AI 模型目录更新的 URL。\n目录定义内置 AI 模型的上下文窗口、能力和各服务商的推荐模型。iTerm2 会定期下载签名的新版本，无需更新应用即可获得新模型。仅在启用 AI 功能且已授权时执行；URL 非空本身不会启用检查。清空 URL 可完全禁用检查。"
          }
        }
      }
    },
    "ui.advanced.setting.AquaSKKBugfixEnabled.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable AquaSKK bugfix?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用 AquaSKK 问题修复？"
          }
        }
      }
    },
    "ui.advanced.setting.ChannelsEnabled.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable Channels feature?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用 Channels 功能？"
          }
        }
      }
    },
    "ui.advanced.setting.RightJustifyRTLLines.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Right-justify lines in paragraphs with base writing direction of right-to-left?\nRequires BOTH “right-to-left text support” and “auto-detect paragraph writing detection” to be enabled."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "基本书写方向为从右到左的段落，其各行右对齐？\n必须同时启用“支持从右到左文本”和“自动检测段落书写方向”。"
          }
        }
      }
    },
    "ui.advanced.setting.DetectParagraphDirection.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto-detect paragraph writing direction based on the first strong directional character?\nRequires right-to-left text support to be enabled."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "根据第一个具有明确方向性的字符，自动检测段落书写方向？\n需要启用从右到左文本支持。"
          }
        }
      }
    },
    "ui.advanced.setting.DisableBidiInAlternateScreen.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do not reorder right-to-left text in the alternate screen?\nFull-screen apps (editors and some CLIs) position their own text and may already order it for display, so reordering it again fights their layout. Turn this on to leave alternate-screen text unreordered. Requires right-to-left text support."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不对备用屏幕中的从右到左文本重新排序？\n全屏应用（编辑器及部分命令行工具）自行定位文本，可能已为显示排好顺序；再次重排会破坏布局。开启后保留备用屏幕文本的顺序。需要从右到左文本支持。"
          }
        }
      }
    },
    "ui.advanced.setting.BrowserProfiles.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable browser-style profiles?\nYou must restart iTerm2 for this to take effect."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用浏览器式配置文件？\n必须重新启动 iTerm2 才能生效。"
          }
        }
      }
    },
    "ui.advanced.setting.CompanionStreamFrameNumbers.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stamp frame numbers into the iTerm2 Buddy live stream?\nDraws a monotonic counter onto each streamed video frame, for debugging the phone’s live session view."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 iTerm2 Buddy 实时流中标注帧号？\n为每个传输的视频帧绘制单调递增计数，用于调试手机端实时会话视图。"
          }
        }
      }
    },
    "ui.advanced.setting.CompanionStreamMaxLeadMilliseconds.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iTerm2 Buddy live stream: maximum capture-time lead, in milliseconds.\nThe host stops sending new frames once it is more than this far ahead of the last frame the phone acknowledged, then resumes when the phone catches up. Larger values tolerate more link latency at the cost of a live view that can lag further behind. Only the frame rate is affected; per-frame quality is unchanged."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iTerm2 Buddy 实时流：采集时间最多领先多少毫秒。\n主机相对于手机最后确认的帧超过此领先量时，停止发送新帧；手机赶上后恢复。较大值可容忍更多链路延迟，但实时视图也可能落后更多。只影响帧率，不改变单帧质量。"
          }
        }
      }
    },
    "ui.advanced.setting.CompanionStreamMaxQueueDepth.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iTerm2 Buddy live stream: maximum phone decode-queue depth.\nThe host stops sending new frames once the phone reports more than this many frames queued for decode/display, then resumes as the queue drains. Larger values let more frames pile up on the phone before backing off. Only the frame rate is affected; per-frame quality is unchanged."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iTerm2 Buddy 实时流：手机解码队列的最大深度。\n手机报告等待解码或显示的帧数超过此值时，主机停止发送新帧，待队列减少后恢复。较大值允许手机积压更多帧后再退让。只影响帧率，不改变单帧质量。"
          }
        }
      }
    },
    "ui.advanced.setting.CompanionStreamBitrateMultiplier.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iTerm2 Buddy live stream: video bitrate multiplier.\nScales the resolution-derived encoder bitrate. Values above 1 make streamed text sharper at the cost of bandwidth; values below 1 save bandwidth at the cost of sharpness. The result is still clamped to the stream’s minimum and ceiling bitrates."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iTerm2 Buddy 实时流：视频码率倍数。\n缩放由分辨率计算的编码码率。大于 1 可使传输文字更清晰，但消耗更多带宽；小于 1 可节省带宽，但降低清晰度。结果仍受流的最低和最高码率限制。"
          }
        }
      }
    },
    "ui.advanced.setting.CompanionWakeupCoalesceInterval.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iTerm2 Buddy push notifications: minimum seconds between wakeup pushes.\nA wakeup push tells the paired phone to fetch every new message and alert at once, so several in quick succession are wasteful and can leave a later one with nothing to show (the generic “Your agent has an update.” placeholder). The host sends the first wakeup immediately, then coalesces any that follow within this interval into a single trailing wakeup. Lower values notify sooner but coalesce less; higher values coalesce bursts more aggressively."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iTerm2 Buddy 推送通知：两次唤醒推送的最小间隔（秒）。\n唤醒推送让已配对手机一次获取所有新消息和提醒。短时间连续推送会浪费资源，也可能使后续推送没有新内容可显示，只出现通用的“您的智能体有新进展。”占位消息。主机立即发送首次唤醒，将此间隔内的后续请求合并为一次延后的唤醒。较小值通知更快但合并更少；较大值会更积极地合并突发请求。"
          }
        }
      }
    },
    "ui.advanced.setting.PythonRuntimeDownloadURL.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "URL to check for new versions of the Python scripting runtime."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查 Python 脚本运行时新版本的 URL。"
          }
        }
      }
    },
    "ui.advanced.setting.UvManifestDownloadURL.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "URL of the uv download manifest (used when the Python runtime is provisioned with uv)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "uv 下载清单的 URL（使用 uv 配置 Python 运行时时使用）。"
          }
        }
      }
    },
    "ui.advanced.setting.PythonRuntimeBetaDownloadURL.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "URL to check for new Beta versions of the Python scripting runtime."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查 Python 脚本运行时新 Beta 版本的 URL。"
          }
        }
      }
    },
    "ui.advanced.setting.LaxNilPolicyInInterpolatedStrings.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Should references to undefined variables in interpolated strings be converted to empty string?\nWhen enabled, an expression in an interpolated string that references an undefined variable will be treated as an empty string. For example, “\\(bogus)”. References to undefined variables as arguments to function calls, such as “\\(f(bogus))”, are still errors."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将插值字符串中对未定义变量的引用转换为空字符串？\n启用后，插值字符串中的表达式若引用未定义变量（例如“\\(bogus)”），会视为空字符串。作为函数参数引用未定义变量（如“\\(f(bogus))”）仍会报错。"
          }
        }
      }
    },
    "ui.advanced.setting.PythonRuntimeUsesUV.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use uv to provision the Python runtime for API scripts?\nWhen enabled, iTerm2 uses uv to download Python and build per-script environments instead of the bundled Python runtime. Scripts already provisioned continue to run regardless of this setting; it only affects creating, importing, and migrating scripts."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 uv 为 API 脚本配置 Python 运行时？\n启用后，iTerm2 使用 uv 下载 Python 并为每个脚本建立环境，而不是使用随附的 Python 运行时。已配置的脚本不受此设置影响，仍可运行；仅影响创建、导入和迁移脚本。"
          }
        }
      }
    },
    "ui.advanced.setting.SetCookie.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set ITERM2_COOKIE environment variable, allowing Python scripts to be launched without confirmation?\nThis will only affect sessions created after changing this setting."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置 ITERM2_COOKIE 环境变量，允许不经确认启动 Python 脚本？\n只影响更改后创建的会话。"
          }
        }
      }
    },
    "ui.advanced.setting.SetIT2AppPath.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set IT2_APP_PATH environment variable on new sessions, pointing at this iTerm2 build’s app bundle?\nThis disambiguates the AppleScript target when multiple iTerm2 builds with the same bundle identifier are running, so that the “it2” CLI requests its cookie from this iTerm2 instance. Intended for iTerm2 developers. Only affects sessions created after changing this setting."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为新会话设置 IT2_APP_PATH 环境变量，指向此 iTerm2 构建的应用包？\n多个相同 Bundle ID 的 iTerm2 构建同时运行时，可明确 AppleScript 目标，使“it2”命令行工具向当前 iTerm2 实例请求 cookie。供 iTerm2 开发者使用。只影响更改后创建的会话。"
          }
        }
      }
    },
    "settings.general.language.accessibility_label": {
      "comment": "Accessibility label for the application language pop-up button in Settings.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Application language"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用界面语言"
          }
        }
      }
    },
    "settings.general.language.action.ok": {
      "comment": "Dismisses a language preference notice.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OK"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "好"
          }
        }
      }
    },
    "settings.general.language.error.missing_application_domain": {
      "comment": "Error shown when the application preferences domain is unavailable.",
      "extractionState": "manual",
      "localizations": {
