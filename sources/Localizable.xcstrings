    "ui.settings.profilepreferencesviewcontroller.a_required_user_interface_component_is_missing_or.1cb830a6": {
      "comment": "User-facing text in ProfilePreferencesViewController (warnAboutCorruptNib).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A required user interface component is missing or corrupted and iTerm2’s code signature could not be verified. You should download a fresh copy of the app and reinstall it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "缺少必要的用户界面组件或该组件已损坏，并且无法验证 iTerm2 的代码签名。请重新下载应用并安装。"
          }
        }
      }
    },
