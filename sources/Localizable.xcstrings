    "ui.browser.page.onboarding.profile.note_description": {
      "comment": "User-facing text on an iTerm2 Browser onboarding page.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can create multiple browser profiles with different settings for different use cases. Each profile can have its own keyboard shortcuts and browser-specific configurations."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以为不同用途创建多个浏览器配置文件，每个配置文件都可拥有自己的键盘快捷键和浏览器专用设置。"
          }
        }
      }
    },
    "ui.browser.page.onboarding.profile.page_title": {
      "comment": "User-facing text on an iTerm2 Browser onboarding page.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iTerm2 Browser - Create Profile"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iTerm2 浏览器 - 创建配置文件"
          }
        }
      }
    },
    "ui.browser.page.onboarding.profile.profile_description": {
      "comment": "User-facing text on an iTerm2 Browser onboarding page.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A browser profile stores all your preferences and settings specifically for web browsing. This keeps your terminal and browser configurations separate and organized."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "浏览器配置文件专门存储网页浏览的所有偏好和设置，使终端与浏览器配置相互独立、井然有序。"
          }
        }
      }
    },
