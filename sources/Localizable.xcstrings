    "ui.statusbar.components.itermstatusbarjobcomponent.shows_the_currently_running_job_if_space_permits_parent_process_names_are_also_shown.628279e1": {
      "comment": "Status bar component description.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows the currently running job. If space permits, parent process names are also shown."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示当前运行的作业。空间足够时还会显示父进程名称。"
          }
        }
      }
    },
