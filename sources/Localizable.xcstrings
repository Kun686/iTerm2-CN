    "ui.settings.profilepreferencesviewcontroller.dynamic_profile_warning": {
      "comment": "Warning before editing a non-rewritable dynamic profile.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The selected profile, “%@”, is a dynamic profile. These are generally only edited by hand.\n\niTerm2 is now able to write changes back to dynamic profiles when they are marked as “rewritable“. Rewriting can cause the order of values to change."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选配置文件“%@”是动态配置文件，通常只应手动编辑。\n\niTerm2 现在可以将更改写回标记为“可重写”的动态配置文件。重写可能会改变值的顺序。"
          }
        }
      }
    },
