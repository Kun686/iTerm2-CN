    "ui.terminalview.pseudoterminal.kill_all_tmux_windows_and_their_jobs_hide.a69fad36": {
      "comment": "User-facing tmux window close warning.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kill all tmux windows and their jobs, hide windows from view, or detach from tmux session?\n\nHidden windows may be restored from the tmux dashboard."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要终止所有 tmux 窗口及其中的作业、隐藏窗口，还是断开 tmux 会话？\n\n可从 tmux 仪表板恢复隐藏的窗口。"
          }
        }
      }
    },
    "ui.terminalview.pseudoterminal.kill_tmux_window_terminating_its_jobs_or_hide.b76eee75": {
      "comment": "User-facing warning message.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kill tmux window, terminating its jobs, or hide it? Hidden windows may be restored from the tmux dashboard."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要终止 tmux 窗口及其中的作业，还是隐藏它？可从 tmux 仪表板恢复隐藏的窗口。"
          }
        }
      }
    },
    "ui.terminalview.pseudoterminal.kill_window_and_its_jobs_hide_window_from.e9cdba58": {
