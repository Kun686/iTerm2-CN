      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kill window and its jobs, hide window from view, or detach from tmux session?\n\nHidden windows may be restored from the tmux dashboard."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要终止窗口及其作业、隐藏窗口，还是断开 tmux 会话？\n\n可从 tmux 仪表板恢复隐藏的窗口。"
