    "ui.advanced.setting.ClippingSeparator.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Separator inserted between multiple clippings when sending or copying them.\nThe value should use Vim syntax, such as \\n for newline and \\e for escape."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发送或复制多个剪辑时，在它们之间插入的分隔符。\n此值使用 Vim 语法，例如 \\n 表示换行，\\e 表示 Escape。"
          }
        }
      }
    },
    "ui.advanced.setting.WorkgroupAutoSendSubmitDelay.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delay in seconds before the Return that submits an auto-sent code review.\nWhen the code-review workgroup toolbar auto-sends review results to the main session, it pastes the results and then sends a Return to submit them. This is how long it waits, after the pasted results finish, before sending that Return. A paste-debouncing TUI (such as Claude Code) processes a paste and a Return that arrive together as one batch, so the Return can be swallowed and the review never submits; the delay makes the Return land in a later read so it submits. The default matches Claude Code’s 500 ms paste-settling window. Set to 0 to send it immediately."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动发送代码审查后，发送用于提交的 Return 键之前的延迟（秒）。\n代码审查工作组工具栏自动将审查结果发送到主会话时，会先粘贴结果，再发送 Return 提交。此值指定粘贴完成到发送 Return 的等待时间。带粘贴防抖的 TUI（如 Claude Code）会将同时到达的粘贴与 Return 作为同一批处理，可能吞掉 Return，使审查始终未提交；延迟可让 Return 在后一次读取中到达并提交。默认值匹配 Claude Code 的 500 毫秒粘贴稳定窗口。设为 0 则立即发送。"
          }
        }
      }
    },
    "ui.advanced.setting.DisallowCopyEmptyString.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disallow copying empty string to pasteboard.\nIf enabled, selecting an empty string (or all whitespace if trimming is enabled) will not erase the contents of the pasteboard."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不允许将空字符串复制到剪贴板。\n启用后，选择空字符串（启用去除空白时也包括全空白文本）不会清空剪贴板。"
          }
        }
      }
    },
