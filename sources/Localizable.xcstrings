    "ui.terminalview.pseudoterminal.if_this_is_empty_the_tab_takes_the.76bd0d7b": {
      "comment": "User-facing text in PseudoTerminal (openEditTabTitleWindow).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If this is empty, the tab takes the active session’s title. Variables and function calls enclosed in \\(…) will be replaced with their evaluation. This interpolated string is evaluated in the tab’s context."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果留空，标签页将使用活动会话的标题。括在 \\(…) 中的变量和函数调用会替换为其求值结果。此插值字符串在标签页上下文中求值。"
          }
        }
      }
    },
    "ui.terminalview.pseudoterminal.if_this_is_empty_the_window_takes_the.b0e63e62": {
      "comment": "User-facing text in PseudoTerminal (editWindowTitle:).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If this is empty, the window takes the active session’s title. Variables and function calls enclosed in \\(…) will be replaced with their evaluation. This interpolated string is evaluated in the window’s context."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果留空，窗口将使用活动会话的标题。括在 \\(…) 中的变量和函数调用会替换为其求值结果。此插值字符串在窗口上下文中求值。"
          }
        }
      }
    },
