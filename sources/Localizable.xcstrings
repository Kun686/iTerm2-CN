    "ui.hotkey.itermhotkeymigrationhelper.you_have_dynamic_profiles_whose_dynamic_profile_parent_name_is_set_to_yo.bb8eb57d": {
      "comment": "User-facing text in iTermHotKeyMigrationHelper (indirect UI).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You have dynamic profiles whose “Dynamic Profile Parent Name” is set to your hotkey window's profile, “%@.” Because multiple hotkey windows are now supported, the hotkey will now toggle a separate window for each of these profiles. Please update your dynamic profiles appropriately. The affected profiles are:\n%@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的动态配置文件将“Dynamic Profile Parent Name”设为了热键窗口的配置文件“%@”。由于现在支持多个热键窗口，热键将为这些配置文件分别切换一个窗口。请相应更新动态配置文件。受影响的配置文件：\n%@"
          }
        }
      }
    },
    "ui.hotkey.itermhotkeymigrationhelper.your_hotkey_window_s_profile_is_a_dynamic_profile_named_it_needs_to_be_u.995d8a3d": {
      "comment": "User-facing text in iTermHotKeyMigrationHelper (indirect UI).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your hotkey window‘s profile is a dynamic profile named “%@.” It needs to be updated for this version of iTerm2 because hotkey settings are now stored in the profile."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "热键窗口的配置文件是名为“%@”的动态配置文件。此版本的 iTerm2 需要更新它，因为热键设置现在存储在配置文件中。"
          }
        }
      }
    },
