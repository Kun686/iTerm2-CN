    "ui.settings.key_mapping_repair.message.plural": {
      "comment": "User-facing text in iTermKeyMappingRepair.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This will repair %1$lld key bindings that were corrupted by a bug in an earlier version of iTerm2. The affected bindings currently display incorrectly but function properly. After repair, they will display correctly.\n\nAffected key bindings:\n%2$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "即将修复由旧版 iTerm2 中的缺陷损坏的 %1$lld 个按键绑定。受影响的按键绑定目前显示不正确，但功能正常。修复后将正确显示。\n\n受影响的按键绑定：\n%2$@"
          }
        }
      }
    },
