    "ui.browser.page.onboarding.intro.how_it_works.description": {
      "comment": "User-facing text on an iTerm2 Browser onboarding page.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you create a new tab or split pane using a browser profile, you get a fully-featured web browser instead of a terminal. Mix and match browser and terminal panes however you like: they’re all part of the same iTerm2 experience."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用浏览器配置文件新建标签页或分割窗格时，打开的将是功能完整的网页浏览器，而不是终端。你可以任意组合浏览器与终端窗格，它们都是同一 iTerm2 体验的一部分。"
          }
        }
      }
    },
    "ui.browser.page.onboarding.intro.how_it_works.title": {
      "comment": "User-facing text on an iTerm2 Browser onboarding page.",
