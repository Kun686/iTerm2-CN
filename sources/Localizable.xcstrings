    "ui.browser.page.onboarding.setup.ad_blocker.description": {
      "comment": "User-facing text on an iTerm2 Browser onboarding page.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blocks ads and trackers using WebKit content blockers. Improves browsing speed and privacy without sacrificing compatibility. If enabled, a new block list will be downloaded from the internet once a day."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 WebKit 内容拦截器拦截广告和跟踪器，在不影响兼容性的情况下提升浏览速度和隐私。启用后，每天会从互联网下载一次新的拦截列表。"
          }
        }
      }
    },
    "ui.browser.page.onboarding.setup.ad_blocker.enable": {
      "comment": "User-facing text on an iTerm2 Browser onboarding page.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable Ad Blocker"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用广告拦截器"
          }
        }
      }
    },
    "ui.browser.page.onboarding.setup.ad_blocker.title": {
      "comment": "User-facing text on an iTerm2 Browser onboarding page.",
