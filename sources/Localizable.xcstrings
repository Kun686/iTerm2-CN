    "ui.browser.page.onboarding.features.title": {
      "comment": "User-facing text on an iTerm2 Browser onboarding page.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What Can It Do?"
