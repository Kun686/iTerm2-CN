        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This removes the cc-status hook from ~/.claude/settings.json, the Claude Code workgroup from your settings, and the Enter/Exit Workgroup triggers from every profile. You can reinstall any time using iTerm2 > Install Claude Code Integration."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会从 ~/.claude/settings.json 中移除 cc-status 钩子，从设置中移除 Claude Code 工作组，并从所有配置文件中移除“进入/退出工作组”触发器。您可以随时通过 iTerm2 > 安装 Claude Code 集成重新安装。"
          }
        }
      }
    },
