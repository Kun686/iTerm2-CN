    "ui.shell_integration.steps.xonsh_step": {"comment":"Display-only installer step fragment; keep format arguments and shell names unchanged.","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Step %d. Xonsh auto-loads scripts from rc.d (no dotfile update needed)."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"第 %d 步：Xonsh 会从 rc.d 自动加载脚本（无需更新配置文件）。"}}}},
    "ui.shell_integration.steps.xonsh_done": {"comment":"Display-only installer step fragment; keep format arguments and shell names unchanged.","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"✅ Xonsh auto-loads scripts from rc.d (no dotfile update needed)."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"✅ Xonsh 会从 rc.d 自动加载脚本（无需更新配置文件）。"}}}},
    "ui.shell_integration.steps.update_step": {"comment":"Display-only installer step fragment; keep format arguments and shell names unchanged.","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Step %d. Update"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"第 %d 步：更新"}}}},
