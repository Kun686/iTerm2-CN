    "ui.swift.aiterm.remotecommand_mac.until_now_iterm2_checked_the_safety_of_ai.1fc5b44a": {
      "comment": "User-facing text in RemoteCommand+Mac.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Until now, iTerm2 checked the safety of AI-suggested commands on your Mac using Apple Intelligence, at no cost. It can now use your configured AI model instead, which is more accurate but sends each checked command to your AI provider and may incur charges.\n\nSwitch to your configured model? If you decline, iTerm2 keeps using Apple Intelligence."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此前，iTerm2 一直使用 Mac 上的 Apple 智能免费检查 AI 建议命令的安全性。现在可以改用您配置的 AI 模型，结果更准确，但会将每条受检查的命令发送给 AI 提供商，并可能产生费用。\n\n要切换到您配置的模型吗？如果拒绝，iTerm2 将继续使用 Apple 智能。"
          }
        }
      }
    },
