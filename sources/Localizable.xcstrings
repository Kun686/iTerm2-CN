    "ui.terminalview.pseudoterminal.tab_context_mistake_help": {
      "comment": "Help shown when a session variable is used in a tab title expression.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This interpolated string is evaluated in the tab’s context, not the session’s context. To access variables in the current session, use currentSession.sessionVariableNameHere"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此插值字符串在标签页上下文中求值，而非会话上下文。若要访问当前会话中的变量，请使用 currentSession.sessionVariableNameHere。"
          }
        }
      }
    },
