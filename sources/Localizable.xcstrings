    "ui.keyboard.itermsecurekeyboardentrycontroller.secure_keyboard_entry_is_enabled_in_macos_12.535e58a4": {
      "comment": "User-facing warning message.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Secure keyboard entry is enabled.\n\nIn macOS 12 and later, enabling Secure Keyboard Entry prevents other programs from being activated. This affects the `open` command as well as the panel shown when using Touch ID for sudo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已启用安全键盘输入。\n\n在 macOS 12 及更高版本中，启用安全键盘输入会阻止激活其他程序。这也会影响 `open` 命令，以及通过 Touch ID 使用 sudo 时显示的面板。"
          }
        }
      }
    },
