      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Done"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完成"
          }
        }
      }
    },
    "ui.swift.appkit.itermsuppressedalertswindowcontroller.last_suppressed.130b02e8": {
      "comment": "User-facing text in iTermSuppressedAlertsWindowController.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Last Suppressed"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最近禁止显示"
          }
        }
      }
    },
    "ui.swift.appkit.itermsuppressedalertswindowcontroller.no_alerts_are_currently_being_suppressed.472b057f": {
      "comment": "User-facing text in iTermSuppressedAlertsWindowController.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No alerts are currently being suppressed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前没有被抑制的提醒。"
          }
        }
      }
    },
    "ui.swift.appkit.itermsuppressedalertswindowcontroller.suppressed_alerts.b90033d7": {
      "comment": "User-facing text in iTermSuppressedAlertsWindowController.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Suppressed Alerts"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已禁止显示的提醒"
          }
        }
      }
    },
    "ui.appkit.suppressed_alerts.explanation": {
      "comment": "Explains why alerts are suppressed and how to make one appear again.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These alerts are being answered automatically because you chose to remember your response. Select one and click Un-suppress to be asked again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由于您选择了记住响应，这些提醒会自动作答。请选择一个提醒，然后点按“取消禁止显示”，以便再次收到询问。"
          }
        }
      }
    },
    "ui.swift.appkit.itermsuppressedalertswindowcontroller.un_suppress.b5f0d794": {
      "comment": "User-facing text in iTermSuppressedAlertsWindowController.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Un-suppress"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消禁止显示"
          }
        }
      }
    },
    "ui.swift.appkit.itermsuppressedalertswindowcontroller.un_suppress_all.401cf23c": {
      "comment": "User-facing text in iTermSuppressedAlertsWindowController.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Un-suppress All"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全部取消禁止显示"
          }
        }
      }
    },
    "ui.swift.appkit.itermsuppressedalertswindowcontroller.when_you_check_remember_my_choice_or_suppress.9516ec79": {
      "comment": "User-facing text in iTermSuppressedAlertsWindowController.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you check “Remember my choice” or “Suppress this message permanently” in an alert, iTerm2 stops showing it and reuses your saved response. Turn this on to show those alerts again so you can see them or choose differently. It stays on until you turn it off."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当您在提醒中勾选“记住我的选择”或“永久禁止显示此消息”时，iTerm2 将不再显示该提醒，并重复使用已保存的响应。开启此选项可再次显示这些提醒，以便查看或重新选择。此设置会一直保持开启，直到您将其关闭。"
          }
        }
      }
    },
    "ui.swift.appkit.profiledocument.cancel.19766ed6": {
      "comment": "User-facing text in ProfileDocument.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消"
          }
        }
      }
    },
    "ui.swift.appkit.profiledocument.open_0.e71b4013": {
      "comment": "User-facing text in ProfileDocument.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open %1$@"
          }
        },
        "zh-Hans": {
