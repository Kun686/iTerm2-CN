    "ui.swift.claudecode.claudecodeonboarding.install_a_claude_code_hook_that_lets_iterm2.926e5dcb": {
      "comment": "User-facing text in ClaudeCodeOnboarding.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install a Claude Code hook that lets iTerm2 detect Claude’s state (working, waiting, idle) and display it in the Session Status tool.\n\nThis adds a hook to your Claude Code settings that runs automatically as Claude works."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安装 Claude Code 钩子，使 iTerm2 能检测 Claude 的状态（正在工作、正在等待、空闲），并在“会话状态”工具中显示。\n\n这会在 Claude Code 设置中添加一个钩子，并在 Claude 工作时自动运行。"
          }
        }
      }
    },
    "ui.swift.claudecode.claudecodeonboarding.install_auto_enter_triggers.f1a13418": {
