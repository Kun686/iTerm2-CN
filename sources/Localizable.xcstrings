    "ui.filetransfer.scpfile.remote_host_identification_has_changed_the_key_fingerprint.a23031e7": {
      "comment": "User-facing host-key mismatch security warning; preserve the host, hash name, and fingerprint.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "REMOTE HOST IDENTIFICATION HAS CHANGED!\n\nThe %@ key fingerprint of host '%@' has changed. It is %@.\n\nSomeone could be eavesdropping on you right now (man-in-the-middle attack)!\nIt is also possible that a host key has just been changed.\nConnect anyway?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "远程主机身份已更改！\n\n主机“%@”的 %@ 密钥指纹已更改，当前指纹为 %@。\n\n可能有人正在窃听您的连接（中间人攻击）！\n也可能只是主机密钥刚刚发生了更改。\n仍要连接吗？"
          }
        }
      }
    },
