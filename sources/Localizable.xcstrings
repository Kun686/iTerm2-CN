    "ui.shell_integration.steps.discover_next": {"comment":"Display-only installer step fragment; keep format arguments and shell names unchanged.","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"➡ Select “Continue” to discover"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"➡ 选择“继续”以检测"}}}},
    "ui.shell_integration.steps.unsupported": {"comment":"Display-only installer step fragment; keep format arguments and shell names unchanged.","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"🛑 Your shell is not supported.\n\nOnly bash, fish, tcsh, xonsh, and zsh work with shell integration"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"🛑 不支持你的 Shell。\n\nShell 集成仅支持 bash、fish、tcsh、xonsh 和 zsh"}}}},
    "ui.shell_integration.steps.discovered": {"comment":"Display-only installer step fragment; keep format arguments and shell names unchanged.","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"✅ Discovered"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"✅ 已识别"}}}},
    "ui.shell_integration.steps.shell_suffix": {"comment":"Display-only installer step fragment; keep format arguments and shell names unchanged.","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"%@ your shell"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"%@你的 Shell"}}}},
    "ui.shell_integration.steps.shell_detected_suffix": {"comment":"Display-only installer step fragment; keep format arguments and shell names unchanged.","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":": you use “%@”."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"：使用的是“%@”。"}}}},
