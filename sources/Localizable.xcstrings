    "ui.browser.page.settings.dev_null.description": {
      "comment": "User-facing text on the iTerm2 Browser settings page.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This profile is in /dev/null mode. Cookies, history, and all other browser data are stored in RAM and will be lost when the tab is closed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此配置文件处于 /dev/null 模式。Cookie、历史记录及其他所有浏览器数据均存储在内存中，并会在标签页关闭时丢失。"
          }
        }
      }
    },
