          "stringUnit": {
            "state": "translated",
            "value": "The script “%1$@” was written for Python %2$@, which is no longer available, so it now uses Python %3$@. Python versions are not always compatible across releases, so a bumped script may need small changes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "脚本“%1$@”原本为 Python %2$@ 编写，但该版本已不可用，因此现在改用 Python %3$@。不同版本的 Python 并不总是兼容，因此升级版本后的脚本可能需要少量修改。"
          }
        }
      }
    },
