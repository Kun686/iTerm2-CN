    "ui.browser.page.onboarding.features.productivity.description": {
      "comment": "User-facing text on an iTerm2 Browser onboarding page.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Instant replay, global search, named marks, and the Composer bring iTerm2 features into the browser."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "即时回放、全局搜索、命名标记和 Composer 将 iTerm2 的功能带入浏览器。"
          }
        }
      }
    },
    "ui.browser.page.onboarding.features.productivity.title": {
      "comment": "User-facing text on an iTerm2 Browser onboarding page.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Productivity Tools:"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "效率工具："
          }
        }
      }
    },
    "ui.browser.page.onboarding.features.secondary.description": {
      "comment": "User-facing text on an iTerm2 Browser onboarding page.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iTerm2 doesn’t expect to be your primary browser. The purpose is to complement the terminal and facilitate particular tasks that other browser can’t."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iTerm2 并不打算成为你的主浏览器。它旨在补充终端，并帮助完成其他浏览器无法处理的特定任务。"
          }
        }
      }
    },
