    "ui.swift.workgroups.sessionview_diffwaitingpromptoverlay.reload_queued_waiting_for_changes.5131b4b0": {
      "comment": "User-facing text in SessionView+DiffWaitingPromptOverlay.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reload queued. Waiting for changes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已将重新加载加入队列，正在等待更改。"
          }
        }
      }
    },
    "ui.swift.workgroups.sessionview_diffwaitingpromptoverlay.this_session_is_set_to_diff_mode_and.dbd142a8": {
      "comment": "User-facing text in SessionView+DiffWaitingPromptOverlay.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This session is set to Diff mode and only starts its command when git reports staged or unstaged changes. The working tree is currently clean, or iTerm2 hasn’t finished its first check yet. Edit a file (or stage one) and the command will start on its own. To run it now anyway, click below."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此会话设置为差异模式，只有在 git 报告存在已暂存或未暂存的更改时才会启动命令。当前工作树没有更改，或者 iTerm2 尚未完成首次检查。编辑或暂存文件后，命令将自动启动。要立即运行，请点按下方按钮。"
          }
        }
      }
    },
    "ui.swift.workgroups.sessionview_diffwaitingpromptoverlay.this_session_is_set_to_diff_mode_so.b5b74e95": {
      "comment": "User-facing text in SessionView+DiffWaitingPromptOverlay.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This session is set to Diff mode, so Reload will re-run the command only after git reports staged or unstaged changes. The previous output is still on screen behind this panel. Cancel to keep that output and abandon the reload, or run the command now anyway."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此会话设置为差异模式，因此只有在 git 报告存在已暂存或未暂存的更改后，“重新加载”才会再次运行命令。先前的输出仍显示在此面板后方。点按“取消”可保留该输出并放弃重新加载，也可以立即运行命令。"
          }
        }
      }
    },
