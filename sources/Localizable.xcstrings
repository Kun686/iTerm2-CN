          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "始终显示已记住选择的提醒"
          }
        }
      }
    },
    "ui.swift.appkit.itermsuppressedalertswindowcontroller.automatic_response.ff2ec0d5": {
      "comment": "User-facing text in iTermSuppressedAlertsWindowController.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic Response"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动响应"
          }
        }
      }
    },
    "ui.swift.appkit.itermsuppressedalertswindowcontroller.done.11a6767d": {
      "comment": "User-facing text in iTermSuppressedAlertsWindowController.",
