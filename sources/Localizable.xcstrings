    "ui.swift.aiterm.aimodelcatalogupdater.iterm2_can_keep_its_built_in_list_of.1b6a250d": {
      "comment": "User-facing text in AIModelCatalogUpdater.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iTerm2 can keep its built-in list of AI models current by periodically downloading a cryptographically signed list from iterm2.com. No terminal content or personal data is sent. Allow this?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iTerm2 可以通过定期从 iterm2.com 下载经过加密签名的列表，使内置 AI 模型列表保持最新。不会发送终端内容或个人数据。允许这样做吗？"
          }
        }
      }
    },
