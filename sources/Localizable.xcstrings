      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Explain the output of %1$@ based on [attached terminal content](%2$@)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请根据[附加的终端内容](%2$@)解释 %1$@ 的输出。"
