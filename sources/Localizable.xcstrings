          "stringUnit": {
            "state": "translated",
            "value": "应用偏好设置域不可用，无法保存应用界面语言。"
          }
        }
      }
    },
    "settings.general.language.error.save_failed": {
      "comment": "Underlying error when the application language preference cannot be persisted.",
      "extractionState": "manual",
