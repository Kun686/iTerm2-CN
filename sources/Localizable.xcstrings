    "ui.ptysession.ptysession.a_keyboard_shortcut_didn_t_run_because_this.7ebfa33a": {
      "comment": "User-facing warning message.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A keyboard shortcut didn’t run because this physical key now produces a different character than it did when the shortcut was created, usually after switching keyboard layout or input method. Matching key bindings by physical key makes shortcuts work regardless of the character a key produces. This affects all key bindings; you can change it later in Settings > Keys."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "键盘快捷键未能运行，因为当前物理按键生成的字符与创建快捷键时不同，这通常发生在切换键盘布局或输入法后。按物理按键匹配键绑定，可使快捷键不受按键生成字符的影响。此设置会影响所有键绑定；你可以稍后在“设置”>“按键”中更改。"
          }
        }
      }
    },
    "ui.ptysession.ptysession.a_previous_detach_request_has_not_yet_been.d5b6cc54": {
