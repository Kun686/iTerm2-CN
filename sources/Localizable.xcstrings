    "ui.swift.claudecode.claudecodeonboarding.pick_the_profiles_you_ll_run_claude_in.b0e7636d": {
      "comment": "User-facing text in ClaudeCodeOnboarding.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick the profiles you’ll run claude in. We’ll add Enter/Exit Workgroup triggers to each one so the Claude Code workgroup is entered automatically."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择要在其中运行 claude 的配置文件。我们会为每个配置文件添加“进入/退出工作组”触发器，以自动进入 Claude Code 工作组。"
          }
        }
      }
    },
    "ui.swift.claudecode.claudecodeonboarding.pick_the_terminal_profiles_where_you_run_claude.404e9689": {
      "comment": "User-facing text in ClaudeCodeOnboarding.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick the terminal profiles where you run claude. iTerm2 will add triggers so the Claude Code workgroup is entered automatically when claude starts and exited when it stops.\n\nWithout this, you can still enter the workgroup manually via Shell > Workgroups > Claude Code."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择用于运行 claude 的终端配置文件。iTerm2 将添加触发器，以便在 claude 启动时自动进入 Claude Code 工作组，并在其停止时退出。\n\n即使不这样设置，您仍可通过“Shell”>“工作组”>“Claude Code”手动进入工作组。"
          }
        }
      }
    },
    "ui.swift.claudecode.claudecodeonboarding.show.0df6f1ca": {
