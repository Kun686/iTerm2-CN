    "ui.settings.generalpreferencesviewcontroller.system_window_restoration_has_been_disabled_which_prevents.cd072a02": {
      "comment": "User-facing localized text in GeneralPreferencesViewController.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System window restoration has been disabled, which prevents iTerm2 from respecting this setting. Disable System Settings > General > Close windows when quitting an app to enable window restoration."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统窗口恢复功能已被停用，因此 iTerm2 无法遵循此设置。请停用“系统设置 > 通用 > 退出应用时关闭窗口”，以启用窗口恢复。"
          }
        }
      }
    },
    "ui.settings.generalpreferencesviewcontroller.system_window_restoration_has_been_disabled_which_prevents.f118cbd6": {
