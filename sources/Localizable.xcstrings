    "ui.advanced.setting.CopyBackgroundColor.description": {
      "comment": "Advanced settings display only. Keep identifiers, commands, values and protocol tokens unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Exclude the default background color when text is copied with color and font style?\nWhen off, the default background color will be left unset. Non-default background colors will remain."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "带颜色和字体样式复制文本时，排除默认背景色？\n关闭时默认背景色将不设置，非默认背景色仍保留。"
          }
        }
      }
    },
    "ui.advanced.setting.PasteHistoryMaxOptions.description": {
