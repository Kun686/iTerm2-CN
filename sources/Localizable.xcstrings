    "ui.browser.page.onboarding.intro.page_title": {
      "comment": "User-facing text on an iTerm2 Browser onboarding page.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Welcome to iTerm2 Browser"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "欢迎使用 iTerm2 浏览器"
          }
        }
      }
    },
    "ui.browser.page.onboarding.intro.profile.description": {
      "comment": "User-facing text on an iTerm2 Browser onboarding page.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In iTerm2, profiles define how sessions look and behave. Terminal profiles open a shell. Browser profiles are different: they open a web browser instead."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 iTerm2 中，配置文件决定会话的外观和行为。终端配置文件会打开 Shell，而浏览器配置文件则会打开网页浏览器。"
          }
        }
      }
    },
    "ui.browser.page.onboarding.intro.profile.title": {
      "comment": "User-facing text on an iTerm2 Browser onboarding page.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What is a Browser Profile?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "什么是浏览器配置文件？"
          }
        }
      }
    },
    "ui.browser.page.onboarding.intro.subtitle": {
      "comment": "User-facing text on an iTerm2 Browser onboarding page.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminal + Browser = Trowser"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "终端 + 浏览器 = Trowser"
          }
        }
      }
    },
