    "ui.swift.aiterm.chatviewcontroller.disable_orchestration.d7c121e1": {
      "comment": "User-facing text in ChatViewController.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disable Orchestration"
          }
        },
        "zh-Hans": {
          "stringUnit": {
