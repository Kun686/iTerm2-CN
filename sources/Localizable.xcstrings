    "ui.swift.claudecode.claudecodeonboarding.show_the_toolbelt_and_enable_the_session_status.1b627dcf": {
      "comment": "User-facing text in ClaudeCodeOnboarding.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show the toolbelt and enable the Session Status tool. The toolbelt appears on the right side of your terminal window.\n\nYou can toggle the toolbelt from View > Toolbelt > Show Toolbelt, or with the shortcut ⌘⇧B."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示工具侧栏并启用“会话状态”工具。工具侧栏显示在终端窗口右侧。\n\n您可以通过“显示”>“工具侧栏”>“显示工具侧栏”或快捷键 ⌘⇧B 切换工具侧栏。"
          }
        }
      }
    },
