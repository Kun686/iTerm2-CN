    "ui.shell_integration.steps.waiting": {"comment":"Display-only installer step fragment; keep format arguments and shell names unchanged.","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"⏳ Waiting for command to complete…"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"⏳ 等待命令完成…"}}}},
