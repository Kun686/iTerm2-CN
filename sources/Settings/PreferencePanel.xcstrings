    "7EK-nW-yMU.ibShadowedToolTip": {
      "comment": "Class = \"NSButton\"; ibShadowedToolTip = \"When the appearance of the tab bar causes a window to grow, part of it may move outside the main area of the screen (for example, under the Dock). When this setting is enabled, the window’s size will remain the same if growing it to accommodate a tab bar would cause that to occur.\"; ObjectID = \"7EK-nW-yMU\";",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "When the appearance of the tab bar causes a window to grow, part of it may move outside the main area of the screen (for example, under the Dock). When this setting is enabled, the window’s size will remain the same if growing it to accommodate a tab bar would cause that to occur."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标签栏出现并使窗口增大时，窗口的一部分可能移出屏幕主要区域（例如位于程序坞下方）。启用此设置后，如果为容纳标签栏而增大会导致这种情况，窗口将保持原有大小。"
          }
        }
      }
    },
