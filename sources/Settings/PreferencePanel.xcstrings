    "5753.ibShadowedToolTip": {
      "comment": "Class = \"NSButton\"; ibShadowedToolTip = \"If this is on then transparency can be toggled window-by-window under View>Use Transparency. Note that this doesn't apply to native fullscreen windows (those that are managed by macOS and go in their own Desktop) because there is nothing to see behind them. Use `Settings > General > Window > Native full screen windows` to control which type of full screen windows you use. Hotkey windows, when full screen, can only be non-native fullscreen windows.\"; ObjectID = \"5753\";",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "If this is on then transparency can be toggled window-by-window under View>Use Transparency. Note that this doesn't apply to native fullscreen windows (those that are managed by macOS and go in their own Desktop) because there is nothing to see behind them. Use `Settings > General > Window > Native full screen windows` to control which type of full screen windows you use. Hotkey windows, when full screen, can only be non-native fullscreen windows."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果启用此选项，则可以在视图 > 使用透明度下按窗口切换透明度。注意，这不适用于原生全屏窗口（由 macOS 管理并进入独立桌面的窗口），因为它们背后没有可见的内容。使用「设置 > 通用 > 窗口 > 原生全屏窗口」来控制你使用哪种全屏窗口。热键窗口在全屏时只能是非原生全屏窗口。"
          }
        }
      }
    },
