    "LsQ-19-iaj.ibShadowedToolTip": {
      "comment": "Class = \"NSImageView\"; ibShadowedToolTip = \"The prompt must contain the substring \\\\(ai.prompt). The query you enter will replace it when speaking to the AI. For example: “Write a unix command to \\\\(ai.prompt).\"; ObjectID = \"LsQ-19-iaj\";",
