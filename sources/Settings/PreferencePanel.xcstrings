    "5144.ibShadowedToolTip": {
      "comment": "Class = \"NSButton\"; ibShadowedToolTip = \"Draws a border around the window when the OS otherwise would not. This is effective in light mode or when the window contains a transparent pane.\"; ObjectID = \"5144\";",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Draws a border around the window when the OS otherwise would not. This is effective in light mode or when the window contains a transparent pane."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在系统不会自动绘制边框时在窗口周围绘制边框。这在浅色模式或窗口包含透明面板时有效。"
          }
        }
      }
    },
