    "2Pt-rH-WYj.ibShadowedToolTip": {
      "comment": "Class = \"NSButton\"; ibShadowedToolTip = \"When this is enabled, you can click on a command or its output to restrict Find and Filter to its output. The selected command gets highlighted and other commands get dimmed. This requires shell integration to be installed.\"; ObjectID = \"2Pt-rH-WYj\";",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "When this is enabled, you can click on a command or its output to restrict Find and Filter to its output. The selected command gets highlighted and other commands get dimmed. This requires shell integration to be installed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用后，你可以点击命令或其输出以将查找和过滤限制在该命令的输出范围内。选中的命令会被高亮显示，其他命令会被调暗。此功能需要安装 Shell Integration。"
          }
        }
      }
    },
