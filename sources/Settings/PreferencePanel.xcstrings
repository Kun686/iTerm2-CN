    "HqN-xF-ITg.ibShadowedToolTip": {
      "comment": "Class = \"NSButton\"; ibShadowedToolTip = \"Alternate Mouse Scroll is a feature that sends arrow keys in response to scroll wheel/scroll gestures. Enable this if you prefer not to use it for horizontal scrolling. Alternate mouse scroll takes priority over swipe to switch tabs.\"; ObjectID = \"HqN-xF-ITg\";",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Alternate Mouse Scroll is a feature that sends arrow keys in response to scroll wheel/scroll gestures. Enable this if you prefer not to use it for horizontal scrolling. Alternate mouse scroll takes priority over swipe to switch tabs."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "备用鼠标滚动是一种在响应滚轮/滚动手势时发送方向键的功能。如果你不想将其用于水平滚动，请启用此选项。备用鼠标滚动的优先级高于滑动切换标签页。"
          }
        }
      }
    },
