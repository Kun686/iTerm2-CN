    "QeQ-es-j2p.ibShadowedToolTip": {
      "comment": "Class = \"NSButton\"; ibShadowedToolTip = \"When enabled, the locations of terminal windows are recorded when windows are closed. Later, when creating a new window, the window is placed in the same location (using the top left coordinate). The size is not saved; whatever rows and columns are specified in the window's originating profile are used to compute the size.\"; ObjectID = \"QeQ-es-j2p\";",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "When enabled, the locations of terminal windows are recorded when windows are closed. Later, when creating a new window, the window is placed in the same location (using the top left coordinate). The size is not saved; whatever rows and columns are specified in the window's originating profile are used to compute the size."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用后，终端窗口关闭时会记录其位置。之后创建新窗口时，窗口会放置在相同的位置（使用左上角坐标）。大小不会保存；使用窗口来源配置文件中指定的行数和列数来计算大小。"
          }
        }
      }
    },
