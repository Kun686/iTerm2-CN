    "jlZ-SF-XtE.ibShadowedToolTip": {
      "comment": "Class = \"NSButton\"; ibShadowedToolTip = \"Apps (such as your shell or your editor) expect each character to have a particular “width,” between 0 and 2 cells. If the app and the terminal emulator have different width tables, rendering problems ensue. Notably, Unicode 8 defines most Emoji to be 1 cell wide. Most fonts render them as two cells wide. Unicode 9 fixes this. If your apps have been updated for Unicode 9, you should enable this.\"; ObjectID = \"jlZ-SF-XtE\";",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Apps (such as your shell or your editor) expect each character to have a particular “width,” between 0 and 2 cells. If the app and the terminal emulator have different width tables, rendering problems ensue. Notably, Unicode 8 defines most Emoji to be 1 cell wide. Most fonts render them as two cells wide. Unicode 9 fixes this. If your apps have been updated for Unicode 9, you should enable this."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用程序（如你的 Shell 或编辑器）期望每个字符具有特定的「宽度」，介于 0 到 2 个单元格之间。如果应用和终端模拟器的宽度表不同，就会出现渲染问题。值得注意的是，Unicode 8 将大多数 Emoji 定义为 1 个单元格宽。大多数字体将它们渲染为两个单元格宽。Unicode 9 修复了这个问题。如果你的应用已经针对 Unicode 9 进行了更新，你应该启用此选项。"
          }
        }
      }
    },
