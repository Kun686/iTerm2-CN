    "awA-hH-ziY.ibShadowedToolTip": {
      "comment": "Class = \"NSButton\"; ibShadowedToolTip = \"For this setting to take effect you must disable \\\"Native full screen windows\\\" in Settings > General. If this setting is enabled, the menu bar will remain visible. This is useful for multi-monitor systems.\"; ObjectID = \"awA-hH-ziY\";",
