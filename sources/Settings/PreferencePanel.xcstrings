    "imM-Ma-mjV.ibShadowedToolTip": {
      "comment": "Class = \"NSButton\"; ibShadowedToolTip = \"When locked, the terminal cannot change the title with a control sequence. This prevents changes you make in Session Name from being overridden.\"; ObjectID = \"imM-Ma-mjV\";",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "When locked, the terminal cannot change the title with a control sequence. This prevents changes you make in Session Name from being overridden."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "锁定后，终端无法通过控制序列更改标题。这可以防止你在会话名称中所做的更改被覆盖。"
          }
        }
      }
    },
