    "5319.ibShadowedToolTip": {
      "comment": "Class = \"NSButton\"; ibShadowedToolTip = \"Native full screen windows animate into their own desktop. Non-native full screen windows quickly expand to fill the window's screen.\"; ObjectID = \"5319\";",
