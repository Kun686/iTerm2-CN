    "5dO-zM-mKW.title": {
      "comment": "Class = \"NSTextFieldCell\"; title = \"This script must be upgraded to a “full environment“ to add dependencies. Doing so makes a copy of the Python runtime but will not use any additional disk space.\"; ObjectID = \"5dO-zM-mKW\";",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "This script must be upgraded to a “full environment“ to add dependencies. Doing so makes a copy of the Python runtime but will not use any additional disk space."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此脚本必须升级为“完整环境”才能添加依赖项。此操作会拷贝一份 Python 运行时，但不会占用额外的磁盘空间。"
          }
        }
      }
    },
