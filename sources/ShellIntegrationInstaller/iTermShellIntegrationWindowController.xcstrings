    "w9k-Lv-5eU.title": {
      "comment": "Class = \"NSTextFieldCell\"; title = \"This will run the following command:\\n\\ncurl -L https://iterm2.com/shell_integration/install_shell_integration_and_utilities.sh | bash\"; ObjectID = \"w9k-Lv-5eU\";",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "This will run the following command:\\n\\ncurl -L https://iterm2.com/shell_integration/install_shell_integration_and_utilities.sh | bash"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将运行以下命令：\\n\\ncurl -L https://iterm2.com/shell_integration/install_shell_integration_and_utilities.sh | bash"
          }
        }
      }
    },
    "wl0-hO-Vi5.title": {
      "comment": "Class = \"NSTextFieldCell\"; title = \"Shell Integration consists of scripts that help your shell communicate with iTerm2 so it can track the commands you’re running, your current directory, and other state. \"; ObjectID = \"wl0-hO-Vi5\";",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Shell Integration consists of scripts that help your shell communicate with iTerm2 so it can track the commands you’re running, your current directory, and other state. "
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Shell Integration 由一组脚本组成，帮助您的 Shell 与 iTerm2 通信，以便追踪您正在运行的命令、当前目录和其他状态。"
          }
        }
      }
    },
