    "UYA-J9-ck1.title": {
      "comment": "Class = \"NSTextFieldCell\"; title = \"How would you like to install Shell Integration?\\n\\nIn this process, your shell’s startup scripts will be modified. This installer will enter commands in the terminal window for you.\"; ObjectID = \"UYA-J9-ck1\";",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "How would you like to install Shell Integration?\\n\\nIn this process, your shell’s startup scripts will be modified. This installer will enter commands in the terminal window for you."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你想如何安装 Shell 集成？\\n\\n此过程将修改 Shell 的启动脚本。安装器会在终端窗口中为你输入命令。"
          }
        }
      }
    },
    "WeK-Fh-3OJ.title": {
      "comment": "Class = \"NSTextFieldCell\"; title = \"Create a new tab to try it out.\\n\\nFor best results, install shell integration on all hosts you ssh in to.\"; ObjectID = \"WeK-Fh-3OJ\";",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Create a new tab to try it out.\\n\\nFor best results, install shell integration on all hosts you ssh in to."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新建标签页进行试用。\\n\\n为获得最佳效果，请在所有通过 SSH 登录的主机上安装 Shell 集成。"
          }
        }
      }
    },
